    <form id="Filtre_IMPAYE">
    	<script><![CDATA[ formCourant = "Filtre_IMPAYE"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <!--	Client eligible au traitement IMPAYE  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.IMPAYE != 'false' &amp;&amp; isClientMobileImpayeSAP_RMCA() "); ]]></script>	
            <if cond="CUSTOMER_IHM.IMPAYE != 'false' &amp;&amp; isClientMobileImpayeSAP_RMCA() ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.IMPAYE != 'false' &amp;&amp; isClientMobileImpayeSAP_RMCA() "); ]]></script>	

                <script><![CDATA[
					customNode(applicationName + '_' + '00080_M_IMPAYE');
					POSITION_ARBO = 57;	
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);						
                ]]></script>
  	            <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
	            <goto next="./ABO_FLASH_INC.vxml"/>                       

                <!--	Client non eligible  au traitement IMPAYE  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "AFTER_Filtre_IMPAYE"); ]]></script>
                <goto next="#AFTER_Filtre_IMPAYE"/>

            </if>

        </block>
    </form>     
    
 	<!--	suite traitement impaye et acces à partir de la page ABO_IMPAYE  -->    
    <form id="AFTER_Filtre_IMPAYE">
    	<script><![CDATA[ formCourant = "AFTER_Filtre_IMPAYE"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>        
            <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_RDGU"); ]]></script>
            <goto next="#Filtre_RDGU"/>            
            
        </block>
    </form> 
    
    
    <!--#####################################################################################################
        filtre RDGU
        ##################################################################################################### -->
   
    <!--CTRL PROVENANCE RDGU-->
    <form id="Filtre_RDGU">
    	<script><![CDATA[ formCourant = "Filtre_RDGU"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <!--	Client RDGU  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.RDGU != 'false' &amp;&amp; appel_rdgu == 'true' "); ]]></script>	
            <if cond="CUSTOMER_IHM.RDGU != 'false' &amp;&amp; appel_rdgu == 'true'">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.RDGU != 'false' &amp;&amp; appel_rdgu == 'true'"); ]]></script>	

                <script><![CDATA[
					customNode(applicationName + '_' + '00050_M_RDGU');
					POSITION_ARBO = 50;	
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);						
                ]]></script>
  	            <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
	            <goto next="./ABO_FLASH_INC.vxml"/>                       

                <!--	Client non rdgu  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_PREMIUM"); ]]></script>
                <goto next="#Filtre_PREMIUM"/>

            </if>

        </block>
    </form>
        
    <!--#####################################################################################################
        PREMIUM
        ##################################################################################################### -->
    <form id="Filtre_PREMIUM">
    	<script><![CDATA[ formCourant = "Filtre_PREMIUM"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        
            <block>
            <!--	 Premium via les données SEARCH ou Marqueur C2OL ou AEM  --> 
            
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.PREMIUM != 'false'  &amp;&amp; is_premium_mobile() "); ]]></script>	
            <if cond="CUSTOMER_IHM.PREMIUM != 'false'  &amp;&amp; is_premium_mobile()  ">				
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.PREMIUM != 'false'  &amp;&amp; is_premium_mobile() "); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '00060_M_PREMIUM');
					POSITION_ARBO = 58;	
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);					
                ]]></script>
  	            <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
	            <goto next="./ABO_FLASH_INC.vxml"/> 	                            

            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>                
	            <script><![CDATA[
					customNode(applicationName + '_' + '00012_MENU_PRINCIPAL');
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_MENU_PRINCIPAL.vxml"); ]]></script>
	            <goto next="./ABO_MENU_PRINCIPAL.vxml"/>                

            </if>
            </block>
    </form>          

</vxml>
