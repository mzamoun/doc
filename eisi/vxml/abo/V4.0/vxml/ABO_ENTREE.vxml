    <script><![CDATA[
		applicationName = "ABO"; appSvi = applicationName;
		var pageCourante = "ABO_ENTREE.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
    ]]></script>

    <var name="context" expr="''"/>


	<script><![CDATA[
	    function isDEBUT_PRE_FID_M(chaine,sous_chaine) {
		    return  (chaine.indexOf(sous_chaine)==0);
		}	
				
	]]></script>   
   	    

    <form id="VersFlashJour">
    	<script><![CDATA[ formCourant = "VersFlashJour"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				POSITION_ARBO = 0;
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
            <goto next="./ABO_FLASH_INC.vxml"/>
        </block>
    </form>
    
    
    <!--############################################################
               PRE TRAITEMENT BEB_MOB - appel au WS BEB_MOB (FASTR)
        ############################################################ -->

    <form id="Vers_PRE_TRAITEMENT_BEB_MOB">
        <script><![CDATA[ formCourant = "Vers_PRE_TRAITEMENT_BEB_MOB"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
          
            <!--CTRL avant appel au WS  WS_BEB_MOB - au moins un des 4 filtres doit etre activé et ID_CSU non vide-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "(CUSTOMER_IHM.BEB_MOB_RET != 'false' || CUSTOMER_IHM.BEB_MOB_COM != 'false'  || CUSTOMER_IHM.BEB_MOB_TECH != 'false') &amp;&amp; IDCSU != '' &amp;&amp; IDCSU != 'null'  "); ]]></script>
            <if cond="(CUSTOMER_IHM.BEB_MOB_RET != 'false' || CUSTOMER_IHM.BEB_MOB_COM != 'false'  || CUSTOMER_IHM.BEB_MOB_TECH != 'false') &amp;&amp; IDCSU != '' &amp;&amp; IDCSU != 'null' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "(CUSTOMER_IHM.BEB_MOB_RET != 'false' || CUSTOMER_IHM.BEB_MOB_COM != 'false'  || CUSTOMER_IHM.BEB_MOB_TECH != 'false') &amp;&amp; IDCSU != '' &amp;&amp; IDCSU != 'null'  "); ]]></script>
                
            	<script><![CDATA[ log_debug_next_form(pageCourante, "WS_ELIGIBILITE_BEB_MOB"); ]]></script>
            	<goto next="#WS_ELIGIBILITE_BEB_MOB"/>                
              
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_RESILIE"); ]]></script>
	            <goto next="#Filtre_RESILIE"/>                  
                
             </if>                 
            

        </block>
    </form>  

    <form id="WS_ELIGIBILITE_BEB_MOB">
        <script><![CDATA[ formCourant = "WS_ELIGIBILITE_BEB_MOB"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[
			var id_csu = IDCSU; 
			var ndi = getNdiBebMob() ;     
        ]]></script>
        <script><![CDATA[ log_debug_appel_web_app(pageCourante, 'WS_ELIGIBILITE_BEB', subdialogWS_ELIGIBILITE_BEB_MOB , 'id_csu=' + id_csu +'|ndi=' + ndi  ); ]]></script>
        <subdialog name="WS_ELIGIBILITE_BEB_MOB"
                   srcexpr="subdialogWS_ELIGIBILITE_BEB_MOB"
                   namelist="id_csu ndi"
                   method="get"
                   fetchtimeout="10s"
                   fetchaudio="../../../audio/Attente.wav"/>
                   
        <catch event="error">
            <script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '80000_WS_ELIGIBILITE_BEB_MOB');
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_RESILIE"); ]]></script>
            <goto next="#Filtre_RESILIE"/>
        </catch>

        <block>
            <script><![CDATA[ log_debug_result_web_app(pageCourante, 'WS_ELIGIBILITE_BEB_MOB', WS_ELIGIBILITE_BEB_MOB ); ]]></script>
            
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " WS_ELIGIBILITE_BEB_MOB.APP_STATUS == 'NOK' || WS_ELIGIBILITE_BEB_MOB.WS_STATUS == 'NOK' "); ]]></script>
            <if cond=" WS_ELIGIBILITE_BEB_MOB.APP_STATUS == 'NOK' || WS_ELIGIBILITE_BEB_MOB.WS_STATUS == 'NOK' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " WS_ELIGIBILITE_BEB_MOB.APP_STATUS == 'NOK' || WS_ELIGIBILITE_BEB_MOB.WS_STATUS == 'NOK'  "); ]]></script>
	            <script><![CDATA[
					CUSTOMER_BEB_MOB = {};
	            ]]></script>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
				<script><![CDATA[ log_debug_assignment(pageCourante,"CUSTOMER_BEB_MOB", WS_ELIGIBILITE_BEB_MOB); ]]></script>
                <assign name="CUSTOMER_BEB_MOB" expr="WS_ELIGIBILITE_BEB_MOB"/>
                
             </if>  
             
            <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_RESILIE"); ]]></script>
            <goto next="#Filtre_RESILIE"/>
                                          
        </block>
    </form>
    

    <!--#####################################################################################################
        RESILIE
        ##################################################################################################### -->
    <form id="Filtre_RESILIE">
    	<script><![CDATA[ formCourant = "Filtre_RESILIE"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!--	 RESILIE ACTIVE et AEM- SATUT 20,21 ou 30	-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.RESILIE != 'false'  &amp;&amp; isClientMobileResilie() "); ]]></script>	
            <if cond="CUSTOMER_IHM.RESILIE != 'false'  &amp;&amp; isClientMobileResilie() ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.RESILIE != 'false'  &amp;&amp; isClientMobileResilie() "); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '00002_RESILIE');
					POSITION_ARBO = 91;
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
                ]]></script>
  	            <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
	            <goto next="./ABO_FLASH_INC.vxml"/>                

            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_BOX4G5G"); ]]></script>
                <goto next="#Filtre_BOX4G5G"/>

            </if>
        </block>
    </form>
        
    <!--#####################################################################################################
        BOX4G
        ##################################################################################################### -->
    <form id="Filtre_BOX4G5G">
    	<script><![CDATA[ formCourant = "Filtre_BOX4G5G"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!--	 AEM -BOX4G ou BOX5G		-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.BOX4G_5G != 'false'  &amp;&amp; (isClientMobileBox4G() || isClientMobileBox5G()) "); ]]></script>	
            <if cond="CUSTOMER_IHM.BOX4G_5G != 'false'  &amp;&amp; (isClientMobileBox4G() || isClientMobileBox5G()) ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.BOX4G_5G != 'false'  &amp;&amp; (isClientMobileBox4G() || isClientMobileBox5G()) "); ]]></script>	
	            
            	<!--BOX5G		-->
	            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientMobileBox5G()"); ]]></script>	
	            <if cond="isClientMobileBox5G()">
	            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientMobileBox5G()"); ]]></script>		
	            	<script><![CDATA[
						TYPE_BOX_XG = 'BOX5G';
						log_debug_assignment(pageCourante, "TYPE_BOX_XG", TYPE_BOX_XG);
	                ]]></script>
	            <else/>
	            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
	            	<script><![CDATA[
						TYPE_BOX_XG = 'BOX4G';
						log_debug_assignment(pageCourante, "TYPE_BOX_XG", TYPE_BOX_XG);
	                ]]></script>
	            </if>

            	<script><![CDATA[
					customNode(applicationName + '_' + '00010_'+ TYPE_BOX_XG +'_'+CUSTOMER_AEM.codePTA);
					POSITION_ARBO = 53;
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
                ]]></script>
  	            <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
	            <goto next="./ABO_FLASH_INC.vxml"/>                

            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_MAISON_SECURISEE"); ]]></script>
                <goto next="#Filtre_MAISON_SECURISEE"/>

            </if>
        </block>
    </form>
    
    <!--#####################################################################################################
        CTRL FILTRE Maison SECURISEE
        ##################################################################################################### -->
    <form id="Filtre_MAISON_SECURISEE">
    	<script><![CDATA[ formCourant = "Filtre_MAISON_SECURISEE"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!--	 AEM -flagHome=O		-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.MAISON_SECURISEE != 'false'  &amp;&amp; isClientMobileMaison_Securise() "); ]]></script>	
            <if cond="CUSTOMER_IHM.MAISON_SECURISEE != 'false'  &amp;&amp; isClientMobileMaison_Securise() ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.MAISON_SECURISEE != 'false'  &amp;&amp; isClientMobileMaison_Securise() "); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '00010_MAISON_SECURISEE');
					POSITION_ARBO = 132;
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
                ]]></script>
  	            <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
	            <goto next="./ABO_FLASH_INC.vxml"/>                

            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "VersCtrlCell_Prem"); ]]></script>
                <goto next="#VersCtrlCell_Prem"/>

            </if>
        </block>
    </form>
        
