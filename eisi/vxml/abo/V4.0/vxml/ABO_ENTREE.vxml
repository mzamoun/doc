    <!--#####################################################################################################
        CTRL CELL_PREM
        ##################################################################################################### -->

    <form id="VersCtrlCell_Prem">
    	<script><![CDATA[ formCourant = "VersCtrlCell_Prem"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " CUSTOMER_IHM.MARQUEUR_C2OL != 'false' &amp;&amp; IDCSU != '' &amp;&amp; IDCSU != 'null' "); ]]></script>	
            <if cond=" CUSTOMER_IHM.MARQUEUR_C2OL != 'false' &amp;&amp; IDCSU != '' &amp;&amp; IDCSU != 'null' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " CUSTOMER_IHM.MARQUEUR_C2OL != 'false' &amp;&amp; IDCSU != '' &amp;&amp; IDCSU != 'null' "); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "CtrlCell_Prem"); ]]></script>
                <goto next="#CtrlCell_Prem"/>

            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
            	<script><![CDATA[ log_debug_assignment(pageCourante,'MOBILE_CELL_PREM_FIDE', MOBILE_CELL_PREM_FIDE); 	]]></script>
                <script><![CDATA[
						MOBILE_CELL_PREM_FIDE = 'false';
                ]]></script>
               
                <script><![CDATA[ log_debug_next_form(pageCourante, "CtrlPACKPRO_AEM"); ]]></script>
                <goto next="#CtrlPACKPRO_AEM"/>
            </if>
        </block>
    </form>

    <!--CTRL MARQUEUR CELL_PREM -->
    <form id="CtrlCell_Prem">
    	<script><![CDATA[ formCourant = "CtrlCell_Prem"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[
			var id_csu = IDCSU;
			var searchMarker = 'CELL_PREM';     
        ]]></script>
        <script><![CDATA[ log_debug_appel_web_app(pageCourante, 'BDDClientFIND_CLIENT', subdialogWS_FIND_CLIENT , 'id_csu=' + id_csu +'|searchMarker=' + searchMarker ); ]]></script>
        <subdialog name="BDDClientFIND_CLIENT"
                   srcexpr="subdialogWS_FIND_CLIENT"
                   namelist="id_csu searchMarker"
                   method="get"
                   fetchtimeout="5s"
                   fetchaudio="../../../audio/Attente.wav"/>

        <catch event="error">
        	<script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '80001_C2OL_FIND_CLIENT_HS');
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "CtrlPACKPRO_AEM"); ]]></script>
            <goto next="#CtrlPACKPRO_AEM"/>
        </catch>

        <block>
            <script><![CDATA[ log_debug_result_web_app(pageCourante, 'BDDClientFIND_CLIENT', BDDClientFIND_CLIENT ); ]]></script>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " BDDClientFIND_CLIENT.APP_STATUS == 'NOK' || BDDClientFIND_CLIENT.WS_FIND_CLIENT_STATUS == 'NOK' "); ]]></script>	
            <if cond=" BDDClientFIND_CLIENT.APP_STATUS == 'NOK' || BDDClientFIND_CLIENT.WS_FIND_CLIENT_STATUS == 'NOK' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " BDDClientFIND_CLIENT.APP_STATUS == 'NOK' || BDDClientFIND_CLIENT.WS_FIND_CLIENT_STATUS == 'NOK' "); ]]></script>	
           	 	<script><![CDATA[ log_appel_web_app_nok(pageCourante, 'BDDClientFIND_CLIENT', subdialogWS_FIND_CLIENT , 'id_csu=' + id_csu +'|searchMarker=' + searchMarker ); ]]></script>
            	<script><![CDATA[ log_debug_next_form(pageCourante, "CtrlPACKPRO_AEM"); ]]></script>
          		<goto next="#CtrlPACKPRO_AEM"/>

            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <assign name="CUSTOMER_FIND_CLIENT_MARKER" expr="BDDClientFIND_CLIENT"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"CUSTOMER_FIND_CLIENT_MARKER", CUSTOMER_FIND_CLIENT_MARKER); ]]></script>

            </if>

            <!--	traitement du marqueur CELL_PREM - A FIDELISER  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_FIND_CLIENT_MARKER.MARKER_FOUND == 'true' &amp;&amp; (isDEBUT_PRE_FID_M (CUSTOMER_FIND_CLIENT_MARKER.VALUE1,'PRE_FID_M' )  || CUSTOMER_FIND_CLIENT_MARKER.VALUE1 == 'PLATINE_00')"); ]]></script>	
            <if cond="CUSTOMER_FIND_CLIENT_MARKER.MARKER_FOUND == 'true' &amp;&amp; ( isDEBUT_PRE_FID_M (CUSTOMER_FIND_CLIENT_MARKER.VALUE1,'PRE_FID_M' )  || CUSTOMER_FIND_CLIENT_MARKER.VALUE1 == 'PLATINE_00') ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_FIND_CLIENT_MARKER.MARKER_FOUND == 'true' &amp;&amp; (isDEBUT_PRE_FID_M (CUSTOMER_FIND_CLIENT_MARKER.VALUE1,'PRE_FID_M' )  || CUSTOMER_FIND_CLIENT_MARKER.VALUE1 == 'PLATINE_00')  "); ]]></script>	
                <script><![CDATA[
					MOBILE_CELL_PREM_FIDE = 'true';				
                ]]></script>
                <!--	traitement du marqueur CELL_PREM - PLATINE  -->
	            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_FIND_CLIENT_MARKER.VALUE1 == 'PLATINE_00'"); ]]></script>	
	            <if cond="CUSTOMER_FIND_CLIENT_MARKER.VALUE1 == 'PLATINE_00' ">
	            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_FIND_CLIENT_MARKER.VALUE1 == 'PLATINE_00'  "); ]]></script>	
	                <script><![CDATA[
						MOBILE_CELL_PREM_PLATINE = 'true';				
	                ]]></script>
	            </if>
	                             
                <script><![CDATA[ log_debug_next_form(pageCourante, "CtrlPACKPRO_AEM"); ]]></script>
                <goto next="#CtrlPACKPRO_AEM"/>

          	 <!--	traitement du marqueur CELL_PREM - PACKPRO  -->
            <elseif cond="CUSTOMER_FIND_CLIENT_MARKER.MARKER_FOUND == 'true' &amp;&amp; CUSTOMER_FIND_CLIENT_MARKER.VALUE1 == 'PACKPRO_M' "/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_FIND_CLIENT_MARKER.MARKER_FOUND == 'true' &amp;&amp; CUSTOMER_FIND_CLIENT_MARKER.VALUE1 == 'PACKPRO_M' "); ]]></script>	
                <script><![CDATA[
					MOBILE_PACKPRO = 'true';					
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "CtrlPACKPRO_AEM"); ]]></script>
                <goto next="#CtrlPACKPRO_AEM"/>            	

            	                
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[
					MOBILE_CELL_PREM_FIDE = 'false';
					MOBILE_PACKPRO = 'false';					
                ]]></script>            	
                <script><![CDATA[ log_debug_next_form(pageCourante, "CtrlPACKPRO_AEM"); ]]></script>
                <goto next="#CtrlPACKPRO_AEM"/>

            </if>
           
        </block>
    </form>  
    
    
    <form id="CtrlPACKPRO_AEM">
    	<script><![CDATA[ formCourant = "CtrlPACKPRO_AEM"; ]]></script>
