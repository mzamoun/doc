<?xml version="1.0" encoding="ISO-8859-1"?>
<vxml version="2.1" xmlns="http://www.w3.org/2001/vxml" application="../../../root.vxml" xml:lang="fr-FR">

    <!--
        Auteur :			IMA/CZO
        Date de Creation :	16/06/2020
        Page :				Application ABO - RESILIE
        Modification		IMA/CZO	14/06/2021		MAJ filtres RESILIE et SUSPENDU avec les donnees AEM
        					IMA/CZO 22/01/2024		Integration de l'identification SEARCH							
    -->
    <script><![CDATA[
		applicationName = "ABO"; appSvi = applicationName;
		var pageCourante = "ABO_RESILIE.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
    ]]></script>

    <var name="errorCounter" expr="0"/>

    
    <form id="CTRL_FILTRE_RESILIE">
        <script><![CDATA[ formCourant = "CTRL_FILTRE_RESILIE"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!-- STATUT 20-->            
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientMobileResilie20()"); ]]></script>
            <if cond="isClientMobileResilie20() ">
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientMobileResilie20() "); ]]></script>		               
	                <script><![CDATA[
			            customNode(applicationName + '_' + '00012_RESILIE_STATUT20');
						POSITION_ARBO = 92;
						log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				            
	                ]]></script>
		            <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
		            <goto next="./ABO_FLASH_INC.vxml"/>		            	                               
	                
         	<!-- STATUT 21--> 
            <elseif cond="isClientMobileResilie21() "/>
            		<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientMobileResilie21() "); ]]></script>
	                <script><![CDATA[
			            customNode(applicationName + '_' + '00022_RESILIE_STATUT21');
						POSITION_ARBO = 88;
						log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				            
	                ]]></script>
		            <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
		            <goto next="./ABO_FLASH_INC.vxml"/>         			                
               	
			<!-- STATUT 30 - cas defaut--> 
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
		            customNode(applicationName + '_' + '00032_RESILIE_STATUT30');
					POSITION_ARBO = 72;
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				            
                ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
	            <goto next="./ABO_FLASH_INC.vxml"/> 
	
            </if>

        </block>
    </form> 
    
    <!--#####################################################################################################
        RESILIE STATUT20
        ##################################################################################################### -->
    <form id="RESILIE_STATUT20">
    	<script><![CDATA[ formCourant = "RESILIE_STATUT20"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.STATUT20 != 'false'  &amp;&amp; isClientMobileResilie20() "); ]]></script>	
            <if cond="CUSTOMER_IHM.STATUT20 != 'false'  &amp;&amp; isClientMobileResilie20()">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.STATUT20 != 'false'  &amp;&amp; isClientMobileResilie20()"); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '00012_STATUT20_MENU');
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "MENU_RESILIE"); ]]></script>
                <goto next="#MENU_RESILIE"/>               

            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00012_DISSUASION_STATUT20');
                ]]></script>            		
		        <prompt bargein="true">
		            <audio maxage="7200" maxstale="7200" expr="PlayFileCommun(CUSTOMER_IHM.ABO_STATUT_20_STATUT_20_AUDIO)"/>
		        </prompt>            
	            <script><![CDATA[ log_debug_next_page(pageCourante, pageDisconnect); ]]></script>
	            <goto expr="pageDisconnect"/>

            </if>
        </block>
    </form>
    
    <!--#####################################################################################################
        RESILIE STATUT21
        ##################################################################################################### -->
    <form id="RESILIE_STATUT21">
    	<script><![CDATA[ formCourant = "RESILIE_STATUT21"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.STATUT21 != 'false'  &amp;&amp; isClientMobileResilie21() "); ]]></script>	
            <if cond="CUSTOMER_IHM.STATUT20 != 'false'  &amp;&amp; isClientMobileResilie21()">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.STATUT21 != 'false'  &amp;&amp; isClientMobileResilie21()"); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '00022_STATUT21_MENU');
                ]]></script>
