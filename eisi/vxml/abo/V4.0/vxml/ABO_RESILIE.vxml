                <goto next="#MENU_RESILIE"/>               

            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00022_DISSUASION_STATUT21');
                ]]></script>            		
		        <prompt bargein="true">
		            <audio maxage="7200" maxstale="7200" expr="PlayFileCommun(CUSTOMER_IHM.ABO_STATUT_21_STATUT_21_AUDIO)"/>
		        </prompt>            
	            <script><![CDATA[ log_debug_next_page(pageCourante, pageDisconnect); ]]></script>
	            <goto expr="pageDisconnect"/>

            </if>
        </block>
    </form>
    
    <!--#####################################################################################################
        RESILIE STATUT30
