                <script><![CDATA[
					customNode(applicationName + '_' + '00032_DISSUASION_STATUT30');
                ]]></script>            		
		        <prompt bargein="true">
		            <audio maxage="7200" maxstale="7200" expr="PlayFileCommun(CUSTOMER_IHM.ABO_STATUT_30_STATUT_30_AUDIO)"/>
		        </prompt>            
