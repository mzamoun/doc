    <form id="RESILIE_STATUT30">
    	<script><![CDATA[ formCourant = "RESILIE_STATUT30"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.STATUT30 != 'false'  &amp;&amp; isClientMobileResilie30() "); ]]></script>	
            <if cond="CUSTOMER_IHM.STATUT30 != 'false'  &amp;&amp; isClientMobileResilie30()">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.STATUT30 != 'false'  &amp;&amp; isClientMobileResilie30()"); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '00032_STATUT30_MENU');
