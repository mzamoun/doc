    <script><![CDATA[
	flashMsg = "NULL";
	if(webapp_hs!='true'){
		var items = LIST_FLASH.split(";");
		var length = items.length;
		if (POSITION_ARBO < length && items[POSITION_ARBO] !=''){
			var items_flash = items[POSITION_ARBO].split("|");
			flashMsg = MsgFolder + items_flash[0]+".wav";
			gestionFlash = items_flash[1];
			idFlash = items_flash[2];
			log_debug_assignment(pageCourante, "gestionFlash", gestionFlash);
			log_debug_assignment(pageCourante, "idFlash", idFlash);
		}
	}
