    <!--###########################################
         CTRL BEB_MOB
    ########################################### -->
  
    <form id="VersCtrlBeb_Mob">
    	<script><![CDATA[ formCourant = "VersCtrlBeb_Mob"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
