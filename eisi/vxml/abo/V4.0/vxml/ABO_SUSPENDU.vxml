    <!--
        Auteur :			IMA
        Date de Creation :	01/04/2015
        Page :				Application ABO - Client suspendu
        Modification		IMA/CZO		11/04/2017		Ajout filtre WCBDIGITAL  && FLASH 35
                            IMA/CZO 	12/10/2017     	Prise en compte des traitements CONV et RISQUE
							MRO			07/03/2018		migration v8
							IMA/CZO		15/01/2019		integration CtrlHoHno sous appli ABO_COM
							IMA/CZO		17/05/2019		integration des menus dynamiques suspendu + traitement impaye
							IMA/CZO		11/06/2019		MAJ traitement WCB + MAJ libellé flux suspendu
							IMA/CZO		03/10/2019		Ajout des positions flahs (refonte flash abo)
							IMA/CZO		12/11/2020		Menage packpro et traitement BEB_MOB_RET_COM	
							IMA/CZO		06/09/2021		Integration CTRL HOHNO dans le traitement BEB_MOB
							IMA/CZO		24/02/2022		Integration du filtre RDGU
							IMA/CZO		23/05/2023		Ajout des filtres C2OL (CONV/RISQUE)
							IMA/CZO 	22/01/2024		Integration de l'identification SEARCH
    -->
    <script><![CDATA[
		applicationName = "ABO"; appSvi = applicationName;
		var pageCourante = "ABO_SUSPENDU.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
		
		var Total_UNPAID = 0;
    ]]></script>

    <var name="errorCounter" expr="1"/>
    
    
    <!--FILTRE WCB_DIGITAL-->    
    <form id="FiltreWCBDIGITAL">
    	<script><![CDATA[ formCourant = "FiltreWCBDIGITAL"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital =='MOBILE' "); ]]></script>	
            <if cond="CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital =='MOBILE' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital =='MOBILE' "); ]]></script>	
               
                <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_IMPAYE_WCB_SUSPENDU"); ]]></script>
                <goto next="#Filtre_IMPAYE_WCB_SUSPENDU"/>

            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_RDGU"); ]]></script>
                <goto next="#Filtre_RDGU"/>
            </if>
        </block>
    </form>
    
    <!--CTRL CLIENT WCB IMPAYE-->
    <form id="Filtre_IMPAYE_WCB_SUSPENDU">
    	<script><![CDATA[ formCourant = "Filtre_IMPAYE_WCB_SUSPENDU"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>       
			<script><![CDATA[	
			    if (CUSTOMER_MOBILE_IMPAYE && CUSTOMER_MOBILE_IMPAYE.UNPAID){
					 Total_UNPAID = parseInt(CUSTOMER_MOBILE_IMPAYE.UNPAID);			    	
			    }
			]]></script>        
              
            <!--	Client eligible au traitement IMPAYE : Unpaid superieur à 0  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_MOBILE_IMPAYE &amp;&amp; CUSTOMER_MOBILE_IMPAYE.COMPTE_FOUND == 'true' &amp;&amp; CUSTOMER_MOBILE_IMPAYE.UNPAID &amp;&amp; Total_UNPAID &gt; 0 "); ]]></script>	
            <if cond="CUSTOMER_MOBILE_IMPAYE &amp;&amp; CUSTOMER_MOBILE_IMPAYE.COMPTE_FOUND == 'true' &amp;&amp; CUSTOMER_MOBILE_IMPAYE.UNPAID &amp;&amp; Total_UNPAID &gt; 0">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_MOBILE_IMPAYE &amp;&amp; CUSTOMER_MOBILE_IMPAYE.COMPTE_FOUND == 'true' &amp;&amp; CUSTOMER_MOBILE_IMPAYE.UNPAID &amp;&amp; Total_UNPAID &gt; 0  "); ]]></script>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_MOBILE_IMPAYE.UNPAID===="+CUSTOMER_MOBILE_IMPAYE.UNPAID +"===="+Total_UNPAID); ]]></script>
            	            	
                <script><![CDATA[
					customNode(applicationName + '_' + '00070_WCB_SUSPENDU');
					POSITION_ARBO = 35;	
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);					
                ]]></script>
               
                <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
                <goto next="./ABO_FLASH_INC.vxml"/>                                               

                <!--	Client non eligible  au traitement IMPAYE  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00072_WCB_SUSP_MONTANT_KO');					
                ]]></script>            		
                <script><![CDATA[ log_debug_next_form(pageCourante, "Choix_TransfertWcb"); ]]></script>
                <goto next="#Choix_TransfertWcb"/>

            </if>
        </block>
    </form>
    
   	<!--CTRL filtre RDGU -->   
    <form id="Filtre_RDGU">
    	<script><![CDATA[ formCourant = "Filtre_RDGU"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <!--	Filtre RDGU desactive -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.RDGU == 'false'"); ]]></script>	            
            <if cond="CUSTOMER_IHM.RDGU == 'false' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.RDGU == 'false'"); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00070_SUSP_RDGU_OFF');
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_IMPAYE_SUSPENDU"); ]]></script>
	            <goto next="#Filtre_IMPAYE_SUSPENDU"/>                
                  
                
           <!--	Appel en provenance de RDGU  -->
            <elseif cond="appel_rdgu == 'true'"/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "appel_rdgu == 'true' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00070_SUSP_RDGU_OK');
                ]]></script> 
                								
		        <prompt bargein="true">
		             <audio maxage="7200" maxstale="7200" expr="PlayFileCommun(CUSTOMER_IHM.ABO_SUSPENSION_RDGU_SUSPENDU_AUDIO)"/>
		        </prompt> 
		                         
                <script><![CDATA[
					customNode(applicationName + '_' + '00072_SUSP_RDGU');
                ]]></script>                 
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Choix_Transfert"); ]]></script>
	            <goto next="#Choix_Transfert"/>                  
                                                                
               
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '00070_SUSP_RDGU_NOK');
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_IMPAYE_SUSPENDU"); ]]></script>
	            <goto next="#Filtre_IMPAYE_SUSPENDU"/>                
            </if>                                   
                                         
        </block>
    </form>         
        
    <!--CTRL CLIENT IMPAYE-->
    <form id="Filtre_IMPAYE_SUSPENDU">
    	<script><![CDATA[ formCourant = "Filtre_IMPAYE_SUSPENDU"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>        
			<script><![CDATA[
			    if (CUSTOMER_MOBILE_IMPAYE && CUSTOMER_MOBILE_IMPAYE.UNPAID){
					 Total_UNPAID = parseInt(CUSTOMER_MOBILE_IMPAYE.UNPAID);			    	
			    }
			]]></script>        
              
            <!--	Client eligible au traitement IMPAYE : Unpaid superieur à 0  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_MOBILE_IMPAYE &amp;&amp; CUSTOMER_MOBILE_IMPAYE.COMPTE_FOUND == 'true' &amp;&amp; CUSTOMER_MOBILE_IMPAYE.UNPAID &amp;&amp; Total_UNPAID &gt; 0 "); ]]></script>	
            <if cond="CUSTOMER_MOBILE_IMPAYE &amp;&amp; CUSTOMER_MOBILE_IMPAYE.COMPTE_FOUND == 'true' &amp;&amp; CUSTOMER_MOBILE_IMPAYE.UNPAID &amp;&amp; Total_UNPAID &gt; 0">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_MOBILE_IMPAYE &amp;&amp; CUSTOMER_MOBILE_IMPAYE.COMPTE_FOUND == 'true' &amp;&amp; CUSTOMER_MOBILE_IMPAYE.UNPAID &amp;&amp; Total_UNPAID &gt; 0  "); ]]></script>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_MOBILE_IMPAYE.UNPAID===="+CUSTOMER_MOBILE_IMPAYE.UNPAID +"===="+Total_UNPAID); ]]></script>
            	       
                <script><![CDATA[
					customNode(applicationName + '_' + '00070_SUSPENDU');
					POSITION_ARBO = 59;	
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);					
                ]]></script>
  	            <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
	            <goto next="./ABO_FLASH_INC.vxml"/>    

                <!--	Client non eligible  au traitement IMPAYE  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00072_SUSP_MONTANT_KO');					
                ]]></script>            		
                <script><![CDATA[ log_debug_next_form(pageCourante, "Choix_Transfert"); ]]></script>
                <goto next="#Choix_Transfert"/>

            </if>
        </block>
    </form>     


    
    <!--###########################################
                Menu SUSPENDU WCB
        ########################################### -->
    <menu id="MENU_SUSPENDU_WCB">
        <script><![CDATA[ formCourant = "MENU_SUSPENDU_WCB"; ]]></script>
        <script><![CDATA[ menuCourant = "ABO_MENU_SUSPENDU_WCB"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <property name="timeout" value="5s"/>

        <prompt bargein="true">
            <audio maxage="7200" maxstale="7200" expr="PlayFileCommun(CUSTOMER_IHM.ABO_SUSPENSION_WCB_SUSPENDU_AUDIO)"/>
        </prompt>        

        <catch event="noinput nomatch" >
            <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + menuCourant + ":CHOIX", "noinput_nomatch"); ]]></script>
            <script><![CDATA[ track_dtmfList (menuCourant,"NMNI"); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '00071_WCB_SUSP_PAIEMENT');					
            ]]></script>            
            
            <script><![CDATA[ log_debug_next_form(pageCourante, "SVIPaiement"); ]]></script>
            <goto next="#SVIPaiement"/>    
        </catch>

        <choice dtmf="*" next="#Vers_Choix_TransfertWcb"/>
    </menu> 
    
    <!--###########################################
        WCB- Choix *: Transfert
    ########################################### -->
    <form id="Vers_Choix_TransfertWcb">
