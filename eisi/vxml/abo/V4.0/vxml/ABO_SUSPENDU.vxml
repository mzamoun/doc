    	<script><![CDATA[ track_dtmfList ("ABO_MENU_SUSPENDU", "1"); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '00071_SUSP_PAIEMENT');
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "SVIPaiement"); ]]></script>
            <goto next="#SVIPaiement"/>   
        </block>
    </form>
      
