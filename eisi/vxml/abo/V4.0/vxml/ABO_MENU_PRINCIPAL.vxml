        </block>
    </form>
    
    <form id="CHOIX_FLASH2_TECH_KO">
        <script><![CDATA[ formCourant = "CHOIX_FLASH2_TECH_KO"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '20002_CHOIX_FLASH2_TECH_NOK');
