        </block>
    </form>    
    
    <!--###########################################
                CTRL CHOIX FLASH2 TECH
        ########################################### -->
    <form id="CTRL_CHOIX_FLASH2_TECH">
        <script><![CDATA[ formCourant = "CTRL_CHOIX_FLASH2_TECH"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>

            <!--	Filtre CHOIX_FLASH activé -->
