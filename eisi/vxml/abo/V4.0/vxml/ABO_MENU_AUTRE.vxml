    <!--###########################################
                Menu AUTRE
        ########################################### -->

    <form id="Vers_SUITE_MENU_AUTRE">
        <script><![CDATA[ formCourant = "Vers_SUITE_MENU_AUTRE"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
        
            <script><![CDATA[ log_debug_next_form(pageCourante, "VersFiltreWCBDIGITAL"); ]]></script>
            <goto next="#VersFiltreWCBDIGITAL"/>              

        </block>
    </form>
        

    <!--#################################################################
              Filtre WCB_DIGITAL /entree suite gestion choix FLASH
       ################################################################# -->
    <form id="VersFiltreWCBDIGITAL">
    	<script><![CDATA[ formCourant = "VersFiltreWCBDIGITAL"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
		    	customNode(applicationName + '_' + '30000_MENU_AUTRE');
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "FiltreWCBDIGITAL"); ]]></script>
            <goto next="#FiltreWCBDIGITAL"/>
        </block>
    </form>

    <form id="FiltreWCBDIGITAL">
    	<script><![CDATA[ formCourant = "FiltreWCBDIGITAL"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital =='MOBILE' &amp;&amp; wcb_digital_codeMotif == '01' "); ]]></script>	
            <if cond="CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital =='MOBILE' &amp;&amp; wcb_digital_codeMotif == '01' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital =='MOBILE' &amp;&amp; wcb_digital_codeMotif == '01' "); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '33000_WCB_AUTRE');
					POSITION_ARBO = 21;	
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);						
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
                <goto next="./ABO_FLASH_INC.vxml"/>

            <else/>
			
				 <!--	Appel en provenance d AB_TEST et activite COM -->
	            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "AB_TEST_PARCOURS_ELIG == '1' "); ]]></script>
	            <if cond="AB_TEST_PARCOURS_ELIG == '1' ">
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "AB_TEST_PARCOURS_ELIG == '1' "); ]]></script>
			        <script><![CDATA[ log_debug_next_form(pageCourante, "AUTRE"); ]]></script>
			        <goto next="#AUTRE"/>
	
	            <else/>
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
			        <script><![CDATA[ log_debug_next_form(pageCourante, "MENU_AUTRE"); ]]></script>
			        <goto next="#MENU_AUTRE"/> 
	
	            </if>                    
            	
            </if>
        </block>
    </form>

    <!--###########################################
               MENU AUTRE
        ########################################### -->
    <menu id="MENU_AUTRE">
    	<script><![CDATA[ formCourant = "MENU_AUTRE"; ]]></script>
    	<script><![CDATA[ menuCourant = formCourant; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <property name="timeout" value="3s"/>
		<prompt bargein="true">
			<audio maxage="7200" maxstale="7200" expr="PlayFileCommun(CUSTOMER_IHM.ABO_MENU_AUTRE_MENU_AUTRE_AUDIO)"/>
		</prompt> 
        <catch event="noinput nomatch" cond="document.errorCounter &lt; 1">
        	<script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant, formCourant + ":CHOIX", "noinput_nomatch"); ]]></script> 
        	<script><![CDATA[ track_dtmfList (formCourant,"NMNI"); ]]></script>
            <assign name="document.errorCounter" expr="document.errorCounter + 1"/>
            <script><![CDATA[ log_debug_assignment(pageCourante,"document.errorCounter", document.errorCounter); ]]></script>
            <script><![CDATA[
				customNode(applicationName +'_39001_NMNI');  
            ]]></script>
            <prompt>
                <audio expr="PlayGenericAudio('ERREUR_SAISIE_NOUVEAU')"/>
            </prompt>
            <reprompt/>
        </catch>
        <catch event="noinput nomatch" cond="document.errorCounter == 1">
        	<script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant, formCourant + ":CHOIX", "noinput_nomatch"); ]]></script> 
        	<script><![CDATA[ track_dtmfList (formCourant,"NMNI2"); ]]></script>
           
            <script><![CDATA[ log_debug_next_form(pageCourante, "AUTRE_NMNI"); ]]></script>
            <goto next="#AUTRE_NMNI"/>
        </catch>
        
        <choice dtmf="1" next="#REGLER_FACT"/>
        <choice dtmf="2" next="#RESILIER"/>
        <choice dtmf="3" next="#AUTRE"/>
    </menu>

    <form id="REGLER_FACT">
    	<script><![CDATA[ formCourant = "REGLER_FACT"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
    	<script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant, formCourant + ":CHOIX", "1"); ]]></script> 
    	<script><![CDATA[ track_dtmfList (menuCourant, "1"); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '31000_PCB');
				POSITION_ARBO = 8;
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
				Service = 'pcb';	
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
            <goto next="./ABO_FLASH_INC.vxml"/>
                                    
        </block>
    </form>

    <form id="RESILIER">
    	<script><![CDATA[ formCourant = "RESILIER"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
    	<script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant, formCourant + ":CHOIX", "2"); ]]></script> 
    	<script><![CDATA[ track_dtmfList (menuCourant, "2"); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '32000_RESILIATION');
				POSITION_ARBO = 9;
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
            <goto next="./ABO_FLASH_INC.vxml"/>
        </block>
    </form>

    <form id="AUTRE">
    	<script><![CDATA[ formCourant = "AUTRE"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
    	<script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant, formCourant + ":CHOIX", "3"); ]]></script> 
    	<script><![CDATA[ track_dtmfList (menuCourant, "3"); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '33000_AUTRE');
				POSITION_ARBO = 21;
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
            <goto next="./ABO_FLASH_INC.vxml"/>
        </block>
    </form>


    <form id="AUTRE_NMNI">
    	<script><![CDATA[ formCourant = "AUTRE_NMNI"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>            
            <script><![CDATA[
				customNode(applicationName +'_39002_NMNI_X2');  
				POSITION_ARBO = 21;	
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
            ]]></script>        	
            <prompt bargein="false">
                <audio expr="PlayFile('NMNI_MISE_EN_RELATION')"/>
            </prompt>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
            <goto next="./ABO_FLASH_INC.vxml"/>             
        </block>
    </form>

</vxml>
