    <!--
        Auteur :
        Date de Creation :	01/12/2012
        Page :				Application ABO - ABO_MENU_AUTRE
        Modification        IMA		10/05/2013	Intégration des appels en provenance de RDGU
                            CKO		18/02/2014		Modification des noms des flux de transfert : ABO_...
                            IMA/CZO	11/03/2016		MAJ du traitement des appels en provenance de RDGU
                            IMA/CZO	13/09/2016		Ajout du traitement filtre CHOIX_FLASH
                            IMA/CZO	30/09/2016		Intégration de l'appel au WS AEM
                            CZO/IMA 18/01/2017		Evolution S08 2017 MAJ traitement RDGU + emplacement IDENT AEM
                            IMA/CZO	11/04/2017		Ajout filtre ORIGINE WCBDIGITAL et MOTIF
                            IMA/CZO	19/04/2017		Suppression des  traitements des appels en provenance de RDGU
							MRO		08/03/2018		migration v8
							IMA/CZO	04/10/2019		Ajout des positions flahs (refonte flash abo)+ refonte menu AUTRE
							IMA/CZO	06/01/2020		MAJ MENU AUTRE dynamique	
							IMA/CZO	10/03/2023		Refonte abo lot1: MAJ balises		
    -->
    <script><![CDATA[
		applicationName = "ABO"; appSvi = applicationName;
		var pageCourante = "ABO_MENU_AUTRE.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
    ]]></script>

    <var name="errorCounter" expr="0"/>
    
    <form id="VersGestionChoixFlash">
        <script><![CDATA[ formCourant = "VersGestionChoixFlash"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>                    
            <script><![CDATA[ log_debug_next_form(pageCourante, "CTRL_CHOIX_FLASH_FCT"); ]]></script>
            <goto next="#CTRL_CHOIX_FLASH_FCT"/>
                    
        </block>
    </form>
    

    <!--###########################################
                CTRL CHOIX FLASH FCT
        ########################################### -->
    <form id="CTRL_CHOIX_FLASH_FCT">
        <script><![CDATA[ formCourant = "CTRL_CHOIX_FLASH_FCT"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>

            <!--	Filtre CHOIX_FLASH activé -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.CHOIX_FLASH_FCT != 'false' "); ]]></script>
            <if cond="CUSTOMER_IHM.CHOIX_FLASH_FCT != 'false' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.CHOIX_FLASH_FCT != 'false' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '30001_CHOIX_FLASH_FCT');
					POSITION_ARBO = 93;
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
                <goto next="./ABO_FLASH_INC.vxml"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "CTRL_CHOIX_FLASH2_FCT"); ]]></script>
                <goto next="#CTRL_CHOIX_FLASH2_FCT"/>

            </if>

        </block>
    </form>
    
    <form id="CHOIX_FLASH_FCT_KO">
        <script><![CDATA[ formCourant = "CHOIX_FLASH_FCT_KO"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '30001_CHOIX_FLASH_FCT_NOK');
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "CTRL_CHOIX_FLASH2_FCT"); ]]></script>
            <goto next="#CTRL_CHOIX_FLASH2_FCT"/>   

        </block>
    </form>    
    
