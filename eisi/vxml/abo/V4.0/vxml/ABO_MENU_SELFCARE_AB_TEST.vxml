    <script><![CDATA[
	applicationName = "ABO"; appSvi = applicationName;
	var pageCourante = "ABO_MENU_SELFCARE_AB_TEST.vxml";
	log_info_start_page(pageCourante);
	var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
	var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
	var formCourant, menuCourant;
    ]]></script>

	
    <script><![CDATA[
			var tabMenu = new Array ();
			var tabMenuAction = new Array ();
			var tabMenuActivite = new Array ();
			var tabChoix = ['false', 'false', 'false', 'false'];
			var followingForm = ''; 
			
			var compteur = 0;		
			var choixDtmf = 1;
    ]]></script>	
	    
    <var name="errorCounter" expr="0"/>

  <!-- ==================================== //-->
  <!-- INIT Menu principal dynamique        //-->
  <!-- ==================================== //-->          
    <form id="initMenuPrincipal">
    	<script><![CDATA[ formCourant = "initMenuPrincipal"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
        	<!-- CHOIX PCB --> 
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_PCB =='true'"); ]]></script>	
            <if cond="CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_PCB =='true'">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_PCB =='true'"); ]]></script>	
                <script><![CDATA[
						tabMenu[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_PCB_ORDRE -1] = CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_PCB_AUDIO;
						tabChoix[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_PCB_ORDRE -1] = 'true';	
						tabMenuAction[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_PCB_ORDRE -1] ='VERS_PCB';
						tabMenuActivite[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_PCB_ORDRE -1] ='PCB';						
						compteur++;
					
                ]]></script>
                <script><![CDATA[ log_debug_assignment(pageCourante,'PCB',tabChoix[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_PCB_ORDRE -1]); ]]></script>
                
            </if>
            
        	<!-- CHOIX DCS --> 
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_DCS =='true'"); ]]></script>	
            <if cond="CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_DCS =='true'">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_DCS =='true'"); ]]></script>	
                <script><![CDATA[
						tabMenu[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_DCS_ORDRE -1] = CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_DCS_AUDIO;
						tabChoix[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_DCS_ORDRE -1] = 'true';	
						tabMenuAction[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_DCS_ORDRE -1] ='VERS_DCS';
						tabMenuActivite[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_DCS_ORDRE -1] ='DCS';
						compteur++;
					
                ]]></script>
                <script><![CDATA[ log_debug_assignment(pageCourante,'DCS',tabChoix[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_DCS_ORDRE -1]); ]]></script>
                
            </if> 
            
        	<!-- CHOIX ACS --> 
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_ACS =='true'"); ]]></script>	
            <if cond="CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_ACS =='true'">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_ACS =='true'"); ]]></script>	
                <script><![CDATA[
						tabMenu[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_ACS_ORDRE -1] = CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_ACS_AUDIO;
						tabChoix[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_ACS_ORDRE -1] = 'true';	
						tabMenuAction[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_ACS_ORDRE -1] ='VERS_ACS';
						tabMenuActivite[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_ACS_ORDRE -1] ='ACS';
						compteur++;
					
                ]]></script>
                <script><![CDATA[ log_debug_assignment(pageCourante,'ACS',tabChoix[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_ACS_ORDRE -1]); ]]></script>
                
            </if> 
            
        	<!-- CHOIX SDL --> 
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_SDL =='true'"); ]]></script>	
            <if cond="CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_SDL =='true'">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_SDL =='true'"); ]]></script>	
                <script><![CDATA[
						tabMenu[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_SDL_ORDRE -1] = CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_SDL_AUDIO;
						tabChoix[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_SDL_ORDRE -1] = 'true';	
						tabMenuAction[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_SDL_ORDRE -1] ='VERS_SDL';
						tabMenuActivite[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_SDL_ORDRE -1] ='SDL';
						compteur++;
					
                ]]></script>
                <script><![CDATA[ log_debug_assignment(pageCourante,'SDL',tabChoix[CUSTOMER_IHM.ABO_MENU_SELFCARE_AB_TEST_SDL_ORDRE -1]); ]]></script>
                
            </if>                                    
            
            <script><![CDATA[ log_debug_assignment(pageCourante,'compteur',compteur); ]]></script>

            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "compteur == 0"); ]]></script>	
            <if cond="compteur == 0">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "compteur == 0"); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "NMNI"); ]]></script>
                <goto next="#NMNI"/>
            </if>
              
            <script><![CDATA[ log_debug_next_form(pageCourante, "ABO_MENU_SELFCARE_AB_TEST"); ]]></script>
            <goto next="#ABO_MENU_SELFCARE_AB_TEST"/>
        </block>
    </form>
    
    
    
    <menu id="ABO_MENU_SELFCARE_AB_TEST">
    	<script><![CDATA[ formCourant = "ABO_MENU_SELFCARE_AB_TEST"; ]]></script>
    	<script><![CDATA[ menuCourant = formCourant; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <property name="timeout" value="3s"/>
        <property name="bargein" value="true"/>

        <prompt>
            <foreach item="itemMenu" array="tabMenu">
                <audio  maxage="7200" maxstale="7200" expr="PlayFileCommun(itemMenu)"/>
                <audio  maxage="7200" maxstale="7200" expr="sayasChoixDtmfWav(choixDtmf)"/>
                <assign name="choixDtmf" expr="choixDtmf + 1"/>
            </foreach>
        </prompt>

        
        <catch event="noinput nomatch">           
            <script><![CDATA[ log_debug_next_form(pageCourante, "nomatch"); ]]></script>
            <goto next="#nomatch"/>
        </catch>        

        <choice dtmf="1" next="#VersChoix1"/>
        <choice dtmf="2" next="#VersChoix2"/>
        <choice dtmf="3" next="#VersChoix3"/>
        <choice dtmf="4" next="#VersChoix4"/>

    </menu>


    
    <!--###########################################
		Vers Choix1
		########################################### -->
    <form id="VersChoix1">
    	<script><![CDATA[ formCourant = "VersChoix1"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
    	<script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "1"); ]]></script> 
    	<script><![CDATA[ track_dtmfList ("ABO_MENU_SELFCARE_AB_TEST", "1"); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "tabChoix[0] == 'false'"); ]]></script>	
            <if cond="tabChoix[0] == 'false'">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "tabChoix[0] == 'false'"); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "nomatch"); ]]></script>
                <goto next="#nomatch"/>
            </if>
            <script><![CDATA[
				MENU_AB_TEST_NIVEAU2_CHOIX ='1';
				log_debug_assignment(pageCourante, "MENU_AB_TEST_NIVEAU2_CHOIX", MENU_AB_TEST_NIVEAU2_CHOIX);
				customNode(applicationName + '_' + '11000_'+ tabMenuActivite[0] );
				var followingForm = "#" + tabMenuAction[0] ; 
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, followingForm); ]]></script>
            <goto expr="followingForm"/>            
            
        </block>
    </form>
    
        
