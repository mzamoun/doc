    <!--###########################################
                CTRL CHOIX FLASH3 FCT
        ########################################### -->
    <form id="CTRL_CHOIX_FLASH3_FCT_PREMIUM">
        <script><![CDATA[ formCourant = "CTRL_CHOIX_FLASH3_FCT_PREMIUM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>

            <!--	Filtre CHOIX_FLASH activé -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.CHOIX_FLASH3_FCT_PREMIUM != 'false' "); ]]></script>
            <if cond="CUSTOMER_IHM.CHOIX_FLASH3_FCT_PREMIUM != 'false' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.CHOIX_FLASH3_FCT_PREMIUM != 'false' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '30003_CHOIX_FLASH3_FCT_PREM');
					POSITION_ARBO = 107;
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./ABO_FLASH_INC.vxml"); ]]></script>
                <goto next="./ABO_FLASH_INC.vxml"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "SUITE_PREMIUM_AUTRE"); ]]></script>
                <goto next="#SUITE_PREMIUM_AUTRE"/>

            </if>

        </block>
    </form>
    
