  /**
   * Client MOBILE - BOX5G
   * @returns
   */
function isClientMobileBox5G() {
	var status = false;
	
	if ( CUSTOMER_AEM.flagBox5g && CUSTOMER_AEM.flagBox5g =='true') {
			status = true;
		}
	return status;

} 
 
