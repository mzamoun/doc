    <script><![CDATA[
		applicationName = "FIXE"; appSvi = applicationName;
		var pageCourante = "FIXE_ENTREE_GP.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
    ]]></script>
	    
    <var name="errorCounter" expr="1"/>

    <script><![CDATA[
    	POSITION_ARBO = 1;
   		applicationName = "FIXE";
    ]]></script>


    <!--###########################################
        Gestion des différents cas client
    ########################################### -->

    <!--###########################################
        Traitement ACTIVATION
    ########################################### -->
    <form id="VersFiltreActivation">
        <script><![CDATA[ formCourant = "VersFiltreActivation"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>            
                                                                   
            <!-- Client ACTIVATION DEXTER 	-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.ACTIVATION_DEXTER != 'false' &amp;&amp; ( isClientFixeACTIVATION() || (type_appel_wcb_digital =='FIXE' &amp;&amp; wcb_digital_codeMotif =='06') ) "); ]]></script>
            <if cond="CUSTOMER_IHM.ACTIVATION_DEXTER != 'false' &amp;&amp; ( isClientFixeACTIVATION() || (type_appel_wcb_digital =='FIXE' &amp;&amp; wcb_digital_codeMotif =='06') )">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.ACTIVATION_DEXTER != 'false' &amp;&amp; ( isClientFixeACTIVATION() || (type_appel_wcb_digital =='FIXE' &amp;&amp; wcb_digital_codeMotif =='06') ) "); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '00010_F_ACTIVATION');
					POSITION_ARBO = 78;						
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/>	            
	            	            
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "GestionCasHOME"); ]]></script>
                <goto next="#GestionCasHOME"/>

            </if>            
            
        </block>
    </form>
        
    <!--###########################################
        Client HOME
    ########################################### -->
    <form id="GestionCasHOME">
        <script><![CDATA[ formCourant = "GestionCasHOME"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
        
            <!-- Client HOME DEXTER ET ORIGINE !=  WCBDIGITAL 	-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.HOME_DEXTER != 'false' &amp;&amp; isClientHomeDexter() &amp;&amp; type_appel_wcb_digital !='FIXE' "); ]]></script>
            <if cond="CUSTOMER_IHM.HOME_DEXTER == 'true' &amp;&amp; isClientHomeDexter() &amp;&amp; type_appel_wcb_digital !='FIXE' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.HOME_DEXTER != 'false' &amp;&amp; isClientHomeDexter() &amp;&amp; type_appel_wcb_digital !='FIXE'  "); ]]></script>
	            <script><![CDATA[
	            	customNode(applicationName + '_' + '00020_F_HOME');
					POSITION_ARBO = 74;
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/>	            	            
	                             
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
	                customNode(applicationName + '_' + '00020_HOME_NON_ELIGIBLE');
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "VersTraitementClns"); ]]></script>
                <goto next="#VersTraitementClns"/>
            </if>
        </block>
    </form>
    
    <form id="SuiteGestionCasHOME">
        <script><![CDATA[ formCourant = "SuiteGestionCasHOME"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
            	customNode(applicationName + '_' + '00020_HOME');
				POSITION_ARBO = 75;
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>
	            	                    
        </block>
    </form>    

    <!--###########################################
           filtre CLNS - WS(new) 
   ########################################### -->

    <form id="VersTraitementClns">
        <script><![CDATA[ formCourant = "VersTraitementClns"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.CLNS_ACTIVE != 'false' &amp;&amp; type_appel_wcb_digital !='FIXE' &amp;&amp; Id_Siebel != '' &amp;&amp; Id_Siebel != 'null'"); ]]></script>
            <if cond="CUSTOMER_IHM.CLNS_ACTIVE != 'false' &amp;&amp; type_appel_wcb_digital !='FIXE' &amp;&amp; Id_Siebel != '' &amp;&amp; Id_Siebel != 'null' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.CLNS_ACTIVE != 'false' &amp;&amp; type_appel_wcb_digital !='FIXE' &amp;&amp; Id_Siebel != '' &amp;&amp; Id_Siebel != 'null'"); ]]></script>
	            <!--Recup de la techno FIXE -->
                <script><![CDATA[
					TECHNO =  GET_TECHNO_FIXE();
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
                ]]></script>               
                <script><![CDATA[ log_debug_next_form(pageCourante, "GestionCasCLNS"); ]]></script>
                <goto next="#GestionCasCLNS"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>                               
                <script><![CDATA[ log_debug_next_form(pageCourante, "VersTraitementClnsKo"); ]]></script>
                <goto next="#VersTraitementClnsKo"/>

            </if>
        </block>
    </form>
        

    <!--######################################################
        TRAITEMENT WS CLNS : appel à la web app subdialog/CLNS
        ###################################################### -->    
    <form id="GestionCasCLNS">
        <script><![CDATA[ formCourant = "GestionCasCLNS"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[
			var id_siebel = Id_Siebel ;  
			var techno = TECHNO ;    
        ]]></script>
        <script><![CDATA[ log_debug_appel_web_app(pageCourante, 'WS_ELIGIBILITE_CLNS', subdialogWS_ELIGIBILITE_CLNS , 'id_siebel=' + id_siebel +'|techno=' + techno  ); ]]></script>
        <subdialog name="WS_ELIGIBILITE_CLNS"
                   srcexpr="subdialogWS_ELIGIBILITE_CLNS"
                   namelist="id_siebel techno"
                   method="get"
                   fetchtimeout="5s"
                   fetchaudio="../../../audio/Attente.wav"/>
                   
        <catch event="error">
            <script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '80000_WS_ELIGIBILITE_CLNS_HS');
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "VersTraitementWsClnsKo"); ]]></script>
            <goto next="#VersTraitementWsClnsKo"/>
        </catch>

        <block>
            <script><![CDATA[ log_debug_result_web_app(pageCourante, 'WS_ELIGIBILITE_CLNS', WS_ELIGIBILITE_CLNS ); ]]></script>
            
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " WS_ELIGIBILITE_CLNS.APP_STATUS == 'NOK' || WS_ELIGIBILITE_CLNS.WS_STATUS == 'NOK' "); ]]></script>
            <if cond=" WS_ELIGIBILITE_CLNS.APP_STATUS == 'NOK' || WS_ELIGIBILITE_CLNS.WS_STATUS == 'NOK' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " WS_ELIGIBILITE_CLNS.APP_STATUS == 'NOK' || WS_ELIGIBILITE_CLNS.WS_STATUS == 'NOK' "); ]]></script>
	            <script><![CDATA[
					CUSTOMER_CLNS_WS = {};
	            ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "VersTraitementWsClnsKo"); ]]></script>
	            <goto next="#VersTraitementWsClnsKo"/>	            

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
				<script><![CDATA[ log_debug_assignment(pageCourante,"CUSTOMER_CLNS_WS", WS_ELIGIBILITE_CLNS); ]]></script>
                <assign name="CUSTOMER_CLNS_WS" expr="WS_ELIGIBILITE_CLNS"/>
                
             </if>
             
            <!--	Client ELIGIBLE CLNS via WS	 -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "is_ws_clns() "); ]]></script>
            <if cond=" is_ws_clns() ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "is_ws_clns() "); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '00030_F_CLNS');
					POSITION_ARBO = 79;						
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/>                

                <!--	Client non concerné par traitement CLNS via WS  -->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "VersTraitementClnsKo"); ]]></script>
                <goto next="#VersTraitementClnsKo"/>

            </if>               

                                          
        </block>
    </form>     
    
    
    <form id="VersTraitementWsClnsKo">
        <script><![CDATA[ formCourant = "VersTraitementWsClnsKo"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '00030_F_CLNS_WS_KO');
				POSITION_ARBO = 172;						
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>  	        
            
        </block>
    </form> 
        
    <form id="VersTraitementClnsKo">
        <script><![CDATA[ formCourant = "VersTraitementClnsKo"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
	        <script><![CDATA[
	            customNode(applicationName + '_' + '00030_F_CLNS_NOK');
	        ]]></script> 
            <script><![CDATA[ log_debug_next_form(pageCourante, "VersTraitementClnsNos"); ]]></script>
            <goto next="#VersTraitementClnsNos"/>
            
        </block>
    </form> 
    
        
 
    <!--###########################################
           filtre CLNS_NOS WS (NEW)
   ########################################### -->

    <form id="VersTraitementClnsNos">
        <script><![CDATA[ formCourant = "VersTraitementClnsNos"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>                
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.NOS_ACTIVE != 'false' &amp;&amp; type_appel_wcb_digital !='FIXE' &amp;&amp; Id_Siebel != '' &amp;&amp; Id_Siebel != 'null'"); ]]></script>
            <if cond="CUSTOMER_IHM.NOS_ACTIVE != 'false' &amp;&amp; type_appel_wcb_digital !='FIXE' &amp;&amp; Id_Siebel != '' &amp;&amp; Id_Siebel != 'null' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.NOS_ACTIVE != 'false' &amp;&amp; type_appel_wcb_digital !='FIXE' &amp;&amp; Id_Siebel != '' &amp;&amp; Id_Siebel != 'null'"); ]]></script>
	            <!--Recup de la techno FIXE -->
                <script><![CDATA[
					TECHNO =  GET_TECHNO_FIXE();
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
                ]]></script>               
                <script><![CDATA[ log_debug_next_form(pageCourante, "GestionCasCLNS_NOS"); ]]></script>
                <goto next="#GestionCasCLNS_NOS"/>                

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>               
                <script><![CDATA[ log_debug_next_form(pageCourante, "VersTraitementNosKo"); ]]></script>
                <goto next="#VersTraitementNosKo"/>

            </if>
        </block>
    </form>
           

    <!--######################################################
        appel au Ws NOS
        ###################################################### -->
    <form id="GestionCasCLNS_NOS">
        <script><![CDATA[ formCourant = "GestionCasCLNS_NOS"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[
			var id_siebel = Id_Siebel ;  
			var techno = TECHNO ;    
        ]]></script>
        <script><![CDATA[ log_debug_appel_web_app(pageCourante, 'WS_ELIGIBILITE_NOS', subdialogWS_ELIGIBILITE_NOS , 'id_siebel=' + id_siebel +'|techno=' + techno  ); ]]></script>
        <subdialog name="WS_ELIGIBILITE_NOS"
                   srcexpr="subdialogWS_ELIGIBILITE_NOS"
                   namelist="id_siebel techno"
                   method="get"
                   fetchtimeout="5s"
                   fetchaudio="../../../audio/Attente.wav"/>
                   
        <catch event="error">
            <script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '80000_WS_ELIGIBILITE_NOS_HS');
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "VersTraitementWsNosKo"); ]]></script>
            <goto next="#VersTraitementWsNosKo"/>
        </catch>

        <block>
            <script><![CDATA[ log_debug_result_web_app(pageCourante, 'WS_ELIGIBILITE_NOS', WS_ELIGIBILITE_NOS ); ]]></script>
            
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " WS_ELIGIBILITE_NOS.APP_STATUS == 'NOK' || WS_ELIGIBILITE_NOS.WS_STATUS == 'NOK' "); ]]></script>
            <if cond=" WS_ELIGIBILITE_NOS.APP_STATUS == 'NOK' || WS_ELIGIBILITE_NOS.WS_STATUS == 'NOK' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " WS_ELIGIBILITE_NOS.APP_STATUS == 'NOK' || WS_ELIGIBILITE_NOS.WS_STATUS == 'NOK' "); ]]></script>
	            <script><![CDATA[
					CUSTOMER_NOS_WS = {};
	            ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "VersTraitementWsNosKo"); ]]></script>
	            <goto next="#VersTraitementWsNosKo"/>	            

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
				<script><![CDATA[ log_debug_assignment(pageCourante,"CUSTOMER_NOS_WS", WS_ELIGIBILITE_NOS); ]]></script>
                <assign name="CUSTOMER_NOS_WS" expr="WS_ELIGIBILITE_NOS"/>
                
             </if>
             
            <!--	Client ELIGIBLE NOS via WS	 -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "is_ws_nos() "); ]]></script>
            <if cond=" is_ws_nos() ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "is_ws_nos() "); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '00040_F_NOS');
					POSITION_ARBO = 80;						
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/>  

                <!--	Client non concerné par traitement CLNS_NOS  -->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "VersTraitementNosKo"); ]]></script>
                <goto next="#VersTraitementNosKo"/>

            </if>              

                                          
