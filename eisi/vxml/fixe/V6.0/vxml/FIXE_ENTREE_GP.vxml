    <!-- ======================================================= //-->
    <!-- PRE TRAITEMENT RISQUE - FINDMARKER	//-->
    <!-- ======================================================= //-->
    <form id="VersPreTraitementRisque">
        <script><![CDATA[ formCourant = "VersPreTraitementRisque"; ]]></script>
