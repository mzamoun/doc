            <if cond="isClientFixeImpayeSAP_RMCA() ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeImpayeSAP_RMCA() "); ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "IMPAYE_SAP_RMCA_OK"); ]]></script>
	            <goto next="#IMPAYE_SAP_RMCA_OK"/>                      

                <!--	Client non eligible  au traitement IMPAYE  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "IMPAYE_SAP_RMCA_KO"); ]]></script>
                <goto next="#IMPAYE_SAP_RMCA_KO"/>

            </if>             

        </block>
    </form>     
    

	<!--TRT SAP_RMCA OK-->        
    <form id="IMPAYE_SAP_RMCA_OK">
        <script><![CDATA[ formCourant = "IMPAYE_SAP_RMCA_OK"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <!--initialisation de la variable origine_impaye_sap --> 
            <script><![CDATA[
				origine_impaye_sap = 'true';
				log_debug_assignment(pageCourante, "origine_impaye_sap", origine_impaye_sap);
								
				customNode(applicationName + '_' + '00080_F_IMPAYE_SAP');
				POSITION_ARBO = 53;						
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/> 
        </block>
    </form>
          
	<!--TRT SAP_RMCA KO-->             
    <form id="IMPAYE_SAP_RMCA_KO">
        <script><![CDATA[ formCourant = "IMPAYE_SAP_RMCA_KO"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '00080_F_IMPAYE_SAP_KO');
				POSITION_ARBO = 54;						
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/> 
        </block>
    </form>
    
	<!--TRT SAP_RMCA NON-->    
    <form id="IMPAYE_SAP_RMCA_NON">
        <script><![CDATA[ formCourant = "IMPAYE_SAP_RMCA_NON"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '00080_F_IMPAYE_SAP_NON');
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_Wcb_Digital"); ]]></script>
            <goto next="#Filtre_Wcb_Digital"/>
        </block>
    </form>
    
	<!--GEstion du retour impaye suite trt sap_rmca-->     
    <form id="RETOUR_IMPAYE_SAP_RMCA">
        <script><![CDATA[ formCourant = "RETOUR_IMPAYE_SAP_RMCA"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_Wcb_Digital"); ]]></script>
            <goto next="#Filtre_Wcb_Digital"/>
        </block>
    </form>        
        
    <!--######################################################
        filtre WCB_DIGITAL
        ###################################################### -->    

    <form id="Filtre_Wcb_Digital">
        <script><![CDATA[ formCourant = "Filtre_Wcb_Digital"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <!--	Client en provenance de WCB_DIGITAL		-->
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital == 'FIXE' "); ]]></script>
            <if cond="CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital == 'FIXE' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital == 'FIXE' "); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '00090_F_WCB');
					POSITION_ARBO = 83;						
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/>                 

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_RDGU"); ]]></script>
                <goto next="#Filtre_RDGU"/>
            </if>
        </block>
    </form>
    
    <!--#####################################################################################################
        filtre RDGU
        ##################################################################################################### -->
   
    <!--CTRL PROVENANCE RDGU-->
    <form id="Filtre_RDGU">
    	<script><![CDATA[ formCourant = "Filtre_RDGU"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <!--	Client RDGU  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.RDGU != 'false' &amp;&amp; is_provenance_rdgu() "); ]]></script>	
            <if cond="CUSTOMER_IHM.RDGU != 'false' &amp;&amp; is_provenance_rdgu()">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.RDGU != 'false' &amp;&amp; is_provenance_rdgu()"); ]]></script>	

                <script><![CDATA[
					customNode(applicationName + '_' + '00050_F_RDGU');
					POSITION_ARBO = 158;	
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);						
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
                <goto next="./FIXE_FLASH_INC.vxml"/>                      

                <!--	Client non rdgu  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "GestionCasPREMIUM"); ]]></script>
                <goto next="#GestionCasPREMIUM"/>

            </if>

        </block>
    </form>    
    
   <!--###########################################
            Filtre PREMIUM 
    ########################################### -->
    <form id="GestionCasPREMIUM">
        <script><![CDATA[ formCourant = "GestionCasPREMIUM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <!--	 COLLAB DEXTER -->  
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.COLLAB_DEXTER != 'false' &amp;&amp; is_collab_dexter() "); ]]></script>
            <if cond="CUSTOMER_IHM.COLLAB_DEXTER != 'false' &amp;&amp; is_collab_dexter() ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.COLLAB_DEXTER != 'false' &amp;&amp; is_collab_dexter()"); ]]></script>                
                <script><![CDATA[
					customNode(applicationName + '_' + '00060_COLLAB_DEXTER');
					customNode(applicationName + '_' + '00060_F_PREMIUM');
					POSITION_ARBO = 4;
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
                <goto next="./FIXE_FLASH_INC.vxml"/>
                                	            
            <!--	 (Premium via les données SEARCH /DEXTER  ) -->  
            <elseif cond="CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium()  "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() "); ]]></script>                
                <script><![CDATA[
					customNode(applicationName + '_' + '00060_F_PREMIUM');
					POSITION_ARBO = 4;
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
                <goto next="./FIXE_FLASH_INC.vxml"/>	                            

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>               
                <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_MENU_PRINCIPAL"); ]]></script>
                <goto next="#VERS_MENU_PRINCIPAL"/>

            </if>

        </block>
    </form>    

    <!--###########################################
         MENU PRINCIPAL
    ########################################### -->

    <form id="VERS_MENU_PRINCIPAL">
        <script><![CDATA[ formCourant = "VERS_MENU_PRINCIPAL"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        
        <block>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_MENU_PRINCIPAL.vxml"); ]]></script>
            <goto next="./FIXE_MENU_PRINCIPAL.vxml"/>

        </block>
    </form>
 

        
    <!--###########################################
         Entree à partir de la page wcb
    ########################################### -->

    <form id="RETOUR_TRAITEMENT_WCB">
        <script><![CDATA[ formCourant = "RETOUR_TRAITEMENT_WCB"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>

            <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_RDGU"); ]]></script>
            <goto next="#Filtre_RDGU"/>
        </block>
    </form>
              

</vxml>
