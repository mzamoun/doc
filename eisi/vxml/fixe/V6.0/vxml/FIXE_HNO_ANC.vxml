    <script><![CDATA[
		applicationName = "FIXE"; appSvi = applicationName;
		var pageCourante = "FIXE_HNO_ANC.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
    ]]></script>


    <form id="HNO_ANC">
    	<script><![CDATA[ formCourant = "HNO_ANC"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
        
			<!-- Diffusion du message HNO ANC -->
			<prompt bargein="false">
				<audio maxage="30" maxstale="30" expr="PlayFileHNO_MAC2(CUSTOMER_HOHNO.FIXE_ANC_MSG_TO_PLAY)"/>
			</prompt>        

            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_DISCONNECT.vxml"); ]]></script>
            <goto next="./FIXE_DISCONNECT.vxml"/>
        </block>
    </form>  

</vxml>
