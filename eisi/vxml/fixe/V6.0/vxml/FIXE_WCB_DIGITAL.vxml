    <!--
        Auteur :			IMA/CZO
        Date de Creation :	14/04/2017
        Page :				Application FIXE - 			Traitement des appels en provenance de WCB_DIGITAL
        Modification :		IMA/CZO 12/10/2017     	   	Prise en compte des traitements CONV et RISQUE
                            IMA/CZO 24/01/2018     	   	Simplification des flux de transfert
                            MRO		15/03/2018			migration v8
							IMA/CZO 05/05/2018			menage conditions mog SAFIR	
							IMA/CZO	05/07/2018			Menage des traitements SAFIR - full LDCCSU	
							EISI	12/11/2018			MAJ du traitement PREMIUM - Ajout du traitement du marker CELL_PREM	
							EISI	12/12/2018			Integration des traitements PREMIUM DMGT	
							EISI	16/01/2019			MAJ du traitement PREMIUM - PLATINE + inetgartion ctrl HOHNO specifique	
							IMA/CZO	01/03/2019		  	suppression traitement RED    
							IMA/CZO	25/03/2019		    MAJ traitement PREMIUM - PACKPRO
							IMA/CZO	05/11/2019		    MAJ traitement COLLAB
							IMA/CZO	07/05/2021		    Menage des traitements ARAMIS			   		
    -->
    <script><![CDATA[
		applicationName = "FIXE"; appSvi = applicationName;
		var pageCourante = "FIXE_WCB_DIGITAL.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
    ]]></script>

    <!--##################################################
      AIGUILLAGE appels WCB_DIGITAL suivant MOTIF
 	 ################################################# -->
    <form id="WCB_AIGUILLAGE_MOTIF">
        <script><![CDATA[ formCourant = "WCB_AIGUILLAGE_MOTIF"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isObjectInArray(wcb_digital_codeMotif, ['01','02' ,'03' ])"); ]]></script>
            <if cond="isObjectInArray(wcb_digital_codeMotif, ['01','02' ,'03' ])">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isObjectInArray(wcb_digital_codeMotif, ['01','02' ,'03' ])"); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00080_WCB_TECHNIQUE');
                ]]></script>
                
	            <!--	SOUS APPLI FIXE_TECH HO  -->
	            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_TECH_IS_OPEN !='false' "); ]]></script>	
	            <if cond=" CUSTOMER_HOHNO.FIXE_TECH_IS_OPEN !='false' ">
	            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_TECH_IS_OPEN !='false' "); ]]></script>
	                <script><![CDATA[
						customNode(applicationName + '_' + '00080_WCB_HO_TECH');
	                ]]></script>	 
	                           	
		            <!-- PREMIUM -->  
		            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() "); ]]></script>
		            <if cond="CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() ">
		                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() "); ]]></script>
		                <script><![CDATA[
							customNode(applicationName + '_' + '00080_WCB_PREM_TECH');
		                ]]></script>		
			            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_PREMIUM.vxml#ENTREE_WCB_DIGITAL_PREMIUM_TECH"); ]]></script>
		                <goto next="./FIXE_PREMIUM.vxml#ENTREE_WCB_DIGITAL_PREMIUM_TECH"/>
		                		
		            <else/>
		                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
		                <script><![CDATA[
							customNode(applicationName + '_' + '00080_WCB_TECH');
		                ]]></script>		                
		            
		                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_MENU_PRINCIPAL.vxml#ENTREE_WCB_DIGITAL_TECH"); ]]></script>
		                <goto next="./FIXE_MENU_PRINCIPAL.vxml#ENTREE_WCB_DIGITAL_TECH"/>		
		            </if> 
					
	
	            <!--	FIXE_TECH HNO  -->
	            <else/>
	            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
	                <script><![CDATA[
						customNode(applicationName + '_' + '00042_WCB_HNO_TECH');
	                ]]></script>
	                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_HNO_TECH.vxml"); ]]></script>
	                <goto next="./FIXE_HNO_TECH.vxml"/>
	
	            </if>             

            <elseif cond="wcb_digital_codeMotif == '04' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "wcb_digital_codeMotif == '04' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00080_WCB_DEMENAGEMENT');
                ]]></script>
                
	            <!--	SOUS APPLI FIXE_DEM HO  -->
	            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_DEM_IS_OPEN !='false' "); ]]></script>	
	            <if cond=" CUSTOMER_HOHNO.FIXE_DEM_IS_OPEN !='false' ">
	            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_DEM_IS_OPEN !='false' "); ]]></script>	
	                <script><![CDATA[
						customNode(applicationName + '_' + '00080_WCB_HO_DEM');
	                ]]></script>	            	
	            	
		            <!-- PREMIUM -->  
		            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() "); ]]></script>
		            <if cond="CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() ">
		                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() "); ]]></script>
		                <script><![CDATA[
							customNode(applicationName + '_' + '00080_WCB_PREM_DMGT');
		                ]]></script>		
			            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_PREMIUM.vxml#ENTREE_WCB_DIGITAL_PREMIUM_DMGT"); ]]></script>
		                <goto next="./FIXE_PREMIUM.vxml#ENTREE_WCB_DIGITAL_PREMIUM_DMGT"/>
		                		
		            <else/>
		                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
		                <script><![CDATA[
							customNode(applicationName + '_' + '00080_WCB_DMGT');
		                ]]></script>		                
		            
		                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_MENU_PRINCIPAL.vxml#ENTREE_WCB_DIGITAL_DMGT"); ]]></script>
		                <goto next="./FIXE_MENU_PRINCIPAL.vxml#ENTREE_WCB_DIGITAL_DMGT"/>	 	
		            </if>
	
	            <!--	FIXE_DEM HNO  -->
	            <else/>
	            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
	                <script><![CDATA[
						customNode(applicationName + '_' + '00042_WCB_HNO_DEM');
	                ]]></script>
	                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_HNO_DEM.vxml"); ]]></script>
	                <goto next="./FIXE_HNO_DEM.vxml"/>
	
	            </if>                

            <elseif cond="wcb_digital_codeMotif == '05' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "wcb_digital_codeMotif == '05' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00080_WCB_ADMIN');
                ]]></script>                
                
	            <!--	SOUS APPLI FIXE_COM HO  -->
	            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_COM_IS_OPEN !='false' "); ]]></script>	
	            <if cond=" CUSTOMER_HOHNO.FIXE_COM_IS_OPEN !='false' ">
	            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_COM_IS_OPEN !='false' "); ]]></script>	
	                <script><![CDATA[			               
						customNode(applicationName + '_' + '00080_WCB_HO_COM');
		            ]]></script>
		            
		            <!-- PREMIUM -->  
		            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() "); ]]></script>
		            <if cond="CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() ">
		                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() "); ]]></script>
		
			            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_PREMIUM_AUTRE.vxml#ENTREE_WCB_DIGITAL_PREMIUM_AUTRE"); ]]></script>
		                <goto next="./FIXE_PREMIUM_AUTRE.vxml#ENTREE_WCB_DIGITAL_PREMIUM_AUTRE"/>
		
		            <else/>
		                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	            
	
		                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_ADMINISTRATIF.vxml#ENTREE_GP_ADMIN_WCB"); ]]></script>
		                <goto next="./FIXE_ADMINISTRATIF.vxml#ENTREE_GP_ADMIN_WCB"/>	
		            </if>
	
	            <!--	FIXE_COM HNO  -->
	            <else/>
	            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
	                <script><![CDATA[			               
						customNode(applicationName + '_' + '00042_WCB_HNO_COM');
	                ]]></script>
	                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_HNO_COM.vxml"); ]]></script>
	                <goto next="./FIXE_HNO_COM.vxml"/>
	
	            </if>                 
                 

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_ENTREE_GP.vxml#RETOUR_TRAITEMENT_WCB"); ]]></script>
                <goto next="./FIXE_ENTREE_GP.vxml#RETOUR_TRAITEMENT_WCB"/>

            </if>
        </block>
    </form>

    <!--#################################################################################################
         GP/PREMIUM- ACTIVATION : Traitement des appels en provenance de WCB en ACTIVATION
    ################################################################################################# -->
    <form id="Wcb_Activation_PREMIUM">
        <script><![CDATA[ formCourant = "Wcb_Activation_PREMIUM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
        
			<!-- Client PREMIUM -->                  
            <!-- Client PREMIUM -  CABLE - APPORTEUR= MIG_NC	-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientFixeMIG_NC() "); ]]></script>
            <if cond="isClientFixeMIG_NC() ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeMIG_NC()  "); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '00010_WCB_ACTIV_PREMIUM_FTTB_MIG');
					ID_FLUX='WCB_ACTIV_PREMIUM_FTTB_MIG';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
	            ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/> 


            <!-- Client PREMIUM  - CABLE* -->
            <elseif cond="isClientFixeFTTB() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTB() "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00010_WCB_ACTIV_PREMIUM_FTTB');
					ID_FLUX='WCB_ACTIV_PREMIUM_FTTB';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/> 


                <!-- Client PREMIUM  - FTTH -->
            <elseif cond="isClientFixeFTTH() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH() "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00010_WCB_ACTIV_PREMIUM_FTTH');
					ID_FLUX='WCB_ACTIV_PREMIUM_FTTH';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/> 


                <!-- cas par défaut - PREMIUM  AUTRE	-->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
	                customNode(applicationName + '_' + '00010_WCB_ACTIV_PREMIUM_AUTRE');
					ID_FLUX='WCB_ACTIV_PREMIUM_ADSL';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>  

            </if> 

        </block>
    </form>    
    
    <form id="Wcb_Activation_GP">
        <script><![CDATA[ formCourant = "Wcb_Activation_GP"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
			<!-- Client GP -->                      
            <!-- Client CABLE - APPORTEUR= MIG_NC	-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientFixeMIG_NC()"); ]]></script>
            <if cond="isClientFixeMIG_NC() ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeMIG_NC() "); ]]></script>                               

                <script><![CDATA[
					customNode(applicationName + '_' + '00010_WCB_ACTIV_FTTB_MIG');
					ID_FLUX='WCB_ACTIV_FTTB_MIG';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>  

                <!-- Client CABLE -->
            <elseif cond=" isClientFixeFTTB() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " isClientFixeFTTB() "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00010_WCB_ACTIV_FTTB');
					ID_FLUX='WCB_ACTIV_FTTB';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>  

                <!-- Client THD	-->
            <elseif cond="isClientFixeFTTH()"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH() "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00010_WCB_ACTIV_FTTH');
					ID_FLUX='WCB_ACTIV_FTTH';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>  

                <!-- cas par défaut	-->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00010_WCB_ACTIV_AUTRE');
					ID_FLUX='WCB_ACTIV_ADSL';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>  

            </if>

        </block>
    </form>

    <!--#################################################################################################
         TECHNIQUE GP: Traitement des appels en provenance de WCB avec motif technique
    ################################################################################################# -->

    <form id="Wcb_Technique_GP">
        <script><![CDATA[ formCourant = "Wcb_Technique_GP"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "wcb_digital_codeMotif == '01'"); ]]></script>
            <if cond="wcb_digital_codeMotif == '01'">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "wcb_digital_codeMotif == '01'"); ]]></script>
                <script><![CDATA[
	                customNode(applicationName + '_' + '21000_WCB_TECH_INTERNET');		
                ]]></script>
                
	            <script><![CDATA[				
					<!--POSITION_INCIDENT_HEIMDALL = liste ('position|balise|page_suivante|form suivant') -->				
					POSITION_INCIDENT_HEIMDALL = '2|21000_WCB_TECH_INTERNET|FLASH_INC|;';
					log_debug_assignment(pageCourante, "POSITION_INCIDENT_HEIMDALL", POSITION_INCIDENT_HEIMDALL);						
				]]></script>            
	
				<!-- Position  flash -->          		
	            <script><![CDATA[
	                POSITION_ARBO = 46;				
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            
				<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_INCIDENT_INC.vxml"); ]]></script>
				<goto next="./FIXE_INCIDENT_INC.vxml"/>                

            <elseif cond="wcb_digital_codeMotif == '02'"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "wcb_digital_codeMotif == '02'"); ]]></script>
                <script><![CDATA[
	                customNode(applicationName + '_' + '22000_WCB_TECH_TV');	
                ]]></script>
	            <script><![CDATA[				
					<!--POSITION_INCIDENT_HEIMDALL = liste ('position|balise|page_suivante|form suivant') -->				
					POSITION_INCIDENT_HEIMDALL = '3|22000_WCB_TECH_TV|FLASH_INC|;';
					log_debug_assignment(pageCourante, "POSITION_INCIDENT_HEIMDALL", POSITION_INCIDENT_HEIMDALL);						
				]]></script>            
	
				<!-- Position  flash -->          		
	            <script><![CDATA[
	                POSITION_ARBO = 47;				
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            
				<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_INCIDENT_INC.vxml"); ]]></script>
				<goto next="./FIXE_INCIDENT_INC.vxml"/>   

                <!--	motif=03 - cas par défaut  -->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
	                customNode(applicationName + '_' + '23000_WCB_TECH_AUTRE');
                ]]></script>
	            <script><![CDATA[				
					<!--POSITION_INCIDENT_HEIMDALL = liste ('position|balise|page_suivante|form suivant') -->				
					POSITION_INCIDENT_HEIMDALL = '4|23000_WCB_TECH_AUTRE|FLASH_INC|;';
					log_debug_assignment(pageCourante, "POSITION_INCIDENT_HEIMDALL", POSITION_INCIDENT_HEIMDALL);						
				]]></script>            
	
				<!-- Position  flash -->          		
	            <script><![CDATA[
	                POSITION_ARBO = 48;				
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            
				<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_INCIDENT_INC.vxml"); ]]></script>
				<goto next="./FIXE_INCIDENT_INC.vxml"/>

            </if>

        </block>
    </form>

    <form id="Wcb_Technique_GP_Transfert">
        <script><![CDATA[ formCourant = "Wcb_Technique_GP_Transfert"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!-- Client THD** ou  offre manuel THD-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientFixeFTTH()|| OFFRE_MANUELLE == 'THD' "); ]]></script>
            <if cond="isClientFixeFTTH() || OFFRE_MANUELLE == 'THD' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH() || OFFRE_MANUELLE == 'THD' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '24000_WCB_FTT_FTTH');
					ID_FLUX='WCB_FTT_FTTH';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>

                <!-- Client CABLE (FTTB)	ou offre manuelle CABLE-->
            <elseif cond="isClientFixeFTTB() || OFFRE_MANUELLE == 'CABLE' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTB() || OFFRE_MANUELLE == 'CABLE' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '24000_WCB_FTT_FTTB');
					ID_FLUX='WCB_FTT_FTTB';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '24000_WCB_FTT_AUTRE');
					ID_FLUX='WCB_FTT_AUTRE';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>

            </if>
        </block>
    </form>

    
    <!--#################################################################################################
         TECHNIQUE CARE: Traitement des appels en provenance de WCB avec motif technique
    ################################################################################################# -->

    <form id="Wcb_Technique_CARE">
        <script><![CDATA[ formCourant = "Wcb_Technique_CARE"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "wcb_digital_codeMotif == '01'"); ]]></script>
            <if cond="wcb_digital_codeMotif == '01'">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "wcb_digital_codeMotif == '01'"); ]]></script>
