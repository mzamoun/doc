    <!--#################################################################################################
         PREMIUM- TECH : Traitement des appels en provenance de WCB
    ################################################################################################# -->
    <form id="Wcb_TECH_Premium">
        <script><![CDATA[ formCourant = "Wcb_TECH_Premium"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block> 
        
            <!-- CABLE et PACKPRO					  //-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientFixeFTTB()  &amp;&amp; FIXE_PACKPRO == 'true' "); ]]></script>
            <if cond="isClientFixeFTTB()  &amp;&amp; FIXE_PACKPRO == 'true'  ">            
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTB()  &amp;&amp; FIXE_PACKPRO == 'true' "); ]]></script>      
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_WCB_FTT_PACKPRO_FTTB');
					ID_FLUX='WCB_FTT_PACKPRO_FTTB';					
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                

            <!-- FTTH et PACKPRO					  //-->
            <elseif cond="isClientFixeFTTH() &amp;&amp; FIXE_PACKPRO == 'true' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH() &amp;&amp; FIXE_PACKPRO == 'true' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_WCB_FTT_PACKPRO_FTTH');
					ID_FLUX='WCB_FTT_PACKPRO_FTTH';					
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>                
                                 
            <!-- AUTRE	et PACKPRO					  //-->
            <elseif cond="FIXE_PACKPRO == 'true' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " FIXE_PACKPRO == 'true' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_WCB_FTT_PACKPRO_AUTRE');
					ID_FLUX='WCB_FTT_PACKPRO_AUTRE';					
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>         
                                                                                               
            	<!--	FIDE et CABLE		--> 
            <elseif cond="FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' &amp;&amp; isClientFixeFTTB() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' &amp;&amp; isClientFixeFTTB() "); ]]></script>                
                <script><![CDATA[
					   customNode(applicationName + '_' + '10000_WCB_FTT_PREMIUM_FTTB_FIDE');
					   ID_FLUX='WCB_FTT_PREMIUM_FTTB_FIDE';		
					   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>

               <!--	FIDE et FTTH		-->
            <elseif cond="FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' &amp;&amp; isClientFixeFTTH() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' &amp;&amp; isClientFixeFTTH() "); ]]></script>
                <script><![CDATA[
					   customNode(applicationName + '_' + '10000_WCB_FTT_PREMIUM_FTTH_FIDE');
					   ID_FLUX='WCB_FTT_PREMIUM_FTTH_FIDE';		
					   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                
               <!--	FIDE - AUTRE		-->
            <elseif cond="FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' "); ]]></script>
                <script><![CDATA[
					   customNode(applicationName + '_' + '10000_WCB_FTT_PREMIUM_AUTRE_FIDE');
					   ID_FLUX='WCB_FTT_PREMIUM_AUTRE_FIDE';		
					   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script> 
                
                        
            	<!--FTTB -->
            <elseif cond="isClientFixeFTTB() "/>            
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isCABLE_FTTB()"); ]]></script>
                <script><![CDATA[
				   customNode(applicationName + '_' + '10000_WCB_FTT_PREMIUM_FTTB');
				   ID_FLUX='WCB_FTT_PREMIUM_FTTB';		
				   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>

                <!--FTTH -->
            <elseif cond="isClientFixeFTTH() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH() "); ]]></script>
                <script><![CDATA[
				   customNode(applicationName + '_' + '10000_WCB_FTT_PREMIUM_FTTH');
				   ID_FLUX='WCB_FTT_PREMIUM_FTTH';		
				   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>

				<!--AUTRE -->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_WCB_FTT_PREMIUM_AUTRE');
					ID_FLUX='WCB_FTT_PREMIUM_AUTRE';	
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>

            </if>
            
            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
            <goto next="#Transfert"/>            

        </block>
    </form>

    <!--#################################################################################################
         PREMIUM- FCT (AUTRE) : Traitement des appels en provenance de WCB
    ################################################################################################# -->
    <form id="Wcb_FCT_Premium">
        <script><![CDATA[ formCourant = "Wcb_FCT_Premium"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>                                                       
                
              <!--  PACKPRO					  //-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "FIXE_PACKPRO == 'true' "); ]]></script>
            <if cond="FIXE_PACKPRO == 'true' ">                        
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_PACKPRO == 'true' "); ]]></script>                
                <script><![CDATA[
					   customNode(applicationName + '_' + '43000_WCB_FCT_PACKPRO');
					   ID_FLUX='FIXE_WCB_FCT_PACKPRO';		
					   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script> 
                                
            <!--  FIDE					  //-->
            <elseif cond="FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' "); ]]></script>
                <script><![CDATA[
					   customNode(applicationName + '_' + '43000_WCB_FCT_PREMIUM_FIDE');
					   ID_FLUX='FIXE_WCB_FCT_PREMIUM_FIDE';		
					   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script> 
                                                              

                <!--Autre PREMIUM -->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '43000_WCB_FCT_PREMIUM_AUTRE');
					ID_FLUX='FIXE_WCB_FCT_PREMIUM';	
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
            </if>
            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
            <goto next="#Transfert"/>

        </block>
    </form>
    

    <!--#################################################################################################
         GP- SUSPENDU : Traitement des appels en provenance de WCB SUSPENDU
    ################################################################################################# -->
    <form id="WCB_SUSPENDU_CTRL_PREMIUM">
        <script><![CDATA[ formCourant = "WCB_SUSPENDU_CTRL_PREMIUM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!-- PREMIUM -->  
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() "); ]]></script>
            <if cond="CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() "); ]]></script>

	            <script><![CDATA[
					customNode(applicationName + '_' + '00072_WCB_SUSPENDU_PREMIUM_COM');
					POSITION_ARBO = 69;
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/>
                		
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
            
	            <script><![CDATA[
					customNode(applicationName + '_' + '00072_WCB_FCT_CONV_SUSP');
					POSITION_ARBO = 65;
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/>	
            </if> 
		            
        </block>
    </form>
    
   <form id="Wcb_SUSPENDU_PREMIUM">
