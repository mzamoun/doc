    <!-- ==================================== -->
    <!-- Gestion de Reinit MDP par EMAIL		 -->
    <!-- ==================================== -->

    <form id="VERS_CTRL_MAIL_SECOURS">
        <script><![CDATA[ formCourant = "VERS_CTRL_MAIL_SECOURS"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!-- Ctrl EMAIL_SECOURS -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "EMAIL_SECOURS  "); ]]></script>
            <if cond="EMAIL_SECOURS  ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "EMAIL_SECOURS  "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '12040_MAIL_SECOURS');
					errorCounter = 1;
					errorCounter1 = 1;
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "MENU_REINIT_MAIL_SECOURS"); ]]></script>
                <goto next="#MENU_REINIT_MAIL_SECOURS"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_CTRL_MAIL_CONTACT"); ]]></script>
                <goto next="#VERS_CTRL_MAIL_CONTACT"/>

            </if>
        </block>
    </form>

    <!-- ==================================== -->
    <!-- Menu REINIT MAIL SECOURS 				 -->
    <!-- ==================================== -->

    <menu id="MENU_REINIT_MAIL_SECOURS">
        <script><![CDATA[ formCourant = "MENU_REINIT_MAIL_SECOURS"; ]]></script>
        <script><![CDATA[ menuCourant = formCourant; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <property name="timeout" value="3s"/>
        <property name="termchar" value="A"/>
        <prompt bargein="true">
            <audio expr="PlayFile('REINIT_MAIL_SECOURS')">
                <!--
                      Un e-mail va vous être envoyé à l’adresse commençant par :
                -->
            </audio>
            <audio expr="sayasLettreWav(EMAIL_SECOURS.substring(0,1))">
                <!--
                    <value expr="EMAIL_SECOURS.substring(0,1)"/>
                -->
            </audio>
            <break time="0.4s"/>
            <audio expr="sayasLettreWav(EMAIL_SECOURS.substring(1,2))">
                <!--
                    <value expr="EMAIL_SECOURS.substring(1,2)"/>
                -->
            </audio>

            <break time="0.4s"/>
            <audio expr="PlayFile('REINIT_MAIL_TERMINANT')"/>
            <break time="0.4s"/>
            <audio expr="PlayFile('AROBASE')"/>
            <break time="0.4s"/>
            
        </prompt>
        
        <prompt cond="isWavDomaineExist(Extract_Domaine(EMAIL_SECOURS)) " bargein="true">
            <audio expr="sayasDomaineWav(Extract_Domaine(EMAIL_SECOURS))">
            </audio>
        </prompt>

        <prompt cond="!isWavDomaineExist(Extract_Domaine(EMAIL_SECOURS)) " bargein="true">
            <value expr="Extract_Domaine(EMAIL_SECOURS)"/>
        </prompt>        

        <prompt bargein="true">
            <break time="0.4s"/>        
            <audio expr="PlayFile('REINIT_MAIL_SECOURS_SUITE')">
                <!--
                    Est-ce bien votre adresse e-mail? Si oui, tapez 1 Si non, tapez 2
                -->
            </audio>
        </prompt>

        <catch event="noinput nomatch" cond="document.errorCounter &lt; 2">
            <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "noinput_nomatch"); ]]></script>
            <script><![CDATA[ track_dtmfList (formCourant,"NMNI"); ]]></script>
            <assign name="document.errorCounter" expr="document.errorCounter + 1"/>
            <script><![CDATA[ log_debug_assignment(pageCourante,"document.errorCounter", document.errorCounter); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '12040_NMNI_SECOURS');
            ]]></script>

            <prompt bargein="true">
                <audio expr="PlayGenericAudio('ERREUR_SAISIE_NOUVEAU')">
                    <!--
                        Désolé, nous n’avons pas compris votre choix, de nouveau
                    -->
                </audio>
            </prompt>
            <reprompt/>
        </catch>

        <catch event="noinput nomatch" cond="document.errorCounter == 2">
            <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "noinput_nomatch"); ]]></script>
            <script><![CDATA[ track_dtmfList (formCourant,"NMNI2"); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '12040_NMNI_SECOURS_X2');
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_REINIT_MDP_ROUTAGE.vxml"); ]]></script>
            <goto next="./FIXE_REINIT_MDP_ROUTAGE.vxml"/>
        </catch>

        <choice dtmf="1" next="#REINIT_MAIL_SECOURS_CHOIX1"/>
        <choice dtmf="2" next="#REINIT_MAIL_SECOURS_CHOIX2"/>
    </menu>

    <form id="REINIT_MAIL_SECOURS_CHOIX1">
        <script><![CDATA[ formCourant = "REINIT_MAIL_SECOURS_CHOIX1"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "1"); ]]></script>
        <script><![CDATA[ track_dtmfList ("MENU_REINIT_MAIL_SECOURS", "1"); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '12041_CHOIX_MAIL_SECOURS');
				EMAIL_CONTACT = EMAIL_SECOURS ;
            ]]></script>
            <script><![CDATA[ log_debug_assignment(pageCourante,'EMAIL_CONTACT', EMAIL_CONTACT); ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_REINIT_MDP_MAIL.vxml"); ]]></script>
            <goto next="./FIXE_REINIT_MDP_MAIL.vxml"/>

        </block>
    </form>

    <form id="REINIT_MAIL_SECOURS_CHOIX2">
        <script><![CDATA[ formCourant = "REINIT_MAIL_SECOURS_CHOIX2"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "2"); ]]></script>
        <script><![CDATA[ track_dtmfList ("MENU_REINIT_MAIL_SECOURS", "2"); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '12042_AUTRE_SECOURS');
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_CTRL_MAIL_CONTACT"); ]]></script>
            <goto next="#VERS_CTRL_MAIL_CONTACT"/>

        </block>
    </form>

    <form id="VERS_CTRL_MAIL_CONTACT">
        <script><![CDATA[ formCourant = "VERS_CTRL_MAIL_CONTACT"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <!-- Ctrl EMAIL_CONTACT_FIXE -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "EMAIL_CONTACT_FIXE   &amp;&amp; EMAIL_CONTACT_FIXE != EMAIL_SECOURS "); ]]></script>
            <if cond="EMAIL_CONTACT_FIXE   &amp;&amp; EMAIL_CONTACT_FIXE != EMAIL_SECOURS ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "EMAIL_CONTACT_FIXE   &amp;&amp; EMAIL_CONTACT_FIXE != EMAIL_SECOURS "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '12050_MAIL_CONTACT');
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "MENU_REINIT_MAIL_CONTACT"); ]]></script>
                <goto next="#MENU_REINIT_MAIL_CONTACT"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_REINIT_MDP_ROUTAGE.vxml"); ]]></script>
                <goto next="./FIXE_REINIT_MDP_ROUTAGE.vxml"/>

            </if>

        </block>
    </form>

    <!-- ==================================== -->
    <!-- Menu REINIT MAIL CONTACT				 -->
    <!-- ==================================== -->

    <menu id="MENU_REINIT_MAIL_CONTACT">
        <script><![CDATA[ formCourant = "MENU_REINIT_MAIL_CONTACT"; ]]></script>
