            <audio expr="sayasLettreWav(EMAIL_CONTACT_FIXE.substring(0,1))">
                <!--
                    <value expr="EMAIL_CONTACT_FIXE.substring(0,1)"/>
                -->
            </audio>
            <break time="0.4s"/>
            <audio expr="sayasLettreWav(EMAIL_CONTACT_FIXE.substring(1,2))">
                <!--
                    <value expr="EMAIL_CONTACT_FIXE.substring(1,2)"/>
                -->
            </audio>

            <break time="0.4s"/>
            <audio expr="PlayFile('REINIT_MAIL_TERMINANT')"/>
            <break time="0.4s"/>
            <audio expr="PlayFile('AROBASE')"/>
