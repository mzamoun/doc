            <script><![CDATA[ track_dtmfList (formCourant,"NMNI2"); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '12050_NMNI_CONTACT_X2');
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_REINIT_MDP_ROUTAGE.vxml"); ]]></script>
