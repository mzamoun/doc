        <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "2"); ]]></script>
        <script><![CDATA[ track_dtmfList ("MENU_REINIT_SMS_CONTACT", "2"); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '12032_AUTRE_CONTACT');
            ]]></script>
