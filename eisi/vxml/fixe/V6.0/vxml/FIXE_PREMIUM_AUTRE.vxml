                            IMA/CZO	19/06/2020			Integration du traitement BEB_FIXE_FASTR_COM  
                            IMA/CZO	10/03/2021		    Ajout des choix FLASH,choix FLASH2 et choix FLASH3  + menage FIXE_CHOIX_FLASH_PREMIUM et choid * retard
                            IMA/CZO	07/01/2022			Integration des traitements PACKPRO	     
                            IMA/CZO	14/01/2022			Suppression du traitement BEB_COM 
                            IMA/CZO	02/03/2022			Menage traitement RDGU    
        
    -->
    <script><![CDATA[
		applicationName = "FIXE"; appSvi = applicationName;
		var pageCourante = "FIXE_PREMIUM_AUTRE.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
    ]]></script>

    <var name="errorCounter" expr="1"/>
    <var name="errorCounter1" expr="1"/>


    <!--###########################################
         Choix 4: PREMIUM AUTRE
    ########################################### -->      

    <!--###########################################
                CTRL CHOIX FLASH FCT
        ########################################### -->
    <form id="CTRL_CHOIX_FLASH_FCT_PREMIUM">
        <script><![CDATA[ formCourant = "CTRL_CHOIX_FLASH_FCT_PREMIUM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>

            <!--	Filtre CHOIX_FLASH activé -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.CHOIX_FLASH_FCT_PREMIUM != 'false' "); ]]></script>
            <if cond="CUSTOMER_IHM.CHOIX_FLASH_FCT_PREMIUM != 'false' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.CHOIX_FLASH_FCT_PREMIUM != 'false' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '40001_CHOIX_FLASH_FCT_PREM');
					POSITION_ARBO = 98;
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
                <goto next="./FIXE_FLASH_INC.vxml"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "CTRL_CHOIX_FLASH2_FCT_PREMIUM"); ]]></script>
                <goto next="#CTRL_CHOIX_FLASH2_FCT_PREMIUM"/>

            </if>

        </block>
    </form>
    
