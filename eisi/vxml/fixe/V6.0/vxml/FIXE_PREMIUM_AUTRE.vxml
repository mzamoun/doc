    <!--###########################################
             SUITE  Menu PREMIUM AUTRE
        ########################################### -->

    <form id="SUITE_PREMIUM_AUTRE">
        <script><![CDATA[ formCourant = "SUITE_PREMIUM_AUTRE"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_next_form(pageCourante, "PREMIUM_SOUS_MENU"); ]]></script>
            <goto next="#PREMIUM_SOUS_MENU"/>             

        </block>
    </form>    

    <menu id="PREMIUM_SOUS_MENU">
        <script><![CDATA[ formCourant = "PREMIUM_SOUS_MENU"; ]]></script>
        <script><![CDATA[ menuCourant = formCourant; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <property name="timeout" value="3s"/>
        <prompt bargein="true">
            <audio maxage="7200" maxstale="7200" expr="PlayFileCommun(CUSTOMER_IHM.FIXE_PREMIUM_SOUS_MENU_PREMIUM_SOUS_MENU_AUDIO)"/>
        </prompt>

        <catch event="noinput nomatch" cond="document.errorCounter &lt; 2">
            <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "noinput_nomatch"); ]]></script>
            <script><![CDATA[ track_dtmfList (formCourant,"NMNI"); ]]></script>
            <assign name="document.errorCounter" expr="document.errorCounter + 1"/>
            <script><![CDATA[ log_debug_assignment(pageCourante,"document.errorCounter", document.errorCounter); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '49001_PREMIUM_NMNI');				
            ]]></script>
            <prompt>
                <audio expr="PlayGenericAudio('ERREUR_SAISIE_NOUVEAU')"/>
            </prompt>
            <reprompt/>
        </catch>
        <catch event="noinput nomatch" cond="document.errorCounter == 2">
            <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "noinput_nomatch"); ]]></script>
            <script><![CDATA[ track_dtmfList (formCourant,"NMNI2"); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '49002_PREMIUM_NMNI_X2');				
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "PREMIUM_ADM_Autre"); ]]></script>
            <goto next="#PREMIUM_ADM_Autre"/>
        </catch>

        <choice dtmf="1" next="#VersPREMIUM_Facture"/>
        <choice dtmf="2" next="#VersPREMIUM_Resiliation"/>
        <choice dtmf="3" next="#VersPREMIUM_ADM_Autre"/>
    </menu>

