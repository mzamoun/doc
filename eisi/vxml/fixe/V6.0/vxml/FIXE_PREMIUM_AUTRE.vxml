    <!--###########################################
         TRAITEMENT BEB_FIXE_FASTER_COM
    ########################################### -->    
    <form id="CTRL_BEB_FIXE_FASTR_COM">
        <script><![CDATA[ formCourant = "CTRL_BEB_FIXE_FASTR_COM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!--ELIGIBILITE BEB_FIXE_FASTR_COM -->
            
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.BEB_FIXE_FASTR_COM != 'false' &amp;&amp; isBEB_FIXE_FASTR_COM()  "); ]]></script>
            <if cond="CUSTOMER_IHM.BEB_FIXE_FASTR_COM != 'false' &amp;&amp; isBEB_FIXE_FASTR_COM()">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.BEB_FIXE_FASTR_COM != 'false' &amp;&amp; isBEB_FIXE_FASTR_COM() "); ]]></script>               	
	            <script><![CDATA[
		            customNode(applicationName + '_' + '43000_BEB_COM_PREMIUM_FASTR_OK');			            
	            ]]></script>
	            
                <!--CTRL HO HNO de l'activité FASTR-->
                <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN &amp;&amp; CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN =='true' "); ]]></script>
	            <if cond="CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN &amp;&amp; CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN =='true' ">
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN &amp;&amp; CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN =='true'"); ]]></script>
	                <!--precision de l'origine de l'appel pour aiguillage sur le parcours BEB_FIXE -->
	                <script><![CDATA[
			            BEB_FIXE_FASTR_ORIGINE ='FIXE_PREMIUM_BEB_FIXE_FASTR_COM';
			            customNode(applicationName + '_' + '43000_PREMIUM_BEB_COM_HO');
						POSITION_ARBO = 70;	
						log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);											
               		 ]]></script>
	               	 <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	              	 <goto next="./FIXE_FLASH_INC.vxml"/>                		 
	                               		 	
	            <else/>
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
		            <script><![CDATA[
						customNode(applicationName + '_' + '43000_PREMIUM_BEB_COM_HNO');						
		            ]]></script>                
		            <script><![CDATA[ log_debug_next_form(pageCourante, "BEB_FIXE_FASTR_COM_KO"); ]]></script>
		            <goto next="#BEB_FIXE_FASTR_COM_KO"/> 
	
	            </if> 
	             	            	                                                                    
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '43000_BEB_COM_PREMIUM_FASTR_NOK');					
	            ]]></script>                
	            <script><![CDATA[ log_debug_next_form(pageCourante, "BEB_FIXE_FASTR_COM_KO"); ]]></script>
	            <goto next="#BEB_FIXE_FASTR_COM_KO"/>       

            </if>

        </block>
    </form> 
    
    <form id="BEB_FIXE_FASTR_COM_KO">
        <script><![CDATA[ formCourant = "BEB_FIXE_FASTR_COM_KO"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				POSITION_ARBO = 71;	
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);	;						
            ]]></script>                
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>             

