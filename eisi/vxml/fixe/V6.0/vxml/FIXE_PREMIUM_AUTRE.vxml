<!--###########################################
         SUITE traitement PREMIUM AUTRE
    ########################################### -->    

    <form id="VersTransfert_ADM_AUTRE">
        <script><![CDATA[ formCourant = "VersTransfert_ADM_AUTRE"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>

            <!--	Client en provenance de WCB_DIGITAL		-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital == 'FIXE' "); ]]></script>
            <if cond="CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital == 'FIXE' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital == 'FIXE' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '43000_WCB_FCT_PREMIUM_OK');
					POSITION_ARBO = 29;		
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);		
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
                <goto next="./FIXE_FLASH_INC.vxml"/>

                <!--	client non WCB		-->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                
	            <script><![CDATA[
					customNode(applicationName + '_' + '43000_WCB_FCT_PREMIUM_NOK');
					POSITION_ARBO = 13;					
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/> 
	                           
            </if>
                        
        </block>
    </form>
    
        
    <form id="transfert_ADM_AUTRE">
        <script><![CDATA[ formCourant = "transfert_ADM_AUTRE"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>

            <!--	filtre type client		-->             
            <!--  PACKPRO					  //-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "FIXE_PACKPRO == 'true'"); ]]></script>
            <if cond="FIXE_PACKPRO == 'true'">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_PACKPRO == 'true'"); ]]></script>                                
                <script><![CDATA[
					customNode(applicationName + '_' + '43000_FCT_PACKPRO');
					ID_FLUX='FIXE_FCT_PACKPRO';					
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>

               <!--	FIDE 	-->
            <elseif cond="FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' "); ]]></script>
                <script><![CDATA[
					   customNode(applicationName + '_' + '43000_FCT_PREMIUM_FIDE');
					   ID_FLUX='FIXE_FCT_PREMIUM_FIDE';		
					   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>                

                <!--Autre PREMIUM -->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '43000_FCT_PREMIUM_AUTRE');
					ID_FLUX='FIXE_FCT_PREMIUM';	
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
            </if>
            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
            <goto next="#Transfert"/>
        </block>
    </form>
      


    <!--###########################################
         Transfert: vers la page transfert
    ########################################### -->
    <form id="Transfert">
        <script><![CDATA[ formCourant = "Transfert"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_TRANSFERT.vxml"); ]]></script>
            <goto next="./FIXE_TRANSFERT.vxml"/>
        </block>
    </form>

    
    
    <!--###########################################
         ENTREE WCB_DIGITAL -  PREMIUM - ADMIN
    ########################################### -->
    <!--	ENTREE  à partir de la page WCB_DIGITAL -->
    <form id="ENTREE_WCB_DIGITAL_PREMIUM_AUTRE">
