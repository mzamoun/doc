            </if>  
                        
        </block>
    </form>    

    <form id="transfert_RESIL">
        <script><![CDATA[ formCourant = "transfert_RESIL"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!--COLLAB et COLLAB_LPM (DEXTER) -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "is_collab_dexter() || is_collab_lpm_dexter() "); ]]></script>
            <if cond=" is_collab_dexter() || is_collab_lpm_dexter() ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "is_collab_dexter() || is_collab_lpm_dexter() "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '43000_RET_COLLAB');
					ID_FLUX='FIXE_FCT_PREMIUM';		
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>

                <!--Autre PREMIUM -->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '43000_RET_PREMIUM_AUTRE');
					ID_FLUX='FIXE_RET_PREMIUM';	
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
            </if>
            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
            <goto next="#Transfert"/>
        </block>
    </form>

