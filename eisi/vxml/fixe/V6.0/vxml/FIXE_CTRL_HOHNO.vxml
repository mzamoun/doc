	            <goto next="#CtrlHoHno"/> 

            </if>
        </block>
    </form>
    
    <!--#####################################################################################################
        Recuperation config INCIDENTS HEIMDALL
        ##################################################################################################### -->
    
    <form id="GET_INCIDENT_HEMDALL">
        <script><![CDATA[ formCourant = "GET_INCIDENT_HEMDALL"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[
			var ndi = NDI;
        ]]></script>
        <script><![CDATA[ log_debug_appel_web_app(pageCourante, 'BDD_INCIDENTS', subdialogIncidentsHeimdall , 'ndi='+NDI ); ]]></script>
        <subdialog name="BDD_INCIDENTS"
                   srcexpr="subdialogIncidentsHeimdall"
                   namelist="ndi"
                   method="post"
                   fetchtimeout="3s"
                   fetchaudio="../../../audio/Attente.wav">
            <catch event="error"> <!-- webapp KO -->
                <script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '80000_HEIMDALL_HS');
					customNode(applicationName + '_' + '00001_HEIMDALL_HS');
					LIST_INCIDENT_HEIMDALL =';;;;;';
                ]]></script>
                <script><![CDATA[ log_debug_assignment(pageCourante,"LIST_INCIDENT_HEIMDALL", LIST_INCIDENT_HEIMDALL); ]]></script>                
                <script><![CDATA[ log_debug_next_form(pageCourante, "CtrlIncidentHemdallIncident"); ]]></script>
                <goto next="#CtrlIncidentHemdallIncident"/>
            </catch>
        </subdialog>

        <block>
            <script><![CDATA[ log_debug_result_web_app(pageCourante, 'BDD_INCIDENTS', BDD_INCIDENTS); ]]></script>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "BDD_INCIDENTS.APP_STATUS == 'NOK' || BDD_INCIDENTS.WS_STATUS == 'NOK'"); ]]></script>
            <if cond="BDD_INCIDENTS.APP_STATUS == 'NOK' || BDD_INCIDENTS.WS_STATUS == 'NOK' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "BDD_INCIDENTS.APP_STATUS == 'NOK' || BDD_INCIDENTS.WS_STATUS == 'NOK'"); ]]></script>
                <script><![CDATA[ log_appel_web_app_nok(pageCourante, 'BDD_INCIDENTS', subdialogIncidentsHeimdall , 'ndi='+NDI ); ]]></script>
	            <script> <![CDATA[
		   			CUSTOMER_INCIDENTS = {};
		   			LIST_INCIDENT_HEIMDALL =';;;;;';
	            ]]></script>
                <script><![CDATA[ log_debug_assignment(pageCourante,"LIST_INCIDENT_HEIMDALL", LIST_INCIDENT_HEIMDALL); ]]></script>
                
                <script><![CDATA[ log_debug_next_form(pageCourante, "CtrlIncidentHemdallIncident"); ]]></script>
                <goto next="#CtrlIncidentHemdallIncident"/>               

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <assign name="CUSTOMER_INCIDENTS" expr="BDD_INCIDENTS"/>
                <assign name="LIST_INCIDENT_HEIMDALL" expr="BDD_INCIDENTS.INCIDENTS_HEIMDALL"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"CUSTOMER_INCIDENTS", BDD_INCIDENTS); ]]></script>              
                <script><![CDATA[ log_debug_assignment(pageCourante,"LIST_INCIDENT_HEIMDALL", LIST_INCIDENT_HEIMDALL); ]]></script> 
                            
                <script><![CDATA[ log_debug_next_form(pageCourante, "CtrlIncidentHemdallIncident"); ]]></script>
                <goto next="#CtrlIncidentHemdallIncident"/>                 
            </if>
                      
        </block>
    </form>  
    
    <!-- ================================================= //-->
    <!-- MODE bouchon				       //-->
    <!-- ================================================= //-->     
    <form id="GET_INCIDENT_HEMDALL_BOUCHON">
        <script><![CDATA[ formCourant = "GET_INCIDENT_HEMDALL_BOUCHON"; ]]></script>
  
        <block>
			<script><![CDATA[	
				<!--bouchon  -->				
				<!-- LIST_INCIDENT_HEIMDALL = 'E01|Filtrante|202003201200|11111;E02|Filtrante||22222;E03|Filtrante||33333;E04|Filtrante||44444;E05|Filtrante||55555;E01|Filtrante||66666;';  -->
				<!-- LIST_INCIDENT_HEIMDALL = 'E02|Filtrante||22222;E03|Coupante||33333;E04|Filtrante||44444;E05|Filtrante||55555;E01|Filtrante||66666;'; -->
				LIST_INCIDENT_HEIMDALL = 'E01|Filtrante|202003201200|11111;E02|Filtrante||22222;E03|Filtrante||33333;E04|Filtrante||44444;E05|Filtrante||55555;E01|Filtrante||66666;';
				log_debug_assignment(pageCourante, "LIST_INCIDENT_HEIMDALL", LIST_INCIDENT_HEIMDALL);						
			]]></script>                       
			            
            <script><![CDATA[ log_debug_next_form(pageCourante, "CtrlIncidentHemdallIncident"); ]]></script>
            <goto next="#CtrlIncidentHemdallIncident"/>  
                      
        </block>
    </form>
    
    <!--################################################################
        Traitement incident en fonctio##############n des données incident_hemdall
        ########################################### -->

    <form id="CtrlIncidentHemdallIncident">
        <script><![CDATA[ formCourant = "CtrlIncidentHemdallIncident"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <script><![CDATA[
			   	var items_inc_hemdall = LIST_INCIDENT_HEIMDALL.split(";");
				var length_inc_hemdall = items_inc_hemdall.length;
				
			   	var items_incident = LIST_INCIDENT.split(";");
				var length_incident = items_incident.length;
				
				var LIST_INCIDENT_TMP ='';								
					
			    if (LIST_INCIDENT_HEIMDALL !=';;;;;' && 0 < length_inc_hemdall  ){	    
				    for(var i = 0; i < length_inc_hemdall ; i++) {
				        if (items_inc_hemdall[i] !='')
				        {	
					        <!--	mettre à vide la position incident si la position équivalente incident_hemdall est rempli -->
				       		if (i == 1)
					        {
								LIST_INCIDENT_TMP = LIST_INCIDENT_TMP +';';  
								LIST_INCIDENT_TMP = LIST_INCIDENT_TMP +';';   
					        }				        
					        else{
						       LIST_INCIDENT_TMP = LIST_INCIDENT_TMP +';';
					        }				        
					        
				        }
				        else{
					        <!--	garder le contenu de la position incident si la position équivalente incident_hemdall est vide -->
				       		if (i == 0)
					        {
						       LIST_INCIDENT_TMP = LIST_INCIDENT_TMP + items_incident[0];  
					        }
							else if (i == 1)
							{
								LIST_INCIDENT_TMP = LIST_INCIDENT_TMP + items_incident[1] +';';  
								LIST_INCIDENT_TMP = LIST_INCIDENT_TMP + items_incident[2] +';'; 
							}				        
					        else{
						       LIST_INCIDENT_TMP = LIST_INCIDENT_TMP + items_incident[i+1] +';'; 
					        }				        
					        
				        }
				        	
					}
			    	LIST_INCIDENT = LIST_INCIDENT_TMP ;		
			    	log_debug_assignment(pageCourante, "LIST_INCIDENT_HEIMDALL", LIST_INCIDENT_HEIMDALL);							    
			    }
		    
		    	log_debug_assignment(pageCourante, "LIST_INCIDENT_RETENU=======", LIST_INCIDENT);					
            ]]></script>
            
            <script><![CDATA[ log_debug_next_form(pageCourante, "CtrlHoHno"); ]]></script>
            <goto next="#CtrlHoHno"/>  

        </block>
    </form>          
    
        
    <!--###########################################
        Ctrl HOHNO de l'application FIXE
        ########################################### -->

    <form id="CtrlHoHno">
        <script><![CDATA[ formCourant = "CtrlHoHno"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[
			appSvi='FIXE';
        ]]></script>
        <block>
            <script><![CDATA[
				GoToAfterHo = '../../../fixe/'+ Version_FIXE + 'vxml/' + pageCourante + '#HO';
				GoToAfterHno = '../../../fixe/'+ Version_FIXE + 'vxml/' + pageCourante + '#HNO';
				BaliseHo = '';
				BaliseHno ='00001_HNO';
				FlagMsgAfterHno ='true';
				MsgGeneriqueAfterHno ='';  // par defaut SFR_Quit
				var nextSousApp ='../../../ctrl_ho_hno/'+ Version_CTRL_HO_HNO + 'vxml/CTRL_HO_HNO_STD.vxml';
				log_debug_hohno_main (nextSousApp);
            ]]></script>

            <!-- Appel à la sous application CTRL_HO_HNO-->
            <script><![CDATA[ log_debug_next_page(pageCourante, nextSousApp); ]]></script>
            <goto expr="nextSousApp"/>

        </block>
    </form>

    <!--###########################################
        Traitement HO
        ########################################### -->

   <!-- ################################################################
    		point d'entree HO
    	################################################################## -->
    <form id="HO">
		<script><![CDATA[ formCourant = "HO"; ]]></script>
		<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ customNode(applicationName + '_' + '00001_SUSPICION_FIXE'); ]]></script>
            <script><![CDATA[ customNode(applicationName + '_' + '00001_HO_GP'); ]]></script>        	    
	        <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_RESILIE"); ]]></script>
	        <goto next="#Filtre_RESILIE"/>          
        
        </block>        

    </form> 
    
    <!--#####################################################################################################
        RESILIE
        ##################################################################################################### -->
    <form id="Filtre_RESILIE">
    	<script><![CDATA[ formCourant = "Filtre_RESILIE"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
           
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.RESILIE == 'false'"); ]]></script>	
            <if cond="CUSTOMER_IHM.RESILIE == 'false'">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.RESILIE == 'false'"); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '00002_RESILIE_OFF');
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "HO_GP"); ]]></script>
                <goto next="#HO_GP"/>               

             <!--	 filtre RESILIE ACTIVE et (STATUT OFFRE DEXTER RESILIE (statut , statut_action , code_action  ), ou Client identifie sur DEXTER avec aucune offres)	-->
            <elseif cond="isClientResilieFixe() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientResilieFixe()"); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00002_RESILIE_OK');
					POSITION_ARBO = 55;
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
                ]]></script>
  	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/>
			    	            
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '00002_RESILIE_NOK');
                ]]></script>            	
                <script><![CDATA[ log_debug_next_form(pageCourante, "HO_GP"); ]]></script>
                <goto next="#HO_GP"/>

            </if>
        </block>
    </form>     
    
            

     <!--###########################################
        HO GP
        ########################################### -->
    <form id="HO_GP">
        <script><![CDATA[ formCourant = "HO_GP"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				POSITION_ARBO = 0;			
				customNode(applicationName + '_' + '00002_FIXE_ENTREE');
				if ( isClientFixeFTTH()  || OFFRE_MANUELLE == 'THD'){
					customNode(applicationName + '_' + '19998_OFFRE_FTTH');
				}
				else if (isClientFixeFTTB() || OFFRE_MANUELLE == 'CABLE' ) {
					customNode(applicationName + '_' + '19998_OFFRE_FTTB');		
   		        }
   		        else {
					customNode(applicationName + '_' + '19998_OFFRE_ADSL');
             	} 				
            ]]></script>
            
             <!-- Vers gestion incident HEIMDALL FIXE_INCIDENT -->
            <script><![CDATA[				
				<!--POSITION_INCIDENT_HEIMDALL = liste ('position|balise|page_suivante|form suivant') -->				
				POSITION_INCIDENT_HEIMDALL = '0|00002_FIXE_ENTREE|CTRL_HOHNO|#SUITE_HO_GP;';
				log_debug_assignment(pageCourante, "POSITION_INCIDENT_HEIMDALL", POSITION_INCIDENT_HEIMDALL);						
			]]></script>            
			<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_INCIDENT_INC.vxml"); ]]></script>
			<goto next="./FIXE_INCIDENT_INC.vxml"/>
			
        </block>
    </form>
    
    <form id="SUITE_HO_GP">
        <script><![CDATA[ formCourant = "SUITE_HO_GP"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				POSITION_ARBO = 0;
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
            ]]></script>
            
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>
        </block>
    </form>    
    
  

    <!--###########################################
        Traitement HNO GP et PRO
        ########################################### -->
    <form id="HNO">
        <script><![CDATA[ formCourant = "HNO"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>        
            <script><![CDATA[		             	                
				
				<!--POSITION_INCIDENT_HEIMDALL = liste ('position|balise|page_suivante|form suivant') -->				
				POSITION_INCIDENT_HEIMDALL = '0|00001_HNO|INCIDENT_INC|;1|00001_HNO|INCIDENT_INC|;2|00001_HNO|INCIDENT_INC|;3|00001_HNO|INCIDENT_INC|;4|00001_HNO|FLASH_INC|;';
				log_debug_assignment(pageCourante, "POSITION_INCIDENT_HEIMDALL", POSITION_INCIDENT_HEIMDALL);

				<!--POSITION FLASH -->	
				POSITION_ARBO = 40;						
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);									
			]]></script>            
			<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_INCIDENT_INC.vxml"); ]]></script>
			<goto next="./FIXE_INCIDENT_INC.vxml"/>

        </block>
    </form>

</vxml>
