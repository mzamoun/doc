<?xml version="1.0" encoding="ISO-8859-1"?>
<vxml version="2.1" xmlns="http://www.w3.org/2001/vxml" application="../../../root.vxml" xml:lang="fr-FR">

    <!--
        Auteur :			IMA
        Page :				Application FIXE - HOHNO
        Date de Creation :	15/02/2012
        Modification :		IMA		02/04/2012		Gestion HO/HNO des clients PRO
                            IMA		07/03/2013		Refonte du parcours FIXE
                            IMA		08/10/2013		Suppression du CTRL HOHNO spécifique pro
                            IMA		30/06/2014		Suppression du traitement HNO soecifique pour les clients PRO
                            IMA		14/11/2014		Suppression du traitement BV
                            IMA		10/01/2015		Ajout du filtre controle NDI FT commençant par 9
                            IMA		05/03/2015		Ajout du filtre provenance FTTLA_RED et offre CABLE_RED
                            IMA		25/11/2015		Ajout des balises ODIN 19998_OFFRE *
                            IMA		02/12/2015		MAJ du filtre RED
                            IMA		10/02/2016		Ajout du filtre COLLAB et suppression du filtre controle NDI FT
                            IMA/CZO	13/12/2016		Refonte traitements PRO: MAJ des traitements premium (ancien PRO, JOYA et collab)
                            IMA/CZO	17/02/2017		MAJ traitements PREMIUM: MAJ des traitements premium + suppreesion PRO PROBABLE
                            IMA/CZO	14/04/2017		Prise en compte des traitements WCB_DIGITAL
                            IMA/CZO	19/04/2017		Ajout traitement des appels en provenance de RDGU + balise de suspicion FIXE
                            IMA/CZO 10/10/2017      Suppression des traitements AUTO_REPAIR
                            MRO		15/03/2018		migration v8
							IMA/CZO 05/05/2018		Prise en compte des données LDCCSU	
							IMA/CZO	05/07/2018		Menage des traitements SAFIR - full LDCCSU	 
							EISI	09/11/2018		MAJ du traitement PREMIUM - Ajout du traitement du marker CELL_PREM						
							EISI	22/11/2018		Ajout de l'appel au WS MC_TECH	
							EISI	28/02/2019		MAJ filtre RED	
							IMA/CZO	25/03/2019		MAJ traitement PREMIUM - PACKPRO	
							IMA/CZO	05/02/2020		reorganisation de l'ordre des filtres + ajout des donnees DEXTER dans le filtre RED_DEXTER
							IMA/CZO	19/06/2020		Integration du traitement BEB_FIXE_FASTR
							IMA/CZO	25/08/2020		Suppression de l'interrogation DEXTER sur parcours FIXE
							IMA/CZO	21/06/2021		Ajout des parametres optionnels d'appels à la web APP FLASH
							IMA/CZO	22/12/2021		Intégration du traitement CARE - appel au WS C2OL
							IMA/CZO	12/01/2022		Ajout parametre techno pour l'appel beb_fixe_fastr
							IMA/CZO 24/01/2024		Integration de l'identification SEARCH
							IMA/CZO 23/07/2024		Ajout parametre ndi pour l'appel beb_fixe_fastr
							IMA/CZO 27/09/2024		MAJ traitements RED_FIXE et RESILIE (nouvelles definitions DEXTER + suppression definition search resilie))
    -->
    <script><![CDATA[
		applicationName = "FIXE"; appSvi = applicationName;
		var pageCourante = "FIXE_CTRL_HOHNO.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
    ]]></script>

    <script><![CDATA[
        ndi = NDI;
		POSITION_ARBO = 0;			        
    ]]></script>

    <!--###########################################
        Chargement de la config IHM: Activation Filtres
        ########################################### -->
    <form id="main">
        <script><![CDATA[ formCourant = "main"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <catch event="error">
            <script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
            <script> <![CDATA[
	   			CUSTOMER_IHM = {};
				customNode(applicationName + '_' + '80001_IHM_FILTRE_HS');
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "preparFlash"); ]]></script>
            <goto next="#preparFlash"/>
        </catch>

        <subdialog name="FIXE_SUBDIALOG_IHM" srcexpr="srcModuleFiltreIhm" method="post" fetchtimeout="10s"
                   fetchaudio="../../../audio/Attente.wav">
            <param name="in_appSvi" expr="appSvi"/>
            <filled>
                <script><![CDATA[
					CUSTOMER_IHM = FIXE_SUBDIALOG_IHM.CUSTOMER_IHM;
					customNodeAfterModule (FIXE_SUBDIALOG_IHM.STAT_MODULE);
                ]]></script>

                <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.status == 'HS'"); ]]></script>
                <if cond="CUSTOMER_IHM.status == 'HS'">
                    <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.status == 'HS'"); ]]></script>
                    <script><![CDATA[customNode(applicationName + '_' + '80001_IHM_FILTRE_HS'); ]]></script>
                    <script><![CDATA[ log_debug_next_form(pageCourante, "preparFlash"); ]]></script>
                    <goto next="#preparFlash"/>

                <else/>
                    <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                    <script><![CDATA[ log_debug_next_form(pageCourante, "preparFlash"); ]]></script>
                    <goto next="#preparFlash"/>
                </if>
            </filled>
        </subdialog>
    </form>

    <!--###########################################
        Chargement des messages FLASH
        ########################################### -->
    <form id="preparFlash">
        <script><![CDATA[ formCourant = "preparFlash"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
		<script><![CDATA[			
			//Recuperation des parametres optionnels de l'appel FLASH
			getParamOptionnelFlash();
			
		]]></script>
        <script><![CDATA[ log_debug_appel_module(pageCourante, 'sub_init_flash', srcModuleInitFlash , 'in_appSvi='+appSvi+'|in_ndi=' + ndi +'|in_idCsu=' + idCsuFlash+'|in_idSiebel=' + idSiebelFlash+'|in_idFoncFact=' + idFoncFactFlash+'|in_ressSecond=' + ressSecondFlash+'|in_ressPrinc=' + ressPrincFlash+'|in_trackIdWcb=' + trackIdWcbFlash ); ]]></script>
        <subdialog name="sub_init_flash" srcexpr="srcModuleInitFlash" method="get" fetchtimeout="10s"
                   fetchaudio="../../../audio/Attente.wav">
            <param name="in_appSvi" expr="appSvi"/>
            <param name="in_ndi" expr="ndi"/>
  			<param name="in_idCsu" expr="idCsuFlash"/>
  			<param name="in_idSiebel" expr="idSiebelFlash"/>
  			<param name="in_idFoncFact" expr="idFoncFactFlash"/>
  			<param name="in_ressSecond" expr="ressSecondFlash"/>
  			<param name="in_ressPrinc" expr="ressPrincFlash"/>
  			<param name="in_trackIdWcb" expr="trackIdWcbFlash"/>            

            <catch event="error">
                <script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
                <script><![CDATA[
					LIST_FLASH = ';;;;;';
					customNode(applicationName + '_' + '80001_FLASH_HS');
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "CTRL_HOHNO_SOUS_APPLI"); ]]></script>
                <goto next="#CTRL_HOHNO_SOUS_APPLI"/>
            </catch>
            <filled>
                <script> <![CDATA[
			   			LIST_FLASH = sub_init_flash.CUSTOMER_FLASH.list_flash;
			   			log_debug_assignment(pageCourante, "LIST_FLASH", LIST_FLASH);
			   			customNodeAfterModule (sub_init_flash.STAT_MODULE);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "CTRL_HOHNO_SOUS_APPLI"); ]]></script>
                <goto next="#CTRL_HOHNO_SOUS_APPLI"/>

            </filled>
        </subdialog>
    </form>

       
        
   <!-- ################################################################
    		Controle des heures d'ouverture des sous appli FIXE
    	################################################################## -->
    <form id="CTRL_HOHNO_SOUS_APPLI">
		<script><![CDATA[ formCourant = "CTRL_HOHNO_SOUS_APPLI"; ]]></script>
		<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
	    
    	<script><![CDATA[
	    	var appAllSvi ='true';
	    ]]></script>
	    
	    <script><![CDATA[ log_debug_appel_web_app(pageCourante, 'HOHNO', subdialogHOHNO , 'appSvi='+appSvi+'|appAllSvi=' +appAllSvi ); ]]></script>
	    
        <subdialog name="SUBDIALOG_HO_HNO_ALL_SVI"
        	srcexpr="subdialogHOHNO" 
        	namelist="appSvi appAllSvi" 
        	method="post" 
        	fetchtimeout="10s" 
        	fetchaudio="../../../audio/Attente.wav"/>
        
	
        <catch event="error">
        	<script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '80000_HO_SOUS_APPLI_HS');
            ]]></script>

            <script><![CDATA[ log_debug_next_form(pageCourante, "VersMC_TECH_WS"); ]]></script>
            <goto next="#VersMC_TECH_WS"/>          
        </catch>
        
        <block>
            <script><![CDATA[ log_debug_result_web_app(pageCourante, 'SUBDIALOG_HO_HNO_ALL_SVI', SUBDIALOG_HO_HNO_ALL_SVI ); ]]></script>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "SUBDIALOG_HO_HNO_ALL_SVI.APP_STATUS == 'NOK' "); ]]></script>	
            <if cond=" SUBDIALOG_HO_HNO_ALL_SVI.APP_STATUS == 'NOK' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " SUBDIALOG_HO_HNO_ALL_SVI.APP_STATUS == 'NOK' "); ]]></script>	
                <script><![CDATA[
					CUSTOMER_HOHNO = {};													
                ]]></script>                 
                <script><![CDATA[ log_debug_assignment(pageCourante,"CUSTOMER_HOHNO", CUSTOMER_HOHNO ); ]]></script>          	 	

            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <assign name="CUSTOMER_HOHNO" expr="SUBDIALOG_HO_HNO_ALL_SVI"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"CUSTOMER_HOHNO", SUBDIALOG_HO_HNO_ALL_SVI); ]]></script>
                
                <script><![CDATA[
					FIXE_IS_OPEN = SUBDIALOG_HO_HNO_ALL_SVI.IS_OPEN ;
					FIXE_MSG_TO_PLAY = SUBDIALOG_HO_HNO_ALL_SVI.MSG_TO_PLAY;
                	FIXE_COM_IS_OPEN = SUBDIALOG_HO_HNO_ALL_SVI.FIXE_COM_IS_OPEN;	
					FIXE_COM_MSG_TO_PLAY = SUBDIALOG_HO_HNO_ALL_SVI.FIXE_COM_MSG_TO_PLAY;	
					FIXE_TECH_IS_OPEN = SUBDIALOG_HO_HNO_ALL_SVI.FIXE_TECH_IS_OPEN;	
					FIXE_TECH_MSG_TO_PLAY = SUBDIALOG_HO_HNO_ALL_SVI.FIXE_TECH_MSG_TO_PLAY;	
					FIXE_RET_IS_OPEN = SUBDIALOG_HO_HNO_ALL_SVI.FIXE_RET_IS_OPEN;	
					FIXE_RET_MSG_TO_PLAY = SUBDIALOG_HO_HNO_ALL_SVI.FIXE_RET_MSG_TO_PLAY;	
					FIXE_DEM_IS_OPEN = SUBDIALOG_HO_HNO_ALL_SVI.FIXE_DEM_IS_OPEN;	
					FIXE_DEM_MSG_TO_PLAY = SUBDIALOG_HO_HNO_ALL_SVI.FIXE_DEM_MSG_TO_PLAY;	
					FIXE_ANC_IS_OPEN = SUBDIALOG_HO_HNO_ALL_SVI.FIXE_ANC_IS_OPEN;	
					FIXE_ANC_MSG_TO_PLAY = SUBDIALOG_HO_HNO_ALL_SVI.FIXE_ANC_MSG_TO_PLAY;																								
                ]]></script> 
				<script><![CDATA[ log_debug_assignment(pageCourante,"FIXE_IS_OPEN", FIXE_IS_OPEN); ]]></script> 
				<script><![CDATA[ log_debug_assignment(pageCourante,"FIXE_MSG_TO_PLAY", FIXE_MSG_TO_PLAY); ]]></script>
                <script><![CDATA[ log_debug_assignment(pageCourante,"FIXE_COM_IS_OPEN", FIXE_COM_IS_OPEN); ]]></script>                 
                <script><![CDATA[ log_debug_assignment(pageCourante,"FIXE_COM_MSG_TO_PLAY", FIXE_COM_MSG_TO_PLAY); ]]></script>
                <script><![CDATA[ log_debug_assignment(pageCourante,"FIXE_TECH_IS_OPEN", FIXE_TECH_IS_OPEN); ]]></script>
                <script><![CDATA[ log_debug_assignment(pageCourante,"FIXE_TECH_MSG_TO_PLAY", FIXE_TECH_MSG_TO_PLAY); ]]></script>
                <script><![CDATA[ log_debug_assignment(pageCourante,"FIXE_RET_IS_OPEN", FIXE_RET_IS_OPEN); ]]></script>
                <script><![CDATA[ log_debug_assignment(pageCourante,"FIXE_RET_MSG_TO_PLAY", FIXE_RET_MSG_TO_PLAY); ]]></script>
                <script><![CDATA[ log_debug_assignment(pageCourante,"FIXE_DEM_IS_OPEN", FIXE_DEM_IS_OPEN); ]]></script>                                              
                <script><![CDATA[ log_debug_assignment(pageCourante,"FIXE_DEM_MSG_TO_PLAY", FIXE_DEM_MSG_TO_PLAY); ]]></script>  
                <script><![CDATA[ log_debug_assignment(pageCourante,"FIXE_ANC_IS_OPEN", FIXE_ANC_IS_OPEN); ]]></script>                                              
                <script><![CDATA[ log_debug_assignment(pageCourante,"FIXE_ANC_MSG_TO_PLAY", FIXE_ANC_MSG_TO_PLAY); ]]></script>                                              
                
            </if>
            
            <script><![CDATA[ log_debug_next_form(pageCourante, "VersMC_TECH_WS"); ]]></script>
            <goto next="#VersMC_TECH_WS"/>          

        </block>        

    </form>
    
    
    <!-- ================================================= //-->
    <!-- PRE traitement MC_TECH : Appel au WS MC_TECH      //-->
    <!-- ================================================= //-->
       
    <form id="VersMC_TECH_WS">
    	<script><![CDATA[ formCourant = "VersMC_TECH_WS"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!--	Filtre MC_TECH TECH et id_siebel non vide -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.MC_TECH != 'false'  &amp;&amp; Id_Siebel != '' &amp;&amp; Id_Siebel != 'null' "); ]]></script>	
            <if cond="CUSTOMER_IHM.MC_TECH != 'false'  &amp;&amp; Id_Siebel != '' &amp;&amp; Id_Siebel != 'null'  ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.MC_TECH != 'false'  &amp;&amp; Id_Siebel != '' &amp;&amp; Id_Siebel != 'null'"); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "MC_TECH_WS"); ]]></script>
                <goto next="#MC_TECH_WS"/>

            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_WS_ELIGIBILITE_BEB_FIXE_FASTR"); ]]></script>
                <goto next="#Vers_WS_ELIGIBILITE_BEB_FIXE_FASTR"/>

            </if>
        </block>
    </form>
        
         
    <form id="MC_TECH_WS">
        <script><![CDATA[ formCourant = "MC_TECH_WS"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[
			var id_siebel = Id_Siebel ;   
        ]]></script>
        <script><![CDATA[ log_debug_appel_web_app(pageCourante, 'WS_MC_TECH', subdialogWS_MC_TECH , 'id_siebel=' + id_siebel ); ]]></script>
        <subdialog name="WS_MC_TECH"
                   srcexpr="subdialogWS_MC_TECH"
                   namelist="id_siebel"
                   method="get"
                   fetchtimeout="10s"
                   fetchaudio="../../../audio/Attente.wav"/>
        <catch event="error">
            <script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '00112_WS_MC_TECH_HS');
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_WS_ELIGIBILITE_BEB_FIXE_FASTR"); ]]></script>
            <goto next="#Vers_WS_ELIGIBILITE_BEB_FIXE_FASTR"/>
        </catch>

        <block>
            <script><![CDATA[ log_debug_result_web_app(pageCourante, 'WS_MC_TECH', WS_MC_TECH ); ]]></script>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " WS_MC_TECH.APP_STATUS == 'NOK' || WS_MC_TECH.WS_MC_TECH_STATUS == 'NOK' "); ]]></script>
            <if cond=" WS_MC_TECH.APP_STATUS == 'NOK' || WS_MC_TECH.WS_MC_TECH_STATUS == 'NOK' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " WS_MC_TECH.APP_STATUS == 'NOK' || WS_MC_TECH.WS_MC_TECH_STATUS == 'NOK' "); ]]></script>

                <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_WS_ELIGIBILITE_BEB_FIXE_FASTR"); ]]></script>
                <goto next="#Vers_WS_ELIGIBILITE_BEB_FIXE_FASTR"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                	
                <assign name="CUSTOMER_WS_MC_TECH" expr="WS_MC_TECH"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"CUSTOMER_WS_MC_TECH", CUSTOMER_WS_MC_TECH); ]]></script>
                <!--donnees mc_tech  -->
                <assign name="MC_TECH_FOUND" expr="CUSTOMER_WS_MC_TECH.MC_TECH_FOUND"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"MC_TECH_FOUND", MC_TECH_FOUND); ]]></script>
                
                <assign name="MC_TECH_POSITION_ASSIGNE_A" expr="CUSTOMER_WS_MC_TECH.MC_TECH_POSITION_ASSIGNE_A"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"MC_TECH_POSITION_ASSIGNE_A", MC_TECH_POSITION_ASSIGNE_A); ]]></script>
                
                <assign name="MC_TECH_POSITION_CREATEUR" expr="CUSTOMER_WS_MC_TECH.MC_TECH_POSITION_CREATEUR"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"MC_TECH_POSITION_CREATEUR", MC_TECH_POSITION_CREATEUR); ]]></script>
                
                <assign name="MC_TECH_MOTIF" expr="CUSTOMER_WS_MC_TECH.MC_TECH_MOTIF"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"MC_TECH_MOTIF", MC_TECH_MOTIF); ]]></script>
                
                <assign name="MC_TECH_SOUS_TRAITANT" expr="CUSTOMER_WS_MC_TECH.MC_TECH_SOUS_TRAITANT"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"MC_TECH_SOUS_TRAITANT", MC_TECH_SOUS_TRAITANT); ]]></script>
                
                <assign name="MC_TECH_STATUT" expr="CUSTOMER_WS_MC_TECH.MC_TECH_STATUT"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"MC_TECH_STATUT", MC_TECH_STATUT); ]]></script>

                <assign name="MC_TECH_CONCLUSION" expr="CUSTOMER_WS_MC_TECH.MC_TECH_CONCLUSION"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"MC_TECH_CONCLUSION", MC_TECH_CONCLUSION); ]]></script>
                  
                <assign name="MC_TECH_OPEN" expr="CUSTOMER_WS_MC_TECH.MC_TECH_OPEN"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"MC_TECH_OPEN", MC_TECH_OPEN); ]]></script>
                                              
                <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_WS_ELIGIBILITE_BEB_FIXE_FASTR"); ]]></script>
                <goto next="#Vers_WS_ELIGIBILITE_BEB_FIXE_FASTR"/>

            </if>

        </block>
    </form> 
    
    
    <!--########################################################
               PRE traitement BEB_FIXE_FASTR : Appel au WS FASTR  
        ######################################################## -->

   <form id="Vers_WS_ELIGIBILITE_BEB_FIXE_FASTR">
        <script><![CDATA[ formCourant = "Vers_WS_ELIGIBILITE_BEB_FIXE_FASTR"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
          
            <!--CTRL avant appel au WS  WS_ELIGIBILITE_BEB_FIXE_FASTR - au moins un des 2 filtres doit etre activé-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "(CUSTOMER_IHM.BEB_FIXE_FASTR_RET != 'false' || CUSTOMER_IHM.BEB_FIXE_FASTR_COM != 'false' || CUSTOMER_IHM.BEB_FIXE_FASTR_ANC != 'false') &amp;&amp; Id_Siebel != '' &amp;&amp; Id_Siebel != 'null'"); ]]></script>
            <if cond="(CUSTOMER_IHM.BEB_FIXE_FASTR_RET != 'false' || CUSTOMER_IHM.BEB_FIXE_FASTR_COM != 'false' || CUSTOMER_IHM.BEB_FIXE_FASTR_ANC != 'false') &amp;&amp; Id_Siebel != '' &amp;&amp; Id_Siebel != 'null' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "(CUSTOMER_IHM.BEB_FIXE_FASTR_RET != 'false' || CUSTOMER_IHM.BEB_FIXE_FASTR_COM != 'false' || CUSTOMER_IHM.BEB_FIXE_FASTR_ANC != 'false') &amp;&amp; Id_Siebel != '' &amp;&amp; Id_Siebel != 'null' "); ]]></script>
                
	            <!--FTTB -->
	            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientFixeFTTB() "); ]]></script>
	            <if cond="isClientFixeFTTB() ">
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTB() "); ]]></script>
	                <script><![CDATA[
						TECHNO ='FTTB';				
	                ]]></script>
					<script><![CDATA[ log_debug_assignment(pageCourante,'TECHNO', TECHNO); ]]></script>
	
	                <!--FTTH -->
	            <elseif cond="isClientFixeFTTH() "/>
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH() "); ]]></script>
	                <script><![CDATA[
						TECHNO ='FTTH';					
	                ]]></script>
					<script><![CDATA[ log_debug_assignment(pageCourante,'TECHNO', TECHNO); ]]></script>
	
	                <!--ADSL et cas par défaut-->
	            <else/>
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
	                <script><![CDATA[
						TECHNO ='ADSL';						
	                ]]></script>
					<script><![CDATA[ log_debug_assignment(pageCourante,'TECHNO', TECHNO); ]]></script>
	            </if>                
            	<script><![CDATA[ log_debug_next_form(pageCourante, "WS_ELIGIBILITE_BEB_FIXE_FASTR"); ]]></script>
            	<goto next="#WS_ELIGIBILITE_BEB_FIXE_FASTR"/>                
              
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                             
