        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + "FIXE_MENU_SUSPENDU" + ":CHOIX", "2"); ]]></script>
        <script><![CDATA[ track_dtmfList ("FIXE_MENU_SUSPENDU", "2"); ]]></script>
        <block>
