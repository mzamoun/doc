        </block>
    </form>
    
     <!--	appel classique et appel wcb digital  -->
    <form id="Choix_Transfert_CTRL_HOHNO_COM">
        <script><![CDATA[ formCourant = "Choix_Transfert_CTRL_HOHNO_COM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
        
            <!--	SOUS APPLI FIXE_COM HO  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " FIXE_COM_IS_OPEN =='true' "); ]]></script>	
            <if cond=" FIXE_COM_IS_OPEN =='true' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " FIXE_COM_IS_OPEN =='true' "); ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_RDGU_SUSPENDU2"); ]]></script>
	            <goto next="#Filtre_RDGU_SUSPENDU2"/> 

            <!--	FIXE_COM HNO  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[			               
					customNode(applicationName + '_' + '00072_SUSPENDU_HNO_COM');
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_HNO_COM.vxml"); ]]></script>
                <goto next="./FIXE_HNO_COM.vxml"/>

            </if>          
    
        </block>
    </form>
    
    <!--###########################################
         CTRL filtre RDGU - SUSPENDU2
    ########################################### -->    
   	<!--CTRL filtre RDGU 2 -->   
    <form id="Filtre_RDGU_SUSPENDU2">
    	<script><![CDATA[ formCourant = "Filtre_RDGU_SUSPENDU2"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <!--	Filtre RDGU desactive -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.RDGU == 'false'"); ]]></script>	            
            <if cond="CUSTOMER_IHM.RDGU == 'false' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.RDGU == 'false'"); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00072_FCT_RDGU_SUSP_OFF');
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_CTRL_BEB_FIXE_FASTR_COM"); ]]></script>
	            <goto next="#VERS_CTRL_BEB_FIXE_FASTR_COM"/>                
                  
                
           <!--	Appel en provenance de RDGU  -->
            <elseif cond="is_provenance_rdgu()"/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "is_provenance_rdgu() "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00072_FCT_RDGU_SUSP_OK');
            		ID_FLUX='FIXE_FCT_PREMIUM_RDGU_SUSP';	
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>            
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
	            <goto next="#Transfert"/>	                                                                                          
               
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '00072_FCT_RDGU_SUSP_NOK');
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_CTRL_BEB_FIXE_FASTR_COM"); ]]></script>
	            <goto next="#VERS_CTRL_BEB_FIXE_FASTR_COM"/>                
            </if>                                   
                                         
        </block>
    </form>     
    
    <!--###########################################
         TRAITEMENT BEB_FIXE__FASTER_COM
    ########################################### --> 
    <form id="VERS_CTRL_BEB_FIXE_FASTR_COM">
        <script><![CDATA[ formCourant = "VERS_CTRL_BEB_FIXE_FASTR_COM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[			               
				customNode(applicationName + '_' + '00072_SUSPENDU_HO_COM');
				POSITION_ARBO = 66;	
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>                        
    
        </block>
    </form>
           
    <form id="CTRL_BEB_FIXE_FASTR_COM">
        <script><![CDATA[ formCourant = "CTRL_BEB_FIXE_FASTR_COM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!--ELIGIBILITE BEB_FIXE_FASTR_COM -->
            
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.BEB_FIXE_FASTR_COM != 'false' &amp;&amp; isBEB_FIXE_FASTR_COM()  "); ]]></script>
            <if cond="CUSTOMER_IHM.BEB_FIXE_FASTR_COM != 'false' &amp;&amp; isBEB_FIXE_FASTR_COM()">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.BEB_FIXE_FASTR_COM != 'false' &amp;&amp; isBEB_FIXE_FASTR_COM() "); ]]></script>               	
	            <script><![CDATA[
		            customNode(applicationName + '_' + '00072_SUSP_BEB_COM_FASTR_OK');			            
	            ]]></script>
	            
                <!--CTRL HO HNO de l'activit� FASTR-->
                <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN &amp;&amp; CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN =='true' "); ]]></script>
	            <if cond="CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN &amp;&amp; CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN =='true' ">
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN &amp;&amp; CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN =='true'"); ]]></script>
	                <!--precision de l'origine de l'appel pour aiguillage sur le parcours BEB_FIXE -->
	                <script><![CDATA[
			            BEB_FIXE_FASTR_ORIGINE ='FIXE_SUSPENDU_BEB_FIXE_FASTR_COM';
			            customNode(applicationName + '_' + '00072_SUSPENDU_BEB_COM_HO');
						POSITION_ARBO = 72;	
						log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);												
               		 ]]></script>
               		 <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
               		 <goto next="./FIXE_FLASH_INC.vxml"/>
	                               		 	
	            <else/>
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
		            <script><![CDATA[
						customNode(applicationName + '_' + '00072_SUSPENDU_BEB_COM_HNO');					
		            ]]></script>                
	            	<script><![CDATA[ log_debug_next_form(pageCourante, "Vers_Filtre_Wcb_Digital_TRF"); ]]></script>
		            <goto next="#Vers_Filtre_Wcb_Digital_TRF"/> 
	
	            </if> 	            
                                                        
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '00072_SUSP_BEB_COM_FASTR_NOK');					
	            ]]></script>                
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_Filtre_Wcb_Digital_TRF"); ]]></script>
	            <goto next="#Vers_Filtre_Wcb_Digital_TRF"/>       

            </if>

        </block>
    </form> 
        
 
<!--###########################################
         Vers parcours BEB_FIXE
    ########################################### -->
    <form id="Vers_Parcours_BEB_FIXE">
        <script><![CDATA[ formCourant = "Vers_Parcours_BEB_FIXE"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <script><![CDATA[
				MC_APP_ORIGINE='BEB_FIXE';
				var nextAPP ="../../../beb_fixe/index.vxml";
            ]]></script>
            <!-- Transfert vers le parcours BEB_FIXE -->
            <script><![CDATA[ log_debug_next_page(pageCourante, nextAPP); ]]></script>
            <goto expr="nextAPP"/>
        </block>
    </form>    
        
<!--###########################################
         SUITE traitement SUSPENDU
    ########################################### --> 
    <form id="Vers_Filtre_Wcb_Digital_TRF">
        <script><![CDATA[ formCourant = "Vers_Filtre_Wcb_Digital_TRF"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <script><![CDATA[
				POSITION_ARBO = 73;	
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);						
            ]]></script>                
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/> 
        </block>
    </form>           
    
    <form id="Filtre_Wcb_Digital_TRF">
        <script><![CDATA[ formCourant = "Filtre_Wcb_Digital_TRF"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <!--	Client en provenance de WCB_DIGITAL		-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital == 'FIXE' "); ]]></script>
            <if cond="CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital == 'FIXE' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital == 'FIXE' "); ]]></script>
                <script><![CDATA[			               
					customNode(applicationName + '_' + '00072_WCB_SUSPENDU');
					POSITION_ARBO = 68;	
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/>                                                       

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '00072_SUSPENDU');
					POSITION_ARBO = 31;	
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/>

            </if>
        </block>
    </form>     
        
    <form id="SUSPENDU_CTRL_PREMIUM">
        <script><![CDATA[ formCourant = "SUSPENDU_CTRL_PREMIUM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
	        <!-- PREMIUM -->  
	        <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() "); ]]></script>
	        <if cond="CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() ">
	            <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() "); ]]></script>
	
	            <script><![CDATA[
					customNode(applicationName + '_' + '00072_SUSPENDU_PREMIUM_COM');
					POSITION_ARBO = 15;	
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/>	
	            		
	        <else/>
	            <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
	        
	            <script><![CDATA[
					customNode(applicationName + '_' + '00072_SUSPENDU_COM');
					POSITION_ARBO = 67;	
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/>	
	        </if> 
                
        </block>
    </form>
    
    <!--###########################################
        Suspendu - Transfert PREMIUM
    ########################################### -->      
    <form id="SUSPENDU_TRF_PREMIUM">
        <script><![CDATA[ formCourant = "SUSPENDU_TRF_PREMIUM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
        
            <!--  PACKPRO					  //-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "FIXE_PACKPRO == 'true'"); ]]></script>
            <if cond="FIXE_PACKPRO == 'true'">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_PACKPRO == 'true'"); ]]></script>                                
                <script><![CDATA[
					customNode(applicationName + '_' + '00072_FCT_PACKPRO_SUSP');
					ID_FLUX='FIXE_FCT_PACKPRO_SUSP';					
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>                                    
               
               <!--	FIDE 	-->
            <elseif cond="FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' "); ]]></script>
                <script><![CDATA[
                	   balise_transfert ='00072_FCT_PREMIUM_FIDE_SUSP';
					   ID_FLUX='FIXE_FCT_PREMIUM_FIDE_SUSP';		
					   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>                

                <!--Autre PREMIUM -->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
                		balise_transfert ='00072_FCT_PREMIUM_SUSP';
                		ID_FLUX='FIXE_FCT_PREMIUM_SUSP';	
						log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
            </if>
            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
            <goto next="#Transfert"/>
        </block>
    </form>

    <!--###########################################
        Suspendu - Transfert GP
    ########################################### -->    
    <form id="SUSPENDU_TRF">
        <script><![CDATA[ formCourant = "SUSPENDU_TRF"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				log_debug(pageCourante, "isCONV_RISQUE()=" + isCONV_RISQUE());
				log_debug(pageCourante, "isCONV_NON_RISQUE()=" + isCONV_NON_RISQUE());
				log_debug(pageCourante, "isNON_CONV_RISQUE()=" + isNON_CONV_RISQUE());
            ]]></script>

            <!-- Client CONV_RISQUE   -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.C2OL_CONV_RISQUE == 'true' &amp;&amp; isCONV_RISQUE()"); ]]></script>
            <if cond="CUSTOMER_IHM.C2OL_CONV_RISQUE == 'true' &amp;&amp; isCONV_RISQUE()">
	            <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.C2OL_CONV_RISQUE == 'true' &amp;&amp; isCONV_RISQUE()"); ]]></script>                
                <script><![CDATA[
					balise_transfert ='00072_SUSP_FCT_CONV_RISQUE';
					ID_FLUX='FCT_CONV_RISQUE_SUSP';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
	            <goto next="#Transfert"/>

            <!-- Client CONV_NON_RISQUE   -->
            <elseif cond="CUSTOMER_IHM.C2OL_CONV == 'true' &amp;&amp; isCONV_NON_RISQUE()"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.C2OL_CONV == 'true' &amp;&amp; isCONV_NON_RISQUE()"); ]]></script>
                <script><![CDATA[
					balise_transfert ='00072_SUSP_FCT_CONV';
					ID_FLUX='FCT_CONV_SUSP';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
	            <goto next="#Transfert"/>

            <!-- Client NON_CONV_RISQUE   -->
            <elseif cond="CUSTOMER_IHM.C2OL_RISQUE == 'true' &amp;&amp; isNON_CONV_RISQUE()"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.C2OL_RISQUE == 'true' &amp;&amp; isNON_CONV_RISQUE()"); ]]></script>
                <script><![CDATA[
					balise_transfert ='00072_SUSP_FCT_FIXE_RISQUE';
					ID_FLUX='FCT_FIXE_RISQUE_SUSP';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
	            <goto next="#Transfert"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					balise_transfert ='00072_SUSP_FCT_FIXE';					
					ID_FLUX='FCT_FIXE_SUSP';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
	            <goto next="#Transfert"/>
	            
            </if>
        </block>
    </form>    
    
    
     
    <form id="Transfert">
        <script><![CDATA[ formCourant = "Transfert"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>        
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_TRANSFERT.vxml"); ]]></script>
            <goto next="./FIXE_TRANSFERT.vxml"/>
        </block>
    </form>

</vxml>
