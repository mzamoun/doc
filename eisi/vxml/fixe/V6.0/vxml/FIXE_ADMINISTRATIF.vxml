<!--###########################################
        Routage ADMIN_CO
    ########################################### -->    
    <form id="Vers_SUITE_TRT_ADM_CO">
        <script><![CDATA[ formCourant = "Vers_SUITE_TRT_ADM_CO"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '42000_ADM_AUTRE_2');
				POSITION_ARBO = 37;
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>
        </block>
    </form>
    

    <form id="SUITE_TRT_ADM_CO">
        <script><![CDATA[ formCourant = "SUITE_TRT_ADM_CO"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>

            <!-- Appel en provenance de WCB_DIGITAL  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp;  type_appel_wcb_digital == 'FIXE' &amp;&amp; wcb_digital_codeMotif =='05' "); ]]></script>
            <if cond="CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp;  type_appel_wcb_digital == 'FIXE' &amp;&amp; wcb_digital_codeMotif =='05' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp;  type_appel_wcb_digital == 'FIXE' &amp;&amp; wcb_digital_codeMotif =='05' "); ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_WCB_DIGITAL.vxml#Wcb_ADMIN_GP"); ]]></script>
                <goto next="./FIXE_WCB_DIGITAL.vxml#Wcb_ADMIN_GP"/>         
                
                <!-- Client ADSL RACCO  et filtre 15j activé ou client recent et filtre désactive  -->                            
            <elseif cond="(CUSTOMER_IHM.RACCO_15J == 'true'  &amp;&amp; isADSL_RACCO_DEXTER() )  || (CUSTOMER_IHM.RACCO_15J != 'true'  &amp;&amp;  isClientRecent_CO_DEXTER())"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "(CUSTOMER_IHM.RACCO_15J == 'true'  &amp;&amp; isADSL_RACCO_DEXTER() )  || (CUSTOMER_IHM.RACCO_15J != 'true'  &amp;&amp;  isClientRecent_CO_DEXTER())"); ]]></script>
                <script><![CDATA[
					balise_transfert ='43000_ACTIV_ADSL';
					ID_FLUX='ACTIV_ADSL';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_Transfert_ANC"); ]]></script>
	            <goto next="#Vers_Transfert_ANC"/>

                <!-- Client MIGNC RACCO et filtre 15j activé ou client mignc recent  et filtre désactive -->
            <elseif cond="(CUSTOMER_IHM.RACCO_15J == 'true'  &amp;&amp; isMIGNC_RACCO_DEXTER()) || (CUSTOMER_IHM.RACCO_15J != 'true'  &amp;&amp;  isMIGNC_RECENT_DEXTER() ) "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "(CUSTOMER_IHM.RACCO_15J == 'true'  &amp;&amp; isMIGNC_RACCO_DEXTER()) || (CUSTOMER_IHM.RACCO_15J != 'true'  &amp;&amp;  isMIGNC_RECENT_DEXTER() )"); ]]></script>
                <script><![CDATA[
					balise_transfert ='43000_ACTIV_FTTB_MIG';
					ID_FLUX='ACTIV_FTTB_MIG';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_Transfert_ANC"); ]]></script>
	            <goto next="#Vers_Transfert_ANC"/>

                <!-- Client CABLE RACCO	 et filtre 15j activé ou client cable recent  et filtre désactive -->
            <elseif cond="(CUSTOMER_IHM.RACCO_15J == 'true'  &amp;&amp;  isFTTB_RACCO_DEXTER() ) || (CUSTOMER_IHM.RACCO_15J != 'true'  &amp;&amp;  isClientRecent_FTTB_DEXTER() ) "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "(CUSTOMER_IHM.RACCO_15J == 'true'  &amp;&amp;  isFTTB_RACCO_DEXTER() ) || (CUSTOMER_IHM.RACCO_15J != 'true'  &amp;&amp;  isClientRecent_FTTB_DEXTER() )"); ]]></script>
                <script><![CDATA[
					balise_transfert ='43000_ACTIV_FTTB';
					ID_FLUX='ACTIV_FTTB';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_Transfert_ANC"); ]]></script>
	            <goto next="#Vers_Transfert_ANC"/>


                <!-- Client FTTH RACCO	-->
            <elseif cond="(CUSTOMER_IHM.RACCO_15J == 'true'  &amp;&amp;  isFTTH_RACCO_DEXTER() ) || (CUSTOMER_IHM.RACCO_15J != 'true'  &amp;&amp; isClientRecent_FTTH_DEXTER()) "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "(CUSTOMER_IHM.RACCO_15J == 'true'  &amp;&amp;  isFTTH_RACCO_DEXTER() ) || (CUSTOMER_IHM.RACCO_15J != 'true'  &amp;&amp; isClientRecent_FTTH_DEXTER())"); ]]></script>
                <script><![CDATA[
					balise_transfert ='43000_ACTIV_FTTH';
					ID_FLUX='ACTIV_FTTH';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_Transfert_ANC"); ]]></script>
	            <goto next="#Vers_Transfert_ANC"/>

			<!-- Client ADSL recent 	-->
            <elseif cond=" isClientRecent_CO_DEXTER() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " isClientRecent_CO_DEXTER() "); ]]></script>
                <script><![CDATA[
					balise_transfert ='43000_ACTIV_ADSL_NON_RISQUE';
					ID_FLUX='ACTIV_ADSL_NON_RISQUE';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_Transfert_ANC"); ]]></script>
	            <goto next="#Vers_Transfert_ANC"/>

                <!-- Client MIGNC RECENT -->
            <elseif cond="isMIGNC_RECENT_DEXTER() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isMIGNC_RECENT_DEXTER() "); ]]></script>
                <script><![CDATA[
					balise_transfert ='43000_ACTIV_FTTB_MIG_NON_RISQUE';
					ID_FLUX='ACTIV_FTTB_MIG_NON_RISQUE';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_Transfert_ANC"); ]]></script>
	            <goto next="#Vers_Transfert_ANC"/>

                <!-- Client CABLE RECENT	-->
            <elseif cond="isClientRecent_FTTB_DEXTER()"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientRecent_FTTB_DEXTER() "); ]]></script>
                <script><![CDATA[
					balise_transfert ='43000_ACTIV_FTTB_NON_RISQUE';
					ID_FLUX='ACTIV_FTTB_NON_RISQUE';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_Transfert_ANC"); ]]></script>
	            <goto next="#Vers_Transfert_ANC"/>


                <!-- Client FTTH RECENT	-->
            <elseif cond="isClientRecent_FTTH_DEXTER() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientRecent_FTTH_DEXTER()"); ]]></script>
                <script><![CDATA[
					balise_transfert ='43000_ACTIV_FTTH_NON_RISQUE';
					ID_FLUX='ACTIV_FTTH_NON_RISQUE';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_Transfert_ANC"); ]]></script>
	            <goto next="#Vers_Transfert_ANC"/>
	            
	            	            
                <!-- Client CONV_RISQUE   -->
            <elseif cond="CUSTOMER_IHM.C2OL_CONV_RISQUE == 'true' &amp;&amp; isCONV_RISQUE() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.C2OL_CONV_RISQUE == 'true' &amp;&amp; isCONV_RISQUE() "); ]]></script>
                <script><![CDATA[
					balise_transfert ='43000_FCT_CONV_RISQUE';
					ID_FLUX='FCT_CONV_RISQUE';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_Transfert_COM"); ]]></script>
	            <goto next="#Vers_Transfert_COM"/>

                <!-- Client CONV_NON_RISQUE   -->
            <elseif cond="CUSTOMER_IHM.C2OL_CONV == 'true' &amp;&amp; isCONV_NON_RISQUE() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.C2OL_CONV == 'true' &amp;&amp; isCONV_NON_RISQUE() "); ]]></script>
                <script><![CDATA[
					balise_transfert ='43000_FCT_CONV';
					ID_FLUX='FCT_CONV';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_Transfert_COM"); ]]></script>
	            <goto next="#Vers_Transfert_COM"/>

                <!-- Client NON_CONV_RISQUE   -->
            <elseif cond="CUSTOMER_IHM.C2OL_RISQUE == 'true' &amp;&amp; isNON_CONV_RISQUE() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.C2OL_RISQUE == 'true' &amp;&amp; isNON_CONV_RISQUE() "); ]]></script>
                <script><![CDATA[
					balise_transfert ='43000_FCT_FIXE_RISQUE';
					ID_FLUX='FCT_FIXE_RISQUE';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_Transfert_COM"); ]]></script>
	            <goto next="#Vers_Transfert_COM"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					balise_transfert ='43000_FCT_FIXE';
					ID_FLUX='FCT_FIXE';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_Transfert_COM"); ]]></script>
	            <goto next="#Vers_Transfert_COM"/>

            </if>
        </block>
    </form>  
    
    <form id="Vers_Transfert_ANC">
        <script><![CDATA[ formCourant = "Vers_Transfert_ANC"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
        
            <!--	SOUS APPLI FIXE_ANC HO  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_ANC_IS_OPEN !='false' "); ]]></script>	
            <if cond=" CUSTOMER_HOHNO.FIXE_ANC_IS_OPEN !='false' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_ANC_IS_OPEN !='false' "); ]]></script>	
	            <script><![CDATA[
						customNode(applicationName + '_' + '43000_ADMIN_ANC');	
						POSITION_ARBO = 36;		
						log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/>	            	            
    
            <!--	FIXE_ANC HNO  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[
					ID_FLUX='';				
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);	
									
                	customNode(applicationName + '_' + '43000_ADMIN_HNO_ANC');					
                ]]></script>
                                           
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_HNO_ANC.vxml"); ]]></script>
                <goto next="./FIXE_HNO_ANC.vxml"/>
            </if> 
                                        
        </block>
    </form>
        
    <form id="Transfert_ANC">
        <script><![CDATA[ formCourant = "Transfert_ANC"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
        
            <script><![CDATA[
					customNode(applicationName + '_' + balise_transfert );	
            ]]></script>
            
        	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	

            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
        	<goto next="#Transfert"/>
            	        
                                        
        </block>
    </form>
    
    <form id="Vers_Transfert_COM">
        <script><![CDATA[ formCourant = "Vers_Transfert_COM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
        
            <!--	SOUS APPLI FIXE_COM HO  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_COM_IS_OPEN !='false' "); ]]></script>	
            <if cond=" CUSTOMER_HOHNO.FIXE_COM_IS_OPEN !='false' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_COM_IS_OPEN !='false' "); ]]></script>	
	            <script><![CDATA[
					customNode(applicationName + '_' + '43000_ADMIN_HO_COM');
					customNode(applicationName + '_' + '43000_ADMIN_CO');
            		POSITION_ARBO = 38;		
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/>
	            
	

            <!--	FIXE_COM HNO  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[
					ID_FLUX='';				
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);	                
					customNode(applicationName + '_' + '43000_ADMIN_HNO_COM');
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_HNO_COM.vxml"); ]]></script>
                <goto next="./FIXE_HNO_COM.vxml"/>

            </if> 
    
        </block>
    </form> 
        
    <!--###########################################
         filtre traitement CTRL passage par LN-CO ou LN-FULL
    ########################################### -->
 	<form id="CTRL_LN_FULL_LN_CO">
	    <script><![CDATA[ formCourant = "CTRL_LN_FULL_LN_CO"; ]]></script>
	    <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
	    <block>
	    
	        <!--	TRT LN FIXE-FULL ou CO		-->
	        <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "IS_LN_QUALIFIE_AND_FLUX_RTG_VALIDE()"); ]]></script>
	        <if cond="IS_LN_QUALIFIE_AND_FLUX_RTG_VALIDE() ">
	        	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "IS_LN_QUALIFIE_AND_FLUX_RTG_VALIDE()"); ]]></script>            	
	            <script><![CDATA[
					customNode(applicationName + '_' + '43000_LN_FCT_FIXE_'+ LN_CATEGORY +'_'+ LN_INTENT );
						<!-- FLUX de routage associe LN - intention/category/techno  -->
					ID_FLUX=LN_FLUX_ROUTAGE;
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
	            ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
	            <goto next="#Transfert"/>  
	            
	           
	        <!--	vers transfert des cas en dehors du LN -->
	        <else/>
	        	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
	            
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert_COM"); ]]></script>
	            <goto next="#Transfert_COM"/> 
	
	        </if> 
	
	    </block>
	</form> 
	
	
    <!--###########################################
         VERS TRANSFERT COM
    ########################################### -->
    	    
    <form id="Transfert_COM">
        <script><![CDATA[ formCourant = "Transfert_COM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + balise_transfert );
            ]]></script>
            
            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
            <goto next="#Transfert"/>  

        </block>
    </form>    

    
   
        
    <!--###########################################
         Vers la page Transfert
    ########################################### -->
    <form id="Transfert">
        <script><![CDATA[ formCourant = "Transfert"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_TRANSFERT.vxml"); ]]></script>
            <goto next="./FIXE_TRANSFERT.vxml"/>
        </block>
    </form>
   
              
    <!--###########################################
         ENTREE à partir de ELIGIBILITY_LN KO
    ########################################### -->
    <!--	ENTREE  à partir de LN -->
    <form id="ENTREE_ELIGIBILITE_LN_COM_KO">
        <script><![CDATA[ formCourant = "ENTREE_ELIGIBILITE_LN_COM_KO"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_next_form(pageCourante, "ADMIN_CTRL_MC_TECH"); ]]></script>
            <goto next="#ADMIN_CTRL_MC_TECH"/>
        </block>
    </form>  
    
    <!--###########################################
         Traitement ENTRE AUTREs PAGES
    ########################################### -->
    <!--	ENTREE WCB  -->
    <form id="ENTREE_GP_ADMIN_WCB">
        <script><![CDATA[ formCourant = "ENTREE_GP_ADMIN_WCB"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '40000_WCB_ADM_AUTRE');
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "CHOIX_AUTRE_SUITE"); ]]></script>
            <goto next="#CHOIX_AUTRE_SUITE"/>
        </block>
    </form>

    <!--	ENTREE  à partir de la page routage MDP -->
    <form id="ENTREE_RTG_MDP">
        <script><![CDATA[ formCourant = "ENTREE_RTG_MDP"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '40000_MDP_ADM_AUTRE');
            ]]></script>        
            <script><![CDATA[ log_debug_next_form(pageCourante, "CHOIX_AUTRE_SUITE"); ]]></script>
            <goto next="#CHOIX_AUTRE_SUITE"/>
        </block>
    </form>
    
</vxml>
