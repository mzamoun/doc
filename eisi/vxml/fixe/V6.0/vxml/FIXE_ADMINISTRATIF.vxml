            <script><![CDATA[ log_debug_next_page(pageCourante, nextAPP); ]]></script>
            <goto expr="nextAPP"/>
  
        </block>
    </form>  
    
    <!-- gestion du retour de l'appel à partir du parcours MC en cas de HNO -->
