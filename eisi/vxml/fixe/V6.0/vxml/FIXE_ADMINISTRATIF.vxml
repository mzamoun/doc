    <script><![CDATA[
		applicationName = "FIXE"; appSvi = applicationName;
		var pageCourante = "FIXE_ADMINISTRATIF.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
    ]]></script>

    <var name="errorCounter" expr="1"/>
    <var name="choix" expr="1"/>
    

    <form id="VersGestionCasClient">
        <script><![CDATA[ formCourant = "VersGestionCasClient"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>                    
            <script><![CDATA[ log_debug_next_form(pageCourante, "CTRL_CHOIX_FLASH_FCT"); ]]></script>
            <goto next="#CTRL_CHOIX_FLASH_FCT"/>
                    
        </block>
    </form>
    

    <!--###########################################
                CTRL CHOIX FLASH FCT
        ########################################### -->
    <form id="CTRL_CHOIX_FLASH_FCT">
        <script><![CDATA[ formCourant = "CTRL_CHOIX_FLASH_FCT"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>

            <!--	Filtre CHOIX_FLASH activé -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.CHOIX_FLASH_FCT != 'false' &amp;&amp; (GET_LN_ACTIVITE() !='FIXE-FULL' || (GET_LN_ACTIVITE() =='FIXE-FULL' &amp;&amp; CUSTOMER_CONTEXT_APPEL.Intent_elig_dtmf == 'true') )"); ]]></script>
            <if cond="CUSTOMER_IHM.CHOIX_FLASH_FCT != 'false' &amp;&amp; (GET_LN_ACTIVITE() !='FIXE-FULL' || (GET_LN_ACTIVITE() =='FIXE-FULL' &amp;&amp; CUSTOMER_CONTEXT_APPEL.Intent_elig_dtmf == 'true') )">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.CHOIX_FLASH_FCT != 'false' &amp;&amp; (GET_LN_ACTIVITE() !='FIXE-FULL' || (GET_LN_ACTIVITE() =='FIXE-FULL' &amp;&amp; CUSTOMER_CONTEXT_APPEL.Intent_elig_dtmf == 'true') )"); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '40001_CHOIX_FLASH_FCT');
					POSITION_ARBO = 86;
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
                <goto next="./FIXE_FLASH_INC.vxml"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "CTRL_CHOIX_FLASH2_FCT"); ]]></script>
                <goto next="#CTRL_CHOIX_FLASH2_FCT"/>

            </if>

        </block>
    </form>
    
