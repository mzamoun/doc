        <script><![CDATA[ formCourant = "ADMIN_CTRL_MC_TECH"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
               
            <!-- STC  WS MC_TECH-->
          	<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.MC_TECH != 'false' &amp;&amp; isSTC_WS_MC()"); ]]></script>
            <if cond="CUSTOMER_IHM.MC_TECH != 'false' &amp;&amp; isSTC_WS_MC()">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.MC_TECH != 'false' &amp;&amp; isSTC_WS_MC()"); ]]></script>

                <script><![CDATA[
					customNode(applicationName + '_' + '40500_MC_OK');
					MC_APP_ORIGINE='FIXE_GP_ADMIN_WS';
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "MenuST_EN_COURS"); ]]></script>
                <goto next="#MenuST_EN_COURS"/>                               
                
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '40500_MC_NOK');
                ]]></script>               
                <script><![CDATA[ log_debug_next_form(pageCourante, "Vers_SUITE_TRT_ADM_CO"); ]]></script>
                <goto next="#Vers_SUITE_TRT_ADM_CO"/>

            </if>
        </block>
    </form>

    <!--###########################################
                Menu ST EN COURS
        ########################################### -->
    <menu id="MenuST_EN_COURS">
        <script><![CDATA[ formCourant = "MenuST_EN_COURS"; ]]></script>
        <script><![CDATA[ menuCourant = formCourant; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <property name="timeout" value="3s"/>
        <prompt bargein="true">
            <audio maxage="7200" maxstale="7200" expr="PlayFileCommun(CUSTOMER_IHM.FIXE_CHECK_ST_EN_COURS_CHECK_ST_EN_COURS_AUDIO)"/>
        </prompt>

        <catch event="noinput nomatch" cond="document.errorCounter &lt; 2">
            <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "noinput_nomatch"); ]]></script>
            <script><![CDATA[ track_dtmfList (formCourant,"NMNI"); ]]></script>
            <assign name="document.errorCounter" expr="document.errorCounter + 1"/>
            <script><![CDATA[ log_debug_assignment(pageCourante,"document.errorCounter", document.errorCounter); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '41000_ST_NMNI');
            ]]></script>
            <prompt bargein="true">
                <audio expr="PlayGenericAudio('ERREUR_SAISIE_NOUVEAU')"/>
            </prompt>
            <reprompt/>
        </catch>

        <catch event="noinput nomatch" cond="document.errorCounter == 2">
            <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "noinput_nomatch"); ]]></script>
            <script><![CDATA[ track_dtmfList (formCourant,"NMNI2"); ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "VersSuiteFCT"); ]]></script>
            <goto next="#VersSuiteFCT"/>

        </catch>

        <choice dtmf="1" next="#Vers_CTRL_MC_TECH"/>
        <choice dtmf="2" next="#VersSuiteFCT"/>
    </menu>

    <!--###########################################
          Menu ST EN COURS-Choix 1
    ########################################### -->
    <form id="Vers_CTRL_MC_TECH">
        <script><![CDATA[ formCourant = "Vers_CTRL_MC_TECH"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "1"); ]]></script>
        <script><![CDATA[ track_dtmfList ("MenuST_EN_COURS", "1"); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '41000_MC_OK_2');
            ]]></script>
            
            <!--	SOUS APPLI FIXE_TECH HO  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " FIXE_TECH_IS_OPEN !='false' "); ]]></script>	
            <if cond=" FIXE_TECH_IS_OPEN !='false' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " FIXE_TECH_IS_OPEN !='false' "); ]]></script>	
                <script><![CDATA[ 
					customNode(applicationName + '_' + '41000_MC_OK_HO_TECH');
					POSITION_ARBO = 154;
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
                ]]></script>
                
	            <script><![CDATA[	             	                					
					<!--POSITION_INCIDENT_HEIMDALL = liste ('position|balise|page_suivante|form suivant') -->				
					POSITION_INCIDENT_HEIMDALL = '1|41000_MC_OK_HO_TECH|INCIDENT_INC|;2|41000_MC_OK_HO_TECH|INCIDENT_INC|;3|41000_MC_OK_HO_TECH|INCIDENT_INC|;4|41000_MC_OK_HO_TECH|FLASH_INC|;';
					log_debug_assignment(pageCourante, "POSITION_INCIDENT_HEIMDALL", POSITION_INCIDENT_HEIMDALL);						
				]]></script>
				            
				<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_INCIDENT_INC.vxml"); ]]></script>
				<goto next="./FIXE_INCIDENT_INC.vxml"/>  

            				
            <!--	FIXE_TECH HNO  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '41000_MC_OK_HNO_TECH');
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_HNO_TECH.vxml"); ]]></script>
                <goto next="./FIXE_HNO_TECH.vxml"/>

            </if> 
                        
        </block>
    </form>
    
    <!--###########################################
     Vers Parcours MC
