    <!--###########################################
         TRAITEMENT BEB_FIXE_ANC
    ########################################### --> 
    <form id="VERS_CTRL_BEB_FIXE_FASTR_ANC">
        <script><![CDATA[ formCourant = "VERS_CTRL_BEB_FIXE_FASTR_ANC"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!--FILTRE BEB_FIXE_ANC actif-->
            
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.BEB_FIXE_FASTR_ANC != 'false' "); ]]></script>
            <if cond="CUSTOMER_IHM.BEB_FIXE_FASTR_ANC != 'false' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.BEB_FIXE_FASTR_ANC != 'false' "); ]]></script>               	
	            <script><![CDATA[ log_debug_next_form(pageCourante, "CTRL_BEB_FIXE_FASTR_ANC"); ]]></script>
	            <goto next="#CTRL_BEB_FIXE_FASTR_ANC"/>
	            	             	            	                                                                    
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '40200_ADM_AUTRE_BEB_ANC_OFF');					
	            ]]></script>                
                <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_BEB_FIXE_FASTR_ANC_NOK"); ]]></script>
                <goto next="#VERS_BEB_FIXE_FASTR_ANC_NOK"/>        

            </if>

        </block>
    </form>
    
               
    <form id="CTRL_BEB_FIXE_FASTR_ANC">
        <script><![CDATA[ formCourant = "CTRL_BEB_FIXE_FASTR_ANC"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!--ELIGIBILITE BEB_FIXE_FASTR_ANC -->
            
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " isBEB_FIXE_FASTR_ANC()  "); ]]></script>
            <if cond=" isBEB_FIXE_FASTR_ANC()">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " isBEB_FIXE_FASTR_ANC() "); ]]></script>               	
	            <script><![CDATA[
		            customNode(applicationName + '_' + '40100_ADMIN_AUTRE_BEB_ANC_OK');			            
	            ]]></script>
	            
                <!--CTRL HO HNO de l'activité FASTR-->
                <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_ANC_OPEN &amp;&amp; CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_ANC_OPEN =='true'  "); ]]></script>
	            <if cond="CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_ANC_OPEN &amp;&amp; CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_ANC_OPEN =='true'  ">
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_ANC_OPEN &amp;&amp; CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_ANC_OPEN =='true' "); ]]></script>
	                <!--precision de l'origine de l'appel pour aiguillage sur le parcours BEB_FIXE -->
	                <script><![CDATA[
			            BEB_FIXE_FASTR_ORIGINE ='FIXE_ADMIN_BEB_FIXE_FASTR_ANC';
			            customNode(applicationName + '_' + '40200_ADMIN_AUTRE_BEB_ANC_HO');
		    			POSITION_ARBO = 132;
		    			log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);			            										
               		 ]]></script>
	                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	                <goto next="./FIXE_FLASH_INC.vxml"/>
             		              		                		 	                               		 	
	            <else/>
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
		            <script><![CDATA[
						customNode(applicationName + '_' + '40200_ADMIN_AUTRE_BEB_ANC_HNO');
		            ]]></script>    	                
	                <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_BEB_FIXE_FASTR_ANC_NOK"); ]]></script>
	                <goto next="#VERS_BEB_FIXE_FASTR_ANC_NOK"/>
	
	            </if> 
	             	            	                                                                    
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '40200_ADMIN_AUTRE_BEB_ANC_NOK');							            										
           		 ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_BEB_FIXE_FASTR_ANC_NOK"); ]]></script>
                <goto next="#VERS_BEB_FIXE_FASTR_ANC_NOK"/>                 
   
            </if>

        </block>
    </form>
    
