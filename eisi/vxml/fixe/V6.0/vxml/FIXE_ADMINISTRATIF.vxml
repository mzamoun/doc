    <!--###########################################
         TRAITEMENT MC_ACTIV
    ########################################### -->
    <form id="CTRL_MC_ACTIV">
        <script><![CDATA[ formCourant = "CTRL_MC_ACTIV"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>            
            <!--filtre MC_ACTIV desactivé-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.BEB_ACTIVATION == 'false'  "); ]]></script>
            <if cond="CUSTOMER_IHM.BEB_ACTIVATION == 'false'  ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.BEB_ACTIVATION == 'false'  "); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '40300_ADMIN_AUTRE_MC_ACTIV_OFF');
                ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "Retour_MC_ACTIV_KO"); ]]></script>
                <goto next="#Retour_MC_ACTIV_KO"/>
			    
            <!--Pre verification MC_ACTIV: filtre activé et offre ADSL ou CABLE ou THD (DEXTER) -->
            <elseif cond="CUSTOMER_IHM.BEB_ACTIVATION != 'false' &amp;&amp; isOFFRE_ELIG_MC_ACTIV_DEXTER()"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.BEB_ACTIVATION != 'false' &amp;&amp; isOFFRE_ELIG_MC_ACTIV_DEXTER() "); ]]></script>
                <!--precision de l'origine de l'appel pour aiguilaage à partir de la page MC_ACTIV -->
                <script><![CDATA[
		            FIXE_ORIGINE_MC_ACTIV ='ADMINISTRATIF';
                ]]></script>
                <script><![CDATA[ log_debug_assignment(pageCourante,'FIXE_ORIGINE_MC_ACTIV', FIXE_ORIGINE_MC_ACTIV); ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_MC_ACTIV.vxml"); ]]></script>
                <goto next="./FIXE_MC_ACTIV.vxml"/>    				               

			<!--Pre verification MC_ACTIV: KO -->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '40300_ADMIN_AUTRE_MC_ACTIV_NOK');
                ]]></script>                
                <script><![CDATA[ log_debug_next_form(pageCourante, "Retour_MC_ACTIV_KO"); ]]></script>
                <goto next="#Retour_MC_ACTIV_KO"/>

            </if>             

        </block>
    </form>

    <!-- ============================================================================== //-->
    <!-- MC_ACTIV ko: suite traitement ADMIN + point entree MC_ACTIV (KO) 				//-->
    <!-- ============================================================================== //-->
    <form id="Retour_MC_ACTIV_KO">
        <script><![CDATA[ formCourant = "Retour_MC_ACTIV_KO"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_CTRL_BEB_FIXE_FASTR_COM"); ]]></script>
            <goto next="#VERS_CTRL_BEB_FIXE_FASTR_COM"/>

        </block>  
    </form>         
    
    <!--###########################################
         TRAITEMENT BEB_FIXE_FASTR_COM
    ########################################### --> 
    <form id="VERS_CTRL_BEB_FIXE_FASTR_COM">
        <script><![CDATA[ formCourant = "VERS_CTRL_BEB_FIXE_FASTR_COM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!--FILTRE BEB_FIXE_COM actif-->
            
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.BEB_FIXE_FASTR_COM != 'false' "); ]]></script>
            <if cond="CUSTOMER_IHM.BEB_FIXE_FASTR_COM != 'false' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.BEB_FIXE_FASTR_COM != 'false' "); ]]></script>               	
	            <script><![CDATA[ log_debug_next_form(pageCourante, "CTRL_BEB_FIXE_FASTR_COM"); ]]></script>
	            <goto next="#CTRL_BEB_FIXE_FASTR_COM"/>
	            	             	            	                                                                    
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '40400_BEB_COM_FASTR_OFF');					
	            ]]></script>                
                <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_BEB_FIXE_FASTR_COM_NOK"); ]]></script>
                <goto next="#VERS_BEB_FIXE_FASTR_COM_NOK"/>        

            </if>

        </block>
    </form>  
         
    <form id="CTRL_BEB_FIXE_FASTR_COM">
        <script><![CDATA[ formCourant = "CTRL_BEB_FIXE_FASTR_COM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!--ELIGIBILITE BEB_FIXE_FASTR_COM -->
            
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isBEB_FIXE_FASTR_COM()  "); ]]></script>
            <if cond="isBEB_FIXE_FASTR_COM()">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isBEB_FIXE_FASTR_COM() "); ]]></script>               	
	            <script><![CDATA[
		            customNode(applicationName + '_' + '40400_BEB_COM_FASR_OK');			            
	            ]]></script>
	            
                <!--CTRL HO HNO de l'activité FASTR-->
                <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN &amp;&amp; CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN =='true' "); ]]></script>
	            <if cond="CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN &amp;&amp; CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN =='true' ">
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN &amp;&amp; CUSTOMER_BEB_FIXE_FASTR.BEB_FIXE_FASTR_COM_OPEN =='true'"); ]]></script>
	                <!--precision de l'origine de l'appel pour aiguillage sur le parcours BEB_FIXE -->
	                <script><![CDATA[
			            BEB_FIXE_FASTR_ORIGINE ='FIXE_GP_BEB_FIXE_FASTR_COM';
			            customNode(applicationName + '_' + '40400_BEB_COM_FIXE_HO');										
		    			POSITION_ARBO = 187;
		    			log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);			            										
               		 ]]></script>
	                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	                <goto next="./FIXE_FLASH_INC.vxml"/>               		              		                		 
	                               		 	
	            <else/>
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
		            <script><![CDATA[
						customNode(applicationName + '_' + '40400_BEB_COM_FIXE_HNO');
		            ]]></script>    	                
	                <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_BEB_FIXE_FASTR_COM_NOK"); ]]></script>
	                <goto next="#VERS_BEB_FIXE_FASTR_COM_NOK"/>
	
	            </if> 
	             	            	                                                                    
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '40400_BEB_COM_FASTR_NOK');					
	            ]]></script>                
	            <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_BEB_FIXE_FASTR_COM_NOK"); ]]></script>
	            <goto next="#VERS_BEB_FIXE_FASTR_COM_NOK"/>       

            </if>

        </block>
    </form>
    
