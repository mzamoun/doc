        </block>

    </form>             
 
   
    
    
    <!--########################################################################
                CTRL filtre LN_FULL (appel deja traite par LN_FUL) Et CTRL AB_TEST
        ######################################################################## -->    
    <form id="CTRL_LN_FULL_AB_TEST">  
        <script><![CDATA[ formCourant = "CTRL_LN_FULL_AB_TEST"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!--	TRT LN FIXE-FULL deja effectue		-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "GET_LN_ACTIVITE() == 'FIXE-FULL' &amp;&amp; CUSTOMER_CONTEXT_APPEL.Intent_elig_dtmf != 'true'"); ]]></script>
            <if cond="GET_LN_ACTIVITE() == 'FIXE-FULL' &amp;&amp; CUSTOMER_CONTEXT_APPEL.Intent_elig_dtmf != 'true' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "GET_LN_ACTIVITE() == 'FIXE-FULL' &amp;&amp; CUSTOMER_CONTEXT_APPEL.Intent_elig_dtmf != 'true'"); ]]></script>            	
	            <script><![CDATA[
					customNode(applicationName + '_' + '40400_LN_FULL_OUI');									
	            ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "SUITE_TRT_ADM_CO"); ]]></script>
	            <goto next="#SUITE_TRT_ADM_CO"/> 		                         	           

                <!-- MENU AB_TEST diffuse dans le parcours -->
            <elseif cond="AB_TEST_PARCOURS_ELIG =='1'"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "AB_TEST_PARCOURS_ELIG =='1'"); ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_LN_CO.vxml"); ]]></script>
                <goto next="./FIXE_LN_CO.vxml"/>
                	            
			<!--	Suite traitement		-->	            
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                
	            <script><![CDATA[ log_debug_next_form(pageCourante, "ADMIN_CTRL_MC_TECH"); ]]></script>
	            <goto next="#ADMIN_CTRL_MC_TECH"/>    
		            	                                      
            </if>
            
        </block>
    </form> 
        
    <!--###########################################
         Traitement MC (MC_TECH)
    ########################################### -->
