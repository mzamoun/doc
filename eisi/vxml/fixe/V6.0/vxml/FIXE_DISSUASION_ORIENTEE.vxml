<?xml version="1.0" encoding="ISO-8859-1"?>
<vxml version="2.1" xmlns="http://www.w3.org/2001/vxml" application="../../../root.vxml" xml:lang="fr-FR">

<!--
	Auteur :				IMA/CZO
	Date de Creation :		11/04/2018
	Page :                  Application FIXE - FIXE_DISSUASION_ORIENTEE
    Modification        	
							MZA		16/05/2018		migration v8
							IMA/CZO 06/05/2018		Prise en compte des données LDCCSU
    						IMA/CZO	05/07/2018		Menage des traitements SAFIR - full LDCCSU	
    						EISI	22/11/2018		Prise en compte de l'appel au WS MC_TECH 
                            IMA/CZO	17/01/2019		Integration CtrlHoHno sous appli FIXE_TECH  
                            IMA/CZO	01/03/2019		Suppression traitement RED 
                            IMA/CZO	22/12/2021		Integration traitement CARE 
                            IMA/CZO	04/03/2022		Ajout traitement RDGU + MAJ balises   						   	
							
-->
<script><![CDATA[
	applicationName = "FIXE"; appSvi = applicationName;
	var pageCourante = "FIXE_DISSUASION_ORIENTEE.vxml";
	log_info_start_page(pageCourante);
	var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
	var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
	var formCourant, menuCourant;
	var typeClient = "GP";
]]></script>

    <!--###########################################
        CTRL HOHNO FIXE_TECH
   ########################################### -->
    <form id="CTRL_HOHNO_FIXE_TECH">
        <script><![CDATA[ formCourant = "CTRL_HOHNO_FIXE_TECH"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>        
            <!--	SOUS APPLI FIXE_TECH HO  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " FIXE_TECH_IS_OPEN =='true' "); ]]></script>	
            <if cond=" FIXE_TECH_IS_OPEN =='true' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " FIXE_TECH_IS_OPEN =='true' "); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_IDO_TECH_HO'); 
                ]]></script>            	            	
				<script><![CDATA[ log_debug_next_form(pageCourante, "Filtre_RDGU"); ]]></script>
				<goto next="#Filtre_RDGU" />

            <!--	FIXE_TECH HNO  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_IDO_TECH_HNO'); 
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_HNO_TECH.vxml"); ]]></script>
                <goto next="./FIXE_HNO_TECH.vxml"/>

            </if>             

        </block>
    </form>
    
    <!--###########################################
                FILTRE RDGU
        ########################################### -->       
    <form id="Filtre_RDGU">
    	<script><![CDATA[ formCourant = "Filtre_RDGU"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <!--	Filtre RDGU desactive -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.RDGU == 'false'"); ]]></script>	            
            <if cond="CUSTOMER_IHM.RDGU == 'false' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.RDGU == 'false' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_IDO_TECH_RDGU_OFF');
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "SUITE_APPEL_IDO_NON_RDGU"); ]]></script>
	            <goto next="#SUITE_APPEL_IDO_NON_RDGU"/>                
                  
                
           <!--	Appel en provenance de RDGU  -->
            <elseif cond="is_provenance_rdgu()"/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "is_provenance_rdgu() "); ]]></script>                
	            <script><![CDATA[ log_debug_next_form(pageCourante, "SUITE_APPEL_IDO_RDGU"); ]]></script>
	            <goto next="#SUITE_APPEL_IDO_RDGU"/>                 
                                                                
               
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_IDO_TECH_RDGU_NOK');
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "SUITE_APPEL_IDO_NON_RDGU"); ]]></script>
	            <goto next="#SUITE_APPEL_IDO_NON_RDGU"/>                
            </if>                                   
                                         
        </block>
    </form> 
    
    
    <form id="SUITE_APPEL_IDO_RDGU">
    	<script><![CDATA[ formCourant = "SUITE_APPEL_IDO_RDGU"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <!-- Client RDGU -  FTTB 	-->                
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientFixeFTTB() "); ]]></script>
            <if cond="isClientFixeFTTB() ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTB() "); ]]></script>                                                                    
            
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_FTT_RDGU_DO_FTTB');
					ID_FLUX='FTT_PREMIUM_DO_FTTB_RDGU';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/> 


                <!-- Client RDGU  - FTTH -->
            <elseif cond="isClientFixeFTTH() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH() "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_FTT_RDGU_DO_FTTH');
					ID_FLUX='FTT_PREMIUM_DO_FTTH_RDGU';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/> 

                <!-- Client RDGU  - AUTRE-->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
	                customNode(applicationName + '_' + '10000_FTT_RDGU_DO_AUTRE');
					ID_FLUX='FTT_PREMIUM_DO_AUTRE_RDGU';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>  

            </if>                           
                                         
        </block>
    </form> 
    
        
    <form id="SUITE_APPEL_IDO_NON_RDGU">
    	<script><![CDATA[ formCourant = "SUITE_APPEL_IDO_NON_RDGU"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            <script><![CDATA[ log_debug_next_form(pageCourante, "FiltrePREMIUM"); ]]></script>
            <goto next="#FiltrePREMIUM"/>                                 
                                         
        </block>
    </form>    
    
	<!--###########################################
            Filtre PREMIUM 
	########################################### -->		
	<form id="FiltrePREMIUM">
		<script><![CDATA[ formCourant = "FiltrePREMIUM"; ]]></script>
		<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>       		
  			<!--	 (Premium via les données LDCCSU ou provenance RDGU ) -->      		        
        	<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium()"); ]]></script>	
        	<if cond="CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium()">
        		<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium()"); ]]></script>	
	        	<script><![CDATA[
					typeClient='PREMIUM';
				]]></script>	  
						
			<else />
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
				<script><![CDATA[
					typeClient='GP';
				]]></script>
				
			</if>
			<script><![CDATA[ log_debug_next_form(pageCourante, "Vers_STC_MC"); ]]></script>
			<goto next="#Vers_STC_MC" />
			
        </block>
     </form>    

	<!--####################################################
     	Traitement MC
    #################################################### -->	
	<form id="Vers_STC_MC">
		<script><![CDATA[ formCourant = "Vers_STC_MC"; ]]></script>
		<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
		<block> 
		
			<!-- MC_TECH  désactivé -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.MC_TECH == 'false' "); ]]></script>
            <if cond=" CUSTOMER_IHM.MC_TECH == 'false' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.MC_TECH == 'false' "); ]]></script>
                
            	<!-- PREMIUM-->
	        	<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " typeClient == 'PREMIUM' "); ]]></script>	
	        	<if cond=" typeClient == 'PREMIUM' ">
	        		<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " typeClient == 'PREMIUM' "); ]]></script>	
			    	<script><![CDATA[
						customNode(applicationName + '_' + '10000_MC_DO_PREMIUM_OFF');
					]]></script>
					<script><![CDATA[ log_debug_next_form(pageCourante, "VersFiltreClientPremium"); ]]></script>
					<goto next="#VersFiltreClientPremium" />	
				<!-- GP-->			
				<else />
					<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
			    	<script><![CDATA[
						customNode(applicationName + '_' + '10000_MC_DO_OFF');
					]]></script>
					<script><![CDATA[ log_debug_next_form(pageCourante, "Vers_CTRL_CLIENT_CARE"); ]]></script>
					<goto next="#Vers_CTRL_CLIENT_CARE" />
				</if>                
   	                         
             
			<!-- MC_TECH  ACTIV et WS MC_TECH OK -->	                      
            <elseif cond=" CUSTOMER_IHM.MC_TECH != 'false' &amp;&amp; isSTC_WS_MC()"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " CUSTOMER_IHM.MC_TECH != 'false' &amp;&amp; isSTC_WS_MC() "); ]]></script>

            	<!-- PREMIUM-->
	        	<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " typeClient == 'PREMIUM' "); ]]></script>	
	        	<if cond=" typeClient == 'PREMIUM' ">
	        		<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " typeClient == 'PREMIUM' "); ]]></script>	
		            <script><![CDATA[
						customNode(applicationName + '_' + '10000_MC_DO_PREMIUM_OK');
						POSITION_ARBO = 152;						
						log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
		            ]]></script>
		            	
				<!-- GP-->			
				<else />
					<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
		            <script><![CDATA[
						customNode(applicationName + '_' + '10041_MC_DO_OK');
						POSITION_ARBO = 148;						
						log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
		            ]]></script>		            					
					
				</if>

	           <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
		       <goto next="./FIXE_FLASH_INC.vxml"/> 
				
        
			<!-- STC NON ELIGIBLE-->		
			<else />
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
				
            	<!-- PREMIUM-->
	        	<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " typeClient == 'PREMIUM' "); ]]></script>	
	        	<if cond=" typeClient == 'PREMIUM' ">
	        		<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " typeClient == 'PREMIUM' "); ]]></script>	
			    	<script><![CDATA[
						customNode(applicationName + '_' + '10000_MC_DO_PREMIUM_NOK');
					]]></script>
					<script><![CDATA[ log_debug_next_form(pageCourante, "VersFiltreClientPremium"); ]]></script>
					<goto next="#VersFiltreClientPremium" />	
				<!-- GP-->			
				<else />
					<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
			    	<script><![CDATA[
						customNode(applicationName + '_' + '10000_MC_DO_NOK');
					]]></script>
					<script><![CDATA[ log_debug_next_form(pageCourante, "Vers_CTRL_CLIENT_CARE"); ]]></script>
					<goto next="#Vers_CTRL_CLIENT_CARE" />
				</if>												 
				
			</if>			
		</block>
	</form>
	
    <!-- Transfert  VERS PARCOURS MC  -->	
	<form id="VERS_PARCOURS_MC">
		<script><![CDATA[ formCourant = "VERS_PARCOURS_MC"; ]]></script>
		<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>			
        	<!-- PREMIUM-->
        	<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() "); ]]></script>	
        	<if cond=" CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() ">
        		<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() "); ]]></script>	
		    	<script><![CDATA[
					MC_APP_ORIGINE = 'FIXE_PRO_INCIDENT_O_WS';
					var nextAPP ="../../../mc/index.vxml";
				]]></script>
					
			<!-- GP-->			
			<else />
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
		    	<script><![CDATA[
					MC_APP_ORIGINE = 'FIXE_GP_INCIDENT_O_WS';
					var nextAPP ="../../../mc/index.vxml";
				]]></script>
				
			</if>
			<!-- Transfert vers le parcours MC -->				
			<script><![CDATA[ log_debug_next_page(pageCourante, nextAPP); ]]></script>
			<goto expr="nextAPP"/> 			
			      
        </block>
    </form>	
	
    <!-- Retour parcours MC  -->	
	<form id="Retour_MC">
		<script><![CDATA[ formCourant = "Retour_MC"; ]]></script>
		<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>			
        	<!-- PREMIUM-->
        	<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() "); ]]></script>	
        	<if cond=" CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() ">
        		<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " CUSTOMER_IHM.PREMIUM != 'false' &amp;&amp; is_premium() "); ]]></script>	
        		
				<script><![CDATA[ log_debug_next_form(pageCourante, "VersFiltreClientPremium"); ]]></script>
				<goto next="#VersFiltreClientPremium" />	
			<!-- GP-->			
			<else />
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
				
				<script><![CDATA[ log_debug_next_form(pageCourante, "Vers_CTRL_CLIENT_CARE"); ]]></script>
				<goto next="#Vers_CTRL_CLIENT_CARE" />
			</if>
			      
        </block>
    </form> 
 
 	<!--###########################################
     	Client PREMIUM
    ########################################### -->
    <form id="VersFiltreClientPremium">
        <script><![CDATA[ formCourant = "VersFiltreClientPremium"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>        
			<!-- Position  flash -->          		
            <script><![CDATA[
				POSITION_ARBO = 153;						
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
            ]]></script>
            
           <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	       <goto next="./FIXE_FLASH_INC.vxml"/>  
        </block>
    </form>    
        
    <form id="FiltreClientPremium">
    	<script><![CDATA[ formCourant = "FiltreClientPremium"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
		<block>	
			    
       
            <!-- CABLE et PACKPRO					  //-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientFixeFTTB()  &amp;&amp; FIXE_PACKPRO == 'true' "); ]]></script>
            <if cond="isClientFixeFTTB()  &amp;&amp; FIXE_PACKPRO == 'true'  ">            
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTB()  &amp;&amp; FIXE_PACKPRO == 'true' "); ]]></script>      
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_FTT_PACKPRO_DO_FTTB');
					ID_FLUX='FTT_PACKPRO_DO_FTTB';					
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                

            <!-- FTTH et PACKPRO					  //-->
            <elseif cond="isClientFixeFTTH() &amp;&amp; FIXE_PACKPRO == 'true' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH() &amp;&amp; FIXE_PACKPRO == 'true' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_FTT_PACKPRO_DO_FTTH');
					ID_FLUX='FTT_PACKPRO_DO_FTTH';					
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>                
                                 
            <!-- AUTRE	et PACKPRO					  //-->
            <elseif cond="FIXE_PACKPRO == 'true' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " FIXE_PACKPRO == 'true' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_FTT_PACKPRO_DO_AUTRE');
					ID_FLUX='FTT_PACKPRO_DO_AUTRE';					
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>         
                                        
               <!--	FIDE et CABLE		-->
            <elseif cond="FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; isClientFixeFTTB() &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true'  "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; isClientFixeFTTB() &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true'  "); ]]></script>
                <script><![CDATA[
					   customNode(applicationName + '_' + '10000_FTT_PREMIUM_DO_FTTB_FIDE');
					   ID_FLUX='FTT_PREMIUM_DO_FTTB_FIDE';		
					   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>

               <!--	FIDE et FTTH		-->
            <elseif cond="FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; isClientFixeFTTH() &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; isClientFixeFTTH() &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' "); ]]></script>
                <script><![CDATA[
					   customNode(applicationName + '_' + '10000_FTT_PREMIUM_DO_FTTH_FIDE');
					   ID_FLUX='FTT_PREMIUM_DO_FTTH_FIDE';		
					   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                
               <!--	FIDE - AUTRE		-->
            <elseif cond="FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true'  "); ]]></script>
                <script><![CDATA[
					   customNode(applicationName + '_' + '10000_FTT_PREMIUM_DO_AUTRE_FIDE');
					   ID_FLUX='FTT_PREMIUM_DO_AUTRE_FIDE';		
					   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
				
			<!--	FTTB		-->										
			<elseif cond="isClientFixeFTTB()" />
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTB()"); ]]></script>	
				<script><![CDATA[
				   customNode(applicationName + '_' + '10000_FTT_PREMIUM_DO_FTTB');
				   ID_FLUX='FTT_PREMIUM_DO_FTTB';		
				   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
				]]></script>			 
				 
			<!--	 FTTH		-->										      
			<elseif cond="isClientFixeFTTH()" />
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH()"); ]]></script>	
				<script><![CDATA[
				   customNode(applicationName + '_' + '10000_FTT_PREMIUM_DO_FTTH');
				   ID_FLUX='FTT_PREMIUM_DO_FTTH';		
				   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
				]]></script>				
																		          
	        <else />
	        	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
				<script><![CDATA[
					customNode(applicationName + '_' + '10000_FTT_PREMIUM_DO_AUTRE');
					ID_FLUX='FTT_PREMIUM_DO_AUTRE';	
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
				]]></script>
			</if>
			
			<script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
			<goto next="#Transfert"/> 	        		
		</block>
	</form>
	    
 	<!--###########################################
     	CTRL  CARE ET GP
    ########################################### -->
    <form id="Vers_CTRL_CLIENT_CARE">
        <script><![CDATA[ formCourant = "Vers_CTRL_CLIENT_CARE"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>        
			<!-- Position  flash -->          		
            <script><![CDATA[
				POSITION_ARBO = 149;						
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
            ]]></script>
            
           <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	       <goto next="./FIXE_FLASH_INC.vxml"/>  
        </block>
    </form>
       
    
    <form id="CTRL_CLIENT_CARE">
        <script><![CDATA[ formCourant = "CTRL_CLIENT_CARE"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
			<!-- CARE  desactive-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.CARE == 'false' "); ]]></script>
            <if cond=" CUSTOMER_IHM.CARE == 'false' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.CARE == 'false' "); ]]></script>
                
	            <script><![CDATA[
					customNode(applicationName + '_' + '10000_FTT_DO_CARE_OFF');													
	            ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_CLIENT_GP"); ]]></script>
	            <goto next="#VERS_CLIENT_GP"/>    	                         
             
			<!-- CARE  actif et eligible -->	                      
            <elseif cond=" CUSTOMER_IHM.CARE != 'false' &amp;&amp;  isCARE_FIXE()  "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " CUSTOMER_IHM.CARE != 'false' &amp;&amp;  isCARE_FIXE() "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_FTT_DO_CARE_OK');
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_CLIENT_CARE"); ]]></script>
	            <goto next="#VERS_CLIENT_CARE"/>                  
                	                     
            <!-- CARE NOK -->             
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>  
                
	            <script><![CDATA[
						customNode(applicationName + '_' + '10000_FTT_DO_CARE_NOK');												
	            ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_CLIENT_GP"); ]]></script>
	            <goto next="#VERS_CLIENT_GP"/>                  

                                
            </if>

        </block>

    </form>         
    
    
 	<!--###########################################
     	Client CARE 
    ########################################### --> 
    
    <form id="VERS_CLIENT_CARE">
        <script><![CDATA[ formCourant = "VERS_CLIENT_CARE"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				POSITION_ARBO = 150;
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);												
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>
        </block>

    </form>
    
	<form id="FiltreClientCare">
		<script><![CDATA[ formCourant = "FiltreClientCare"; ]]></script>
		<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>                        			
			<!-- Client FTTH ou  offre manuel THD--> 
			<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientFixeFTTH()  || OFFRE_MANUELLE == 'THD' "); ]]></script>	
			<if cond="isClientFixeFTTH()  || OFFRE_MANUELLE == 'THD' ">
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH()  || OFFRE_MANUELLE == 'THD' "); ]]></script>	
				<script><![CDATA[
					customNode(applicationName + '_' + '14000_FTT_DO_CARE_FTTH');
					ID_FLUX='FTT_DO_CARE_FTTH';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
				]]></script>        		
				<script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
				<goto next="#Transfert" />							
				
			<!-- Client FTTB	ou offre manuelle CABLE-->        
            <elseif cond="isClientFixeFTTB() || OFFRE_MANUELLE == 'CABLE' " />	
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTB() || OFFRE_MANUELLE == 'CABLE' "); ]]></script>	
				<script><![CDATA[
					customNode(applicationName + '_' + '14000_FTT_DO_CARE_FTTB');
					ID_FLUX='FTT_DO_CARE_FTTB';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
				]]></script>        		
				<script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
				<goto next="#Transfert" />							
							
			<else />
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
				<script><![CDATA[
					customNode(applicationName + '_' + '14000_FTT_DO_CARE_AUTRE');
					ID_FLUX='FTT_DO_CARE_AUTRE';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
				]]></script>        		
				<script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
				<goto next="#Transfert" />			

			</if>        
        </block>
    </form>    
         
    
 	<!--###########################################
     	Client GP
    ########################################### -->
    <form id="VERS_CLIENT_GP">
        <script><![CDATA[ formCourant = "VERS_CLIENT_GP"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '10040_CARE_TECH_OK');
				POSITION_ARBO = 151;
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);												
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>
        </block>

    </form>    
    
        
	<form id="FiltreClientGP">
		<script><![CDATA[ formCourant = "FiltreClientGP"; ]]></script>
		<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>			
			<!-- Client FTTH ou  offre manuel THD--> 
			<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientFixeFTTH()  || OFFRE_MANUELLE == 'THD' "); ]]></script>	
			<if cond="isClientFixeFTTH()  || OFFRE_MANUELLE == 'THD' ">
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH()  || OFFRE_MANUELLE == 'THD' "); ]]></script>	
				<script><![CDATA[
					customNode(applicationName + '_' + '14000_FTT_DO_FTTH');
					ID_FLUX='FTT_DO_FTTH';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
				]]></script>        		
				<script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
				<goto next="#Transfert" />							
				
			<!-- Client FTTB	ou offre manuelle CABLE-->        
            <elseif cond="isClientFixeFTTB() || OFFRE_MANUELLE == 'CABLE' " />	
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTB() || OFFRE_MANUELLE == 'CABLE' "); ]]></script>	
				<script><![CDATA[
					customNode(applicationName + '_' + '14000_FTT_DO_FTTB');
					ID_FLUX='FTT_DO_FTTB';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
				]]></script>        		
				<script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
				<goto next="#Transfert" />							
							
			<else />
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
				<script><![CDATA[
					customNode(applicationName + '_' + '14000_FTT_DO_AUTRE');
					ID_FLUX='FTT_DO_AUTRE';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
				]]></script>        		
				<script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
				<goto next="#Transfert" />			

			</if>        
        </block>
    </form>

 	<form id="Transfert">
 		<script><![CDATA[ formCourant = "Transfert"; ]]></script>
 		<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
	    <block>
	    	<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_TRANSFERT.vxml"); ]]></script>
	    	<goto next="./FIXE_TRANSFERT.vxml"/>	
	    </block>
	</form>   
    
</vxml>
