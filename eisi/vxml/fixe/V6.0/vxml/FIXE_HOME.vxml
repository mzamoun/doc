  <form id="RecoVocaleHome2">
		<!-- Voice grammar -->  
  	<script><![CDATA[ formCourant = "RecoVocaleHome2"; ]]></script>
  	<script><![CDATA[ menuCourant = "MENU_HOME_RECO_VOCALE_KO"; ]]></script>
  	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
  	<property name="timeout" value="3s" />
	<property name="inputmodes" value="voice"/>	
    <field name="inputVoc">
    	  
				
        <prompt bargein="true">
    		<audio maxage ="7200" maxstale="7200"  expr="PlayFileCommun(CUSTOMER_IHM.FIXE_MENU_HOME_RECO_VOCALE_KO_MENU_HOME_RECO_VOCALE_KO_AUDIO)"/>
        </prompt>
				
		<grammar type="application/srgs+xml" mode="voice" src="./FIXE_GRAMMAR_RECO_VOCALE.grxml"/> 
	  	
		<catch event="noinput nomatch">
			<script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + menuCourant + ":CHOIX", "NMNI"); ]]></script> 
			<script><![CDATA[ track_dtmfList (menuCourant,"NMNI"); ]]></script>		
            <script><![CDATA[
				customNode(applicationName + '_' + '00020_HOME_RECOVOCALE_KO2');
            ]]></script>					
                    
			<script><![CDATA[ log_debug_next_form(pageCourante, "MENU_HOME_DTMF"); ]]></script>
			<goto next="#MENU_HOME_DTMF"/>				
		</catch> 	
           			
		<filled>				
			<assign name="document.interpretation" expr="inputVoc$.interpretation"/>
			<script><![CDATA[ log_debug_assignment(pageCourante,"document.interpretation", document.interpretation); ]]></script>
			<assign name="document.confidence" expr="inputVoc$.confidence"/>
			<script><![CDATA[ log_debug_assignment(pageCourante,"document.confidence", document.confidence); ]]></script>
			<assign name="document.inputmode" expr="inputVoc$.inputmode"/>
			<script><![CDATA[ log_debug_assignment(pageCourante,"document.inputmode", document.inputmode); ]]></script>
			<assign name="document.utterance" expr="inputVoc$.utterance"/>
			<script><![CDATA[ log_debug_assignment(pageCourante,"document.utterance", document.utterance); ]]></script>			
			
			<assign name="inputVoc$.interpretation" expr="interpretationToObject(inputVoc$.interpretation)" />
	
          
	        <script><![CDATA[ log_debug_assignment(pageCourante,"filled : interpretation ===", inputVoc$.interpretation); ]]></script>
	        <script><![CDATA[ log_debug_assignment(pageCourante,"filled : dm_root ===", inputVoc$.interpretation.dm_root); ]]></script>
	        <script><![CDATA[ log_debug_assignment(pageCourante,"filled : dm_confirm_string ===", inputVoc$.interpretation.dm_confirm_string); ]]></script>
	        <script><![CDATA[ log_debug_assignment(pageCourante,"filled : dm_confirmation_mode ===", inputVoc$.interpretation.dm_confirmation_mode); ]]></script>
	        <script><![CDATA[ log_debug_assignment(pageCourante,"filled : SWI_meaning ===", inputVoc$.interpretation.SWI_meaning); ]]></script>
	        <script><![CDATA[ log_debug_assignment(pageCourante,"filled : MEANING ===", inputVoc$.interpretation.MEANING); ]]></script>


          	<assign name="choix_vocal_interpretation" expr="inputVoc$.utterance"/>
          	<script><![CDATA[ log_debug_assignment(pageCourante,"choix_vocal_interpretation", choix_vocal_interpretation); ]]></script>
			
			<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "application.lastresult$[0].confidence &lt; 0.75"); ]]></script>	
			<if cond="inputVoc$.confidence &lt; 0.75">
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "application.lastresult$[0].confidence &lt; 0.75"); ]]></script>	
				<script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + menuCourant + ":CHOIX", choix_vocal_interpretation); ]]></script> 
				<script><![CDATA[ track_dtmfList (menuCourant,choix_vocal_interpretation); ]]></script>
								
				<script><![CDATA[ log_debug_next_form(pageCourante, "MENU_HOME_DTMF"); ]]></script>
				<goto next="#MENU_HOME_DTMF"/>	
				
			<else/>
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
				<script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + menuCourant + ":CHOIX", choix_vocal_interpretation); ]]></script> 
				<script><![CDATA[ track_dtmfList (menuCourant,choix_vocal_interpretation); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '00020_HOME_RECOVOCALE_KO2');
	            ]]></script>						

				<script><![CDATA[ log_debug_next_form(pageCourante, "RouteVoice"); ]]></script>
