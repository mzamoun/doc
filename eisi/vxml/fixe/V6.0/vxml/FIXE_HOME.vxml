	<!--####################################
		Traitement reco vocale
	######################################## -->	
  <form id ="RouteVoice">			
    <block>
        <script><![CDATA[ formCourant = "RouteVoice"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>    
            
		 <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "choix_vocal_interpretation == 'home'  "); ]]></script>
		 <!--	Choix vocal: HOME   -->	
		 <if cond="choix_vocal_interpretation == 'home' ">
		 	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "choix_vocal_interpretation == 'home'  "); ]]></script>	
	            <script><![CDATA[
					customNode(applicationName + '_' + '00020_HOME_RECOVOCALE_REUSSIE');
	            	customNode(applicationName + '_' + '00020_HOME_RECOVOCALE_OK');
	            ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "CTRL_HOHNO_HOME_FTT"); ]]></script>
	            <goto next="#CTRL_HOHNO_HOME_FTT"/> 	

                <!--	Choix vocal: NON   -->
         <elseif cond="choix_vocal_interpretation == 'non' "/>
         	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " choix_vocal_interpretation == 'non' "); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '00020_HOME_RECOVOCALE_REUSSIE');
            	customNode(applicationName + '_' + '00020_HOME_RECOVOCALE_NON');
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_ENTREE_GP.vxml#VersTraitementClns"); ]]></script>
            <goto next="./FIXE_ENTREE_GP.vxml#VersTraitementClns"/>				
			
			<!--	cas par défaut   -->				
		 <else/>
			<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '00020_HOME_RECOVOCALE_KO2');
            ]]></script>				
			<script><![CDATA[ log_debug_next_form(pageCourante, "MENU_HOME_DTMF"); ]]></script>
			<goto next="#MENU_HOME_DTMF"/>	
							 
		 </if> 		

    </block>

  </form>
  
      
 
    <!--###########################################
                MENU HOME DTMF
        ########################################### -->
    <menu id="MENU_HOME_DTMF">
        <script><![CDATA[ formCourant = "MENU_HOME_DTMF"; ]]></script>
        <script><![CDATA[ menuCourant = formCourant; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <property name="timeout" value="5s"/>

        
        <prompt bargein="true">
    		<audio maxage ="7200" maxstale="7200"  expr="PlayFileCommun(CUSTOMER_IHM.FIXE_MENU_HOME_DTMF_MENU_HOME_DTMF_AUDIO)"/>
        </prompt>
                
        <catch event="noinput nomatch" >
            <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "noinput_nomatch"); ]]></script>
            <script><![CDATA[ track_dtmfList (formCourant,"NMNI"); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '00020_HOME_DTMF_NOK');
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_ENTREE_GP.vxml#VersTraitementClns"); ]]></script>
            <goto next="./FIXE_ENTREE_GP.vxml#VersTraitementClns"/>
        </catch>

        <choice dtmf="0" next="#Vers_HOME_FTT"/>
        
    </menu>

    <form id="Vers_HOME_FTT">
        <script><![CDATA[ formCourant = "Vers_HOME_FTT"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + "MENU_HOME_DTMF" + ":CHOIX", "0"); ]]></script>
        <script><![CDATA[ track_dtmfList ("MENU_HOME_DTMF", "0"); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '00020_HOME_DTMF_OK');
            ]]></script>
            
            <script><![CDATA[ log_debug_next_form(pageCourante, "CTRL_HOHNO_HOME_FTT"); ]]></script>
            <goto next="#CTRL_HOHNO_HOME_FTT"/>            
                         
        </block>
    </form>
    
    <form id="CTRL_HOHNO_HOME_FTT">
        <script><![CDATA[ formCourant = "CTRL_HOHNO_HOME_FTT"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
            
            <!--	SOUS APPLI FIXE_TECH HO  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " FIXE_TECH_IS_OPEN =='true' "); ]]></script>	
            <if cond=" FIXE_TECH_IS_OPEN =='true' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " FIXE_TECH_IS_OPEN =='true' "); ]]></script>	
	            <script><![CDATA[
					customNode(applicationName + '_' + '00020_HOME_FTT');
					POSITION_ARBO = 76;	 
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);           
					ID_FLUX='FTT_HOME';	
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
	            ]]></script>

	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/>

            <!--	FIXE_TECH HNO  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '00021_HOME_HNO_TECH');
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_HNO_TECH.vxml"); ]]></script>
                <goto next="./FIXE_HNO_TECH.vxml"/>

            </if> 
                        
        </block>
    </form>
        
</vxml>
