    <script><![CDATA[
		applicationName = "FIXE"; appSvi = applicationName;
		var pageCourante = "FIXE_HOME.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
    ]]></script>

    
    <!-- Cette fonction transforme le retour sémantique d'une grammaire DTMF
    en objet Ecmascript si celui-ci est une chaîne de caractère.
    Cette transformation est nécessaire car le moteur de reconnaissance 
    ne remonte qu'une chaîne de caractère en mode DTMF -->
    	
	<script><![CDATA[    
	    function interpretationToObject( interpretation ) {
	      if ( interpretation instanceof Object )
	      {
	        return interpretation;
	      }
	      else {
	        var regexp_quote = new RegExp( "'", "gi" );
	        
	        var dm_root_start_position = interpretation.indexOf( "dm_root=" );
	        var dm_root_end_position = interpretation.indexOf( ";", dm_root_start_position );
	        var dm_root_value = interpretation.substring( dm_root_start_position + 8, dm_root_end_position ).replace( regexp_quote, "" );
	        
	        var grammar_version_start_position = interpretation.indexOf( "grammar_version=" );
	        var grammar_version_end_position = interpretation.indexOf( ";", grammar_version_start_position );
	        var grammar_version_value = interpretation.substring( grammar_version_start_position + 16, grammar_version_end_position ).replace( regexp_quote, "" );
	        
	        var meaning_start_position = interpretation.indexOf( "MEANING=" );
	        var meaning_end_position = interpretation.indexOf( ";", meaning_start_position );
	        var meaning_value = interpretation.substring( meaning_start_position + 8, meaning_end_position ).replace( regexp_quote, "" );
	        
	        return {
	          dm_root: dm_root_value,
	          grammar_version: grammar_version_value,
	          dm_confirm_string: undefined,
	          dm_confirmation_mode: undefined,
	          MEANING: meaning_value
	        };
	      }
	    }
	    
	    	
	]]></script>

  <var name="confidence"/>
  <var name="utterance"/>
  <var name="interpretation"/>
  <var name="choix_vocal_interpretation" expr="''"/>
  <var name="errorCounter" expr="1"/>  
  
  <property name="com.genesyslab.asrengine" value="NUANCEASRT2"/>
    
  
  <form id ="VersRecoVocaleHome">
	<script><![CDATA[ formCourant = "VersRecoVocaleHome"; ]]></script>
	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
	<block>
		<script><![CDATA[
			customNode(applicationName + '_' + '00020_HOME_RECOVOCALE_TEST');
		]]></script>
		<script><![CDATA[ log_debug_next_form(pageCourante, "RecoVocaleHome"); ]]></script>
		<goto next="#RecoVocaleHome"/>
	</block>
  </form>

	<!--####################################
		MENU RECO VOCAL: 1ère tentative
	######################################## -->	      
  <form id="RecoVocaleHome">
		<!-- Voice grammar -->  
  	<script><![CDATA[ formCourant = "RecoVocaleHome"; ]]></script>
  	<script><![CDATA[ menuCourant = "MENU_HOME_RECO_VOCALE"; ]]></script>
  	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
  	<property name="timeout" value="3s" />
	<property name="inputmodes" value="voice"/>	
    <field name="inputVoc">
    	  
				
        <prompt bargein="true">
    		<audio maxage ="7200" maxstale="7200"  expr="PlayFileCommun(CUSTOMER_IHM.FIXE_MENU_HOME_RECO_VOCALE_MENU_HOME_RECO_VOCALE_AUDIO)"/>
        </prompt>
				
		<grammar type="application/srgs+xml" mode="voice" src="./FIXE_GRAMMAR_RECO_VOCALE.grxml"/> 
	  	
		<catch event="noinput nomatch">
			<script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "NMNI"); ]]></script> 
			<script><![CDATA[ track_dtmfList (menuCourant,"NMNI"); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '00020_HOME_RECOVOCALE_KO');
            ]]></script>			
	                     
			<script><![CDATA[ log_debug_next_form(pageCourante, "VersRecoVocaleHome2"); ]]></script>
			<goto next="#VersRecoVocaleHome2"/>				
		</catch> 	
           			
		<filled>				
			<assign name="document.interpretation" expr="inputVoc$.interpretation"/>
			<script><![CDATA[ log_debug_assignment(pageCourante,"document.interpretation", document.interpretation); ]]></script>
			<assign name="document.confidence" expr="inputVoc$.confidence"/>
			<script><![CDATA[ log_debug_assignment(pageCourante,"document.confidence", document.confidence); ]]></script>
			<assign name="document.inputmode" expr="inputVoc$.inputmode"/>
			<script><![CDATA[ log_debug_assignment(pageCourante,"document.inputmode", document.inputmode); ]]></script>
			<assign name="document.utterance" expr="inputVoc$.utterance"/>
			<script><![CDATA[ log_debug_assignment(pageCourante,"document.utterance", document.utterance); ]]></script>			
			
			<assign name="inputVoc$.interpretation" expr="interpretationToObject(inputVoc$.interpretation)" />
	
          
	        <script><![CDATA[ log_debug_assignment(pageCourante,"filled : interpretation ===", inputVoc$.interpretation); ]]></script>
	        <script><![CDATA[ log_debug_assignment(pageCourante,"filled : dm_root ===", inputVoc$.interpretation.dm_root); ]]></script>
	        <script><![CDATA[ log_debug_assignment(pageCourante,"filled : dm_confirm_string ===", inputVoc$.interpretation.dm_confirm_string); ]]></script>
	        <script><![CDATA[ log_debug_assignment(pageCourante,"filled : dm_confirmation_mode ===", inputVoc$.interpretation.dm_confirmation_mode); ]]></script>
	        <script><![CDATA[ log_debug_assignment(pageCourante,"filled : SWI_meaning ===", inputVoc$.interpretation.SWI_meaning); ]]></script>
	        <script><![CDATA[ log_debug_assignment(pageCourante,"filled : MEANING ===", inputVoc$.interpretation.MEANING); ]]></script>


          	<assign name="choix_vocal_interpretation" expr="inputVoc$.utterance"/>
          	<script><![CDATA[ log_debug_assignment(pageCourante,"choix_vocal_interpretation", choix_vocal_interpretation); ]]></script>
			
			<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "application.lastresult$[0].confidence &lt; 0.75"); ]]></script>	
			<if cond="inputVoc$.confidence &lt; 0.75">
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "application.lastresult$[0].confidence &lt; 0.75"); ]]></script>	
				<script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + menuCourant + ":CHOIX", choix_vocal_interpretation); ]]></script> 
				<script><![CDATA[ track_dtmfList (menuCourant,choix_vocal_interpretation); ]]></script>				
	            <script><![CDATA[
					customNode(applicationName + '_' + '00020_HOME_RECOVOCALE_KO');
	            ]]></script>					
				
				<script><![CDATA[ log_debug_next_form(pageCourante, "VersRecoVocaleHome2"); ]]></script>
				<goto next="#VersRecoVocaleHome2"/>	
				
			<else/>
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
				<script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + menuCourant + ":CHOIX", choix_vocal_interpretation); ]]></script> 
				<script><![CDATA[ track_dtmfList (menuCourant,choix_vocal_interpretation); ]]></script>						
				
				<script><![CDATA[ log_debug_next_form(pageCourante, "RouteVoice"); ]]></script>
				<goto next="#RouteVoice"/>					 
			</if>                           
		</filled>  
	</field>

  </form>

	<!--####################################
		MENU RECO VOCAL: 2eme tentative
	######################################## -->
  <form id ="VersRecoVocaleHome2">
	<script><![CDATA[ formCourant = "VersRecoVocaleHome2"; ]]></script>
	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
	<block>
		<script><![CDATA[
			customNode(applicationName + '_' + '00020_HOME_RECOVOCALE_TEST2');
