                CTRL filtre FTT_TECH
        ########################################### -->  
            
    <form id="CTRL_FILTRE_FTT_TECH">
        <script><![CDATA[ formCourant = "CTRL_FILTRE_FTT_TECH"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!--	filtre FTT_TECH activé		-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.FTT_TECH != 'false'"); ]]></script>
            <if cond="CUSTOMER_IHM.FTT_TECH != 'false' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.FTT_TECH != 'false'"); ]]></script>            	
	            <script><![CDATA[
					customNode(applicationName + '_' + '20000_FTT_TECH_OK');									
	            ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Retour_TechAutre"); ]]></script>
	            <goto next="#Retour_TechAutre"/> 	                         	           

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '20000_FTT_TECH_MENU_CHOIX'); 									
	            ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "MENU_TECH"); ]]></script>
	            <goto next="#MENU_TECH"/>               
            </if>
            
        </block>
    </form>              

    <!--###########################################
                Menu TECHNIQUE
        ########################################### -->

    <menu id="MENU_TECH">
        <script><![CDATA[ formCourant = "MENU_TECH"; ]]></script>
        <script><![CDATA[ menuCourant = formCourant; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <property name="timeout" value="3s"/>
        <prompt bargein="true">
    		<audio maxage="7200" maxstale="7200" expr="PlayFileCommun(CUSTOMER_IHM.FIXE_MENU_TECHNIQUE_MENU_TECHNIQUE_AUDIO)"/>
        </prompt>         

        <catch event="noinput nomatch" cond="document.errorCounter &lt; 2">
            <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "noinput_nomatch"); ]]></script>
            <script><![CDATA[ track_dtmfList (formCourant,"NMNI"); ]]></script>
            <assign name="document.errorCounter" expr="document.errorCounter + 1"/>
            <script><![CDATA[ log_debug_assignment(pageCourante,"document.errorCounter", document.errorCounter); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '20040_TECH_NMNI');				
            ]]></script>
            <prompt>
                <audio expr="PlayGenericAudio('ERREUR_SAISIE_NOUVEAU')"/>
            </prompt>
            <reprompt/>
        </catch>
        <catch event="noinput nomatch" cond="document.errorCounter == 2">
            <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "noinput_nomatch"); ]]></script>
            <script><![CDATA[ track_dtmfList (formCourant,"NMNI2"); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '20040_TECH_NMNI_X2');
				POSITION_ARBO = 11;				
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>
        </catch>

        <choice dtmf="1" next="#VersAccesInternet"/>
        <choice dtmf="2" next="#VersTV"/>
        <choice dtmf="3" next="#VersTechAutre"/>
    </menu>

    <!--###########################################
        Choix 1: Acces Internet
   ########################################### -->
    <form id="VersAccesInternet">
        <script><![CDATA[ formCourant = "VersAccesInternet"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "1"); ]]></script>
        <script><![CDATA[ track_dtmfList ("MENU_TECH", "1"); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '21000_TECH_INTERNET');			
            ]]></script>
            <script><![CDATA[				
				<!--POSITION_INCIDENT_HEIMDALL = liste ('position|balise|page_suivante|form suivant') -->				
				POSITION_INCIDENT_HEIMDALL = '2|21000_TECH_INTERNET|FLASH_INC|;';
				log_debug_assignment(pageCourante, "POSITION_INCIDENT_HEIMDALL", POSITION_INCIDENT_HEIMDALL);						
			]]></script>            

			<!-- Position  flash -->          		
            <script><![CDATA[
				POSITION_ARBO = 9;						
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
            ]]></script>
            
			<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_INCIDENT_INC.vxml"); ]]></script>
			<goto next="./FIXE_INCIDENT_INC.vxml"/>
        </block>
    </form>

    <form id="Retour_AccesInternet">
        <script><![CDATA[ formCourant = "Retour_AccesInternet"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!-- Client FTTH ou  offre manuel THD-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientFixeFTTH()  || OFFRE_MANUELLE == 'THD' "); ]]></script>
            <if cond="isClientFixeFTTH()  || OFFRE_MANUELLE == 'THD' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH()  || OFFRE_MANUELLE == 'THD' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '21000_FTT_INT_FTTH');
					ID_FLUX='FTT_FTTH';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>


                <!-- Client FTTB	ou offre manuelle CABLE-->
            <elseif cond="isClientFixeFTTB() || OFFRE_MANUELLE == 'CABLE'"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTB() || OFFRE_MANUELLE == 'CABLE'"); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '21000_FTT_INT_FTTB');
					ID_FLUX='FTT_FTTB';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '21000_FTT_INT');
					ID_FLUX='FTT_AUTRE';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>

            </if>
        </block>
    </form>

    <!--###########################################
        Choix 2: Tech TV
   ########################################### -->
    <form id="VersTV">
        <script><![CDATA[ formCourant = "VersTV"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "2"); ]]></script>
        <script><![CDATA[ track_dtmfList ("MENU_TECH", "2"); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '22000_TECH_TELEVISION');			
            ]]></script>
            <script><![CDATA[				
				<!--POSITION_INCIDENT_HEIMDALL = liste ('position|balise|page_suivante|form suivant') -->				
				POSITION_INCIDENT_HEIMDALL = '3|22000_TECH_TELEVISION|FLASH_INC|;';
				log_debug_assignment(pageCourante, "POSITION_INCIDENT_HEIMDALL", POSITION_INCIDENT_HEIMDALL);						
			]]></script>            

			<!-- Position  flash -->           		
            <script><![CDATA[
				POSITION_ARBO = 10;						
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
            ]]></script>
            
			<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_INCIDENT_INC.vxml"); ]]></script>
			<goto next="./FIXE_INCIDENT_INC.vxml"/>
        </block>
    </form>

    <form id="Retour_TV">
        <script><![CDATA[ formCourant = "Retour_TV"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!-- Client FTTH ou  offre manuel THD-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " isClientFixeFTTH()  || OFFRE_MANUELLE == 'THD' "); ]]></script>
            <if cond=" isClientFixeFTTH()  || OFFRE_MANUELLE == 'THD' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " isClientFixeFTTH()  || OFFRE_MANUELLE == 'THD' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '22000_FTT_TV_FTTH');
					ID_FLUX='FTT_FTTH';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>


                <!-- Client FTTB	ou offre manuelle CABLE-->
            <elseif cond="isClientFixeFTTB() || OFFRE_MANUELLE == 'CABLE' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTB() || OFFRE_MANUELLE == 'CABLE' "); ]]></script>
                <script><![CDATA[
				customNode(applicationName + '_' + '22000_FTT_TV_FTTB');
				ID_FLUX='FTT_FTTB';
				log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '22000_FTT_TV');
					ID_FLUX='FTT_AUTRE';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>

            </if>
        </block>
    </form>

    <!--###########################################
    Choix 3: Tech AUTRE
    ########################################### -->
    <form id="VersTechAutre">
        <script><![CDATA[ formCourant = "VersTechAutre"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "3"); ]]></script>
        <script><![CDATA[ track_dtmfList ("MENU_TECH", "3"); ]]></script>
        <block>
            <script><![CDATA[
					customNode(applicationName + '_' + '23000_TECH_AUTRE');
            ]]></script>
            <script><![CDATA[				
				<!--POSITION_INCIDENT_HEIMDALL = liste ('position|balise|page_suivante|form suivant') -->				
				POSITION_INCIDENT_HEIMDALL = '4|23000_TECH_AUTRE|FLASH_INC|;';
				log_debug_assignment(pageCourante, "POSITION_INCIDENT_HEIMDALL", POSITION_INCIDENT_HEIMDALL);						
			]]></script>            

			<!-- Position  flash -->            		
            <script><![CDATA[
				POSITION_ARBO = 11;					
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
            ]]></script>
            
			<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_INCIDENT_INC.vxml"); ]]></script>
			<goto next="./FIXE_INCIDENT_INC.vxml"/>
        </block>
    </form>

    <form id="Retour_TechAutre">
        <script><![CDATA[ formCourant = "Retour_TechAutre"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
	        <!--	TRT LN FIXE-FULL ou CO	et flux de routage LN existants	-->
	        <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "IS_LN_QUALIFIE_AND_FLUX_RTG_VALIDE()"); ]]></script>
	        <if cond="IS_LN_QUALIFIE_AND_FLUX_RTG_VALIDE()  ">
	        	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "IS_LN_QUALIFIE_AND_FLUX_RTG_VALIDE()"); ]]></script>            	
	            <script><![CDATA[
					customNode(applicationName + '_' + '23000_LN_FTT_'+ LN_CATEGORY +'_'+ LN_INTENT );
						<!-- FLUX de routage associe LN - intention/category/techno  -->
					ID_FLUX=LN_FLUX_ROUTAGE;
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
	            ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
	            <goto next="#Transfert"/>  
	            
	           
	        <!--	vers transfert des cas en dehors du LN - suivant techno -->
	        <else/>
	        	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
	            
	            <!-- Client THD** ou  offre manuel THD-->
	            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientFixeFTTH() || OFFRE_MANUELLE == 'THD' "); ]]></script>
	            <if cond="isClientFixeFTTH() || OFFRE_MANUELLE == 'THD' ">
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH() || OFFRE_MANUELLE == 'THD' "); ]]></script>
	                <script><![CDATA[
							customNode(applicationName + '_' + '23000_FTT_AUTRE_FTTH');
							ID_FLUX='FTT_FTTH';
							log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
	                ]]></script>
	                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
	                <goto next="#Transfert"/>
	
	
	                <!-- Client CABLE	ou offre manuelle CABLE-->
	            <elseif cond=" isClientFixeFTTB()|| OFFRE_MANUELLE == 'CABLE' "/>
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " isClientFixeFTTB()|| OFFRE_MANUELLE == 'CABLE' "); ]]></script>
	                <script><![CDATA[
							customNode(applicationName + '_' + '23000_FTT_AUTRE_FTTB');
							ID_FLUX='FTT_FTTB';
							log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
	                ]]></script>
	                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
	                <goto next="#Transfert"/>
	
	            <else/>
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
	                <script><![CDATA[
							customNode(applicationName + '_' + '23000_FTT_AUTRE');
							ID_FLUX='FTT_AUTRE';
							log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
	                ]]></script>
	                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
	                <goto next="#Transfert"/>
	
	            </if>
	
	        </if> 
        </block>
    </form>


    <form id="Transfert">
        <script><![CDATA[ formCourant = "Transfert"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_TRANSFERT.vxml"); ]]></script>
            <goto next="./FIXE_TRANSFERT.vxml"/>
        </block>
    </form>

</vxml>
