    <!-- ======================================================= //-->
    <!-- PRE TRAITEMENT voix (ECOTEL)	//-->
    <!-- ======================================================= //-->
    <form id="VersPreTraitementVoix">
        <script><![CDATA[ formCourant = "VersPreTraitementVoix"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " CUSTOMER_IHM.MARQUEUR_C2OL != 'false' &amp;&amp; isIDCSU() "); ]]></script>
            <if cond=" CUSTOMER_IHM.MARQUEUR_C2OL != 'false' &amp;&amp; isIDCSU() ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " CUSTOMER_IHM.MARQUEUR_C2OL != 'false' &amp;&amp; isIDCSU() "); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "PreTraitementVoix"); ]]></script>
                <goto next="#PreTraitementVoix"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					FIXE_MARQUEUR_ECOTEL_SVI = 'false';
					log_debug_assignment(pageCourante,'FIXE_MARQUEUR_ECOTEL_SVI', FIXE_MARQUEUR_ECOTEL_SVI);
                ]]></script>

                <script><![CDATA[ log_debug_next_form(pageCourante, "FiltreDexterEcotel"); ]]></script>
                <goto next="#FiltreDexterEcotel"/>
            </if>
        </block>
    </form>

    <!--PRE TRAITEMENT ECOTEL -->
    <form id="PreTraitementVoix">
        <script><![CDATA[ formCourant = "PreTraitementVoix"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[
			var id_csu = IDCSU;
			var searchMarker = 'ECOTEL_SVI';     
        ]]></script>
        <script><![CDATA[ log_debug_appel_web_app(pageCourante, 'BDDClientFIND_CLIENT', subdialogWS_FIND_CLIENT , 'id_csu=' + id_csu +'|searchMarker=' + searchMarker ); ]]></script>
        <subdialog name="BDDClientFIND_CLIENT"
                   srcexpr="subdialogWS_FIND_CLIENT"
                   namelist="id_csu searchMarker"
                   method="get"
                   fetchtimeout="5s"
                   fetchaudio="../../../audio/Attente.wav"/>

        <catch event="error">
            <script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '80001_C2OL_FIND_CLIENT_HS');
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "FiltreDexterEcotel"); ]]></script>
            <goto next="#FiltreDexterEcotel"/>
        </catch>

        <block>
            <script><![CDATA[ log_debug_result_web_app(pageCourante, 'BDDClientFIND_CLIENT', BDDClientFIND_CLIENT ); ]]></script>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " BDDClientFIND_CLIENT.APP_STATUS == 'NOK' || BDDClientFIND_CLIENT.WS_FIND_CLIENT_STATUS == 'NOK' "); ]]></script>
            <if cond=" BDDClientFIND_CLIENT.APP_STATUS == 'NOK' || BDDClientFIND_CLIENT.WS_FIND_CLIENT_STATUS == 'NOK' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " BDDClientFIND_CLIENT.APP_STATUS == 'NOK' || BDDClientFIND_CLIENT.WS_FIND_CLIENT_STATUS == 'NOK' "); ]]></script>
                <script><![CDATA[ log_appel_web_app_nok(pageCourante, 'BDDClientFIND_CLIENT', subdialogWS_FIND_CLIENT , 'id_csu=' + id_csu +'|searchMarker=' + searchMarker ); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "FiltreDexterEcotel"); ]]></script>
                <goto next="#FiltreDexterEcotel"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <assign name="CUSTOMER_FIND_CLIENT_MARKER" expr="BDDClientFIND_CLIENT"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"CUSTOMER_FIND_CLIENT_MARKER", CUSTOMER_FIND_CLIENT_MARKER); ]]></script>

            </if>

            <!--	MARQUEUR ECOTEL    -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_FIND_CLIENT_MARKER.MARKER_FOUND == 'true' "); ]]></script>
            <if cond="CUSTOMER_FIND_CLIENT_MARKER.MARKER_FOUND == 'true' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_FIND_CLIENT_MARKER.MARKER_FOUND == 'true' "); ]]></script>
                <script><![CDATA[
					FIXE_MARQUEUR_ECOTEL_SVI = 'true';
					log_debug_assignment(pageCourante,'FIXE_MARQUEUR_ECOTEL_SVI', FIXE_MARQUEUR_ECOTEL_SVI);				
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "FiltreDexterEcotel"); ]]></script>
                <goto next="#FiltreDexterEcotel"/>

            <!--	Cas par défaut  -->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "FiltreDexterEcotel"); ]]></script>
                <goto next="#FiltreDexterEcotel"/>
            </if>

        </block>
    </form>
    
    <!--###########################################
        Client DEXTER ECOTEL
    ########################################### -->
    <form id="FiltreDexterEcotel">
        <script><![CDATA[ formCourant = "FiltreDexterEcotel"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
        
            <!-- Client ECOTEL DEXTER	-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "is_ecotel_dexter() &amp;&amp; FIXE_MARQUEUR_ECOTEL_SVI == 'true'"); ]]></script>
            <if cond="is_ecotel_dexter() &amp;&amp; FIXE_MARQUEUR_ECOTEL_SVI == 'true' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "is_ecotel_dexter() &amp;&amp; FIXE_MARQUEUR_ECOTEL_SVI == 'true'"); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '20040_FTT_VOIX');
					ID_FLUX='FTT_VOIX';				
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>                       
	                             
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>

                <script><![CDATA[ log_debug_next_form(pageCourante, "TYPE_CLIENT"); ]]></script>
                <goto next="#TYPE_CLIENT"/>
            </if>
        </block>
    </form>    
    

        
    <!-- Type Client   -->
    <form id="TYPE_CLIENT">
        <script><![CDATA[ formCourant = "TYPE_CLIENT"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!--	FTTH   -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientFixeFTTH()"); ]]></script>
            <if cond="isClientFixeFTTH()">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH()"); ]]></script>
                <script><![CDATA[
						customNode(applicationName + '_' + '20040_FTT_FTTH');			
                ]]></script>

                <!-- filtre ALERTE_ARBEO_FTTH activé -->
                <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.ALERTE_ARBEO_FTTH != 'false' "); ]]></script>
                <if cond="CUSTOMER_IHM.ALERTE_ARBEO_FTTH != 'false' ">
                    <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.ALERTE_ARBEO_FTTH != 'false' "); ]]></script>
                    <script><![CDATA[
							customNode(applicationName + '_' + '20040_ARBEO_FTTH_OK');
							typeLigneSigma ='FTTH';			
                    ]]></script>
                    <script><![CDATA[ log_debug_assignment(pageCourante,'typeLigneSigma', typeLigneSigma); ]]></script>
                    <script><![CDATA[ log_debug_next_form(pageCourante, "VersTEST_ARBEO"); ]]></script>
                    <goto next="#VersTEST_ARBEO"/>

                <else/>
                    <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                    <script><![CDATA[ log_debug_next_form(pageCourante, "SUITE_TRT_TECH_SANS_ARBEO"); ]]></script>
                    <goto next="#SUITE_TRT_TECH_SANS_ARBEO"/>

                </if>

                <!--	ADSL   -->
            <elseif cond="isClientFixeADSL()"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeADSL()"); ]]></script>
                <script><![CDATA[
						customNode(applicationName + '_' + '20040_FTT_ADSL');			
                ]]></script>
                <!-- filtre ALERTE_ARBEO_ADSL activé -->
                <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.ALERTE_ARBEO_ADSL != 'false' "); ]]></script>
                <if cond="CUSTOMER_IHM.ALERTE_ARBEO_ADSL != 'false' ">
                    <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.ALERTE_ARBEO_ADSL != 'false' "); ]]></script>
                    <script><![CDATA[
							customNode(applicationName + '_' + '20040_ARBEO_ADSL_OK');	
							typeLigneSigma ='ADSL';					
                    ]]></script>
                    <script><![CDATA[ log_debug_assignment(pageCourante,'typeLigneSigma', typeLigneSigma); ]]></script>
                    <script><![CDATA[ log_debug_next_form(pageCourante, "VersTEST_ARBEO"); ]]></script>
                    <goto next="#VersTEST_ARBEO"/>

                <else/>
                    <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                    <script><![CDATA[ log_debug_next_form(pageCourante, "SUITE_TRT_TECH_SANS_ARBEO"); ]]></script>
                    <goto next="#SUITE_TRT_TECH_SANS_ARBEO"/>

                </if>

                <!--	FTTB   -->
            <elseif cond="isClientFixeFTTB()"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTB()"); ]]></script>
                <script><![CDATA[
						customNode(applicationName + '_' + '20040_FTT_FTTB');			
                ]]></script>

                <!-- filtre ALERTE_ARBEO_FTTB activé -->
                <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.ALERTE_ARBEO_FTTB != 'false' "); ]]></script>
                <if cond="CUSTOMER_IHM.ALERTE_ARBEO_FTTB != 'false' ">
                    <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.ALERTE_ARBEO_FTTB != 'false' "); ]]></script>
                    <script><![CDATA[
							customNode(applicationName + '_' + '20040_ARBEO_FTTB_OK');
							typeLigneSigma ='FTTB';						
                    ]]></script>
                    <script><![CDATA[ log_debug_assignment(pageCourante,'typeLigneSigma', typeLigneSigma); ]]></script>
                    <script><![CDATA[ log_debug_next_form(pageCourante, "VersTEST_ARBEO"); ]]></script>
                    <goto next="#VersTEST_ARBEO"/>

                <else/>
                    <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                    <script><![CDATA[ log_debug_next_form(pageCourante, "SUITE_TRT_TECH_SANS_ARBEO"); ]]></script>
                    <goto next="#SUITE_TRT_TECH_SANS_ARBEO"/>

                </if>

                <!--	AUTRE   -->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '20040_FTT_AUTRE');			
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "SUITE_TRT_TECH_SANS_ARBEO"); ]]></script>
                <goto next="#SUITE_TRT_TECH_SANS_ARBEO"/>

            </if>
        </block>
    </form>

    <!--###########################################
         APPEL ARBEO - PREDIAGV2
    ########################################### -->

    <form id="VersTEST_ARBEO">
        <script><![CDATA[ formCourant = "VersTEST_ARBEO"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " controlNdiFixe(NDI)=='true' "); ]]></script>
            <if cond="controlNdiFixe(NDI)=='true'">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "controlNdiFixe(NDI)=='true' "); ]]></script>
                       
