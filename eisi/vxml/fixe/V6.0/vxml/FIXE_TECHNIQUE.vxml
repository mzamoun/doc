    <form id="TEST_ARBEO">
        <script><![CDATA[ formCourant = "TEST_ARBEO"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[
			var ndi = NDI;
			var typeLigne = typeLigneSigma ;
        ]]></script>
        <script><![CDATA[ log_debug_appel_web_app(pageCourante, 'WS_BOX_SIGMAGP_ARBEO', subdialogWS_BOX_SIGMAGP_ARBEO , 'ndi=' + ndi +'|typeLigne=' + typeLigne ); ]]></script>
        <subdialog name="WS_BOX_SIGMAGP_ARBEO"
                   srcexpr="subdialogWS_BOX_SIGMAGP_ARBEO"
                   namelist="ndi typeLigne"
                   method="get"
                   fetchtimeout="10s"
                   fetchaudio="../../../audio/Attente.wav"/>

        <catch event="error">
            <script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '80001_ARBEO_WS_HS');
				customNode(applicationName + '_' + '20040_ARBEO_WS_HS');
            ]]></script>
           	<script><![CDATA[ log_debug_next_form(pageCourante, "SUITE_TRT_TECH_SANS_ARBEO"); ]]></script>
            <goto next="#SUITE_TRT_TECH_SANS_ARBEO"/>
        </catch>

        <block>
            <script><![CDATA[ log_debug_result_web_app(pageCourante, 'WS_BOX_SIGMAGP_ARBEO', WS_BOX_SIGMAGP_ARBEO ); ]]></script>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " WS_BOX_SIGMAGP_ARBEO.APP_STATUS == 'NOK' || WS_BOX_SIGMAGP_ARBEO.WS_SIGMA_ARBEO_STATUS == 'NOK' "); ]]></script>
            <if cond=" WS_BOX_SIGMAGP_ARBEO.APP_STATUS == 'NOK' || WS_BOX_SIGMAGP_ARBEO.WS_SIGMA_ARBEO_STATUS == 'NOK' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " WS_BOX_SIGMAGP_ARBEO.APP_STATUS == 'NOK' || WS_BOX_SIGMAGP_ARBEO.WS_SIGMA_ARBEO_STATUS == 'NOK' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '20040_ARBEO_WS_KO');
                ]]></script>

                <!--	gestion des stat des erreurs WS ARBEO -->
                <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " WS_BOX_SIGMAGP_ARBEO.CODEERREURWS   &amp;&amp; WS_BOX_SIGMAGP_ARBEO.CODEERREURWS != 'undefined' "); ]]></script>
                <if cond=" WS_BOX_SIGMAGP_ARBEO.CODEERREURWS  &amp;&amp; WS_BOX_SIGMAGP_ARBEO.CODEERREURWS != 'undefined' ">
                    <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " WS_BOX_SIGMAGP_ARBEO.CODEERREURWS   &amp;&amp; WS_BOX_SIGMAGP_ARBEO.CODEERREURWS != 'undefined' "); ]]></script>
                    <script><![CDATA[
						customNode(applicationName + '_' + '20040_ARBEO_WS_KO_CODEERREURWS_'+ WS_BOX_SIGMAGP_ARBEO.CODEERREURWS);
						customNode(applicationName + '_' + '20040_ARBEO_WS_KO_LIBELLEERREURWS_'+ WS_BOX_SIGMAGP_ARBEO.LIBELLEERREURWS);
                    ]]></script>
                </if>
	           	<script><![CDATA[ log_debug_next_form(pageCourante, "SUITE_TRT_TECH_SANS_ARBEO"); ]]></script>
	            <goto next="#SUITE_TRT_TECH_SANS_ARBEO"/>                

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '20040_ARBEO_WS_OK');
