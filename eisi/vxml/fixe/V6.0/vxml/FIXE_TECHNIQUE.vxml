    <!--
        Auteur :				IMA
        Date de Creation :		12/03/2013
        Page :                  Application FIXE (FCT) - TECHNIQUE
        Modification        	IMA		10/05/2013		   Intégration des appels en provenance de RDGU
                                IMA		14/01/2014		   Ré ordonner les filtres et la position de l'incident entree_tec
                                IMA		12/03/2014		   MAJ du traitement STC MC
                                IMA		16/09/2014		   Ajout des traitements des appels AUTO_REPAIR
                                IMA		14/10/2014		   MAJ des filtres type client avec l'offre CABLE
                                IMA		05/03/2015		   MAJ des filtres type client avec l'offre CABLE, CABLE_RECENT
                                CKO 	06/08/2015		   MAJ Ajout un transfert TV_CABLE_RED au lieu de la diffusion du messag de dissuasion
                                IMA		10/02/2016		   ajout de l'offre  FTTH recent
                                IMA/CZO	16/06/2016		   ajout de l'offre  ECOTEL
                                IMA/CZO	19/01/2017		   Simplification des offres et ajout des flux MABOX
                                IMA/CZO	08/03/2017		   Ajout des traitements AGIR , PREDIAG
                                IMA/CZO	14/04/2017		   Prise en compte des traitements WCB_DIGITAL
                                IMA/CZO	19/04/2017		   Suppression des  traitements des appels en provenance de RDGU
                                IMA/CZO 10/10/2017     	   Suppression des traitements AUTO_REPAIR
                                IMA/CZO 10/01/2018     	   integration de l'interrogation SIGMA
                                IMA/CZO 06/03/2018     	   integration de l'interrogation SIGMA  pour les offres FTTB
                                MRO		15/03/2018			migration v8
								EISI	22/11/2018			Prise en compte de l'appel au WS MC_TECH    
								IMA/CZO	01/03/2019		  	suppression traitement RED  
								IMA/CZO	10/02/2020		  	Ajout filtre DEXTER ECOTEL 
								IMA/CZO	27/08/2020		    Integration des traitements DEXTER	
								IMA/CZO	07/05/2021		    Menage ARAMIS
								IMA/CZO	22/12/2021		    Integration traitement CARE	
								IMA/CZO	20/06/2022		    Integration du WS ARBEO a la palce de PREDIAG_V2
								IMA/CZO	12/07/2022		    MAJ_PILOTE_LN
								IMA/CZO	17/11/2022		    MAJ balise + filtre SIGMA à ARBEO
								IMA/CZO	19/12/2022		    Integration du traitement PREDIAG_SUSPICION_IG
								IMA/CZO	23/05/2023		    Integration du traitement MULTI_APPELANT (TECH)
								IMA/CZO 24/01/2024		    Integration de l identification SEARCH
								IMA/CZO 15/02/2024		    Integration FULL_BRANCH
														  	                            
    -->
    <script><![CDATA[
		applicationName = "FIXE"; appSvi = applicationName;
		var pageCourante = "FIXE_TECHNIQUE.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
    ]]></script>

    <var name="errorCounter" expr="1"/>
    <var name="typeLigneSigma" expr="''"/>
    
    

    <form id="Vers_TECHNIQUE">
        <script><![CDATA[ formCourant = "Vers_TECHNIQUE"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_next_form(pageCourante, "CTRL_CHOIX_FLASH_TECH"); ]]></script>
            <goto next="#CTRL_CHOIX_FLASH_TECH"/>
        </block>
    </form>


    <!--###########################################
       CONTROLE CHOIX FLASH TECH
  ########################################### -->
    <form id="CTRL_CHOIX_FLASH_TECH">
        <script><![CDATA[ formCourant = "CTRL_CHOIX_FLASH_TECH"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>

            <!--	Filtre CHOIX_FLASH activé -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.CHOIX_FLASH_TECH != 'false' "); ]]></script>
            <if cond="CUSTOMER_IHM.CHOIX_FLASH_TECH != 'false' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.CHOIX_FLASH_TECH != 'false' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '20001_CHOIX_FLASH_TECH');
					POSITION_ARBO = 32;
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
                <goto next="./FIXE_FLASH_INC.vxml"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "CTRL_CHOIX_FLASH2_TECH"); ]]></script>
                <goto next="#CTRL_CHOIX_FLASH2_TECH"/>

            </if>

        </block>
    </form>
    
