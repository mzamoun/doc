<?xml version="1.0" encoding="ISO-8859-1"?>
<vxml version="2.1" xmlns="http://www.w3.org/2001/vxml" application="../../../root.vxml" xml:lang="fr-FR">

    <!--
        Auteur :				IMA/CZO
        Date de Creation :		20/07/2022
        Page :                  Application FIXE  - ENTREE_LN (langage Naturel)
        Modification        	IMA/CZO	14/08/2023		    MAJ traitement LN + prise en compte nouvelles intentions
								
														  	                            
    -->
    <script><![CDATA[
		applicationName = "FIXE"; appSvi = applicationName;
		var pageCourante = "FIXE_ENTREE_LN.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
    ]]></script>

    <var name="errorCounter" expr="1"/>


    
    <!--#####################################################################################################
        CTRL TABLE HISTORIQUE LN
        ##################################################################################################### -->
    
    <form id="GET_CONTEXT_APPEL">
        <script><![CDATA[ formCourant = "GET_CONTEXT_APPEL"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[
			var connId  = CONN_ID;
        ]]></script>
        <script><![CDATA[ log_debug_appel_web_app(pageCourante, 'GET_CONTEXT_APPEL', subdialogGetContext , 'connId='+connId ); ]]></script>
        <subdialog name="GET_CONTEXT_APPEL"
                   srcexpr="subdialogGetContext"
                   namelist="connId"
                   method="post"
                   fetchtimeout="3s"
                   fetchaudio="../../../audio/Attente.wav">
            <catch event="error"> <!-- webapp KO -->
                <script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
             
                <script><![CDATA[ log_debug_next_form(pageCourante, "GET_CONTEXT_APPEL_KO"); ]]></script>
                <goto next="#GET_CONTEXT_APPEL_KO"/>
            </catch>
        </subdialog>

        <block>
            <script><![CDATA[ log_debug_result_web_app(pageCourante, 'GET_CONTEXT_APPEL', GET_CONTEXT_APPEL); ]]></script>
            <!--	traitement KO - HS -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "GET_CONTEXT_APPEL.APP_STATUS == 'NOK'"); ]]></script>
            <if cond="GET_CONTEXT_APPEL.APP_STATUS == 'NOK' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "GET_CONTEXT_APPEL.APP_STATUS == 'NOK' "); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "GET_CONTEXT_APPEL_KO"); ]]></script>
                <goto next="#GET_CONTEXT_APPEL_KO"/>                             

            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <assign name="CUSTOMER_CONTEXT_APPEL" expr="GET_CONTEXT_APPEL"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"CUSTOMER_CONTEXT_APPEL", CUSTOMER_CONTEXT_APPEL); ]]></script>                                                            
                
            </if>
                
 	 		<!--	traitement OK -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "GET_CONTEXT_APPEL.APP_STATUS == 'OK'"); ]]></script>
            <if cond="GET_CONTEXT_APPEL.APP_STATUS == 'OK' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "GET_CONTEXT_APPEL.APP_STATUS == 'OK'"); ]]></script>
		        <script><![CDATA[
					<!--	donnees du contexte sauvegrade lors du premier appel-->			        
					NDI = CUSTOMER_CONTEXT_APPEL.ndi;
					CUSTOMER_DATA = CUSTOMER_CONTEXT_APPEL.customerData;
					PARCOURS_DATA = CUSTOMER_CONTEXT_APPEL.parcoursData;
					AUTRE_DATA = CUSTOMER_CONTEXT_APPEL.autreData;
					TYPE_SORTIE_SVI = CUSTOMER_CONTEXT_APPEL.typeSortieSvi ;
					MOTIF_SORTIE_SVI = CUSTOMER_CONTEXT_APPEL.motifSortieSvi ;					
					<!--	donnees stat SVI premier appel -->			
					STAT_SVI = CUSTOMER_CONTEXT_APPEL.statSvi;
					<!--	donnees stat LN -->	
					STAT_SVI_LN = CUSTOMER_CONTEXT_APPEL.statSviLn ;
					TRACES_SVI_LN = CUSTOMER_CONTEXT_APPEL.tracesSviLn ;
					DUREE_APPLI_LN = CUSTOMER_CONTEXT_APPEL.dureeAppliLn ;
					LIST_APPLI_LN = CUSTOMER_CONTEXT_APPEL.listAppliLn ;
					<!--	Sauvegarde de l'heure de debut appel apres LN - a utiliser dans la duree afnor du deuxieme appel SVI  -->	
					startTimeAfterLn = startTime;										
		        ]]></script>                
                <script><![CDATA[ log_debug_next_form(pageCourante, "GET_CONTEXT_APPEL_OK"); ]]></script>
                <goto next="#GET_CONTEXT_APPEL_OK"/> 
			
            <!--	traitement NOK  -->                                
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "GET_CONTEXT_APPEL_KO"); ]]></script>
                <goto next="#GET_CONTEXT_APPEL_KO"/>              
            </if>
                      
        </block>
    </form>
    
    <form id="GET_CONTEXT_APPEL_OK">
        <script><![CDATA[ formCourant = "GET_CONTEXT_APPEL_OK"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
        	<!--	restauration donnees context appel initial -->
        	
            <script><![CDATA[
				<!--	Recup donnees dexter -->
				CUSTOMER_DEXTER = returnContextObjLn ('CUSTOMER_DEXTER',CUSTOMER_DATA);
	
				<!--	Recup donnees SEARCH -->
				CUSTOMER_SEARCH = returnContextObjLn ('CUSTOMER_SEARCH',CUSTOMER_DATA);				
				
				CUSTOMER_WS_MC_TECH = returnContextObjLn ('CUSTOMER_WS_MC_TECH',CUSTOMER_DATA);
				<!--	trt donnees mc_tech comme c le cas pour l'appel initial -->
				if (CUSTOMER_WS_MC_TECH.MC_TECH_FOUND == 'true'){
					MC_TECH_FOUND = CUSTOMER_WS_MC_TECH.MC_TECH_FOUND;
					log_debug_assignment(pageCourante, "MC_TECH_FOUND", MC_TECH_FOUND);
					MC_TECH_POSITION_ASSIGNE_A = CUSTOMER_WS_MC_TECH.MC_TECH_POSITION_ASSIGNE_A;
					log_debug_assignment(pageCourante, "MC_TECH_POSITION_ASSIGNE_A", MC_TECH_POSITION_ASSIGNE_A);
					MC_TECH_POSITION_CREATEUR = CUSTOMER_WS_MC_TECH.MC_TECH_POSITION_CREATEUR;
					log_debug_assignment(pageCourante, "MC_TECH_POSITION_CREATEUR", MC_TECH_POSITION_CREATEUR);
					MC_TECH_MOTIF = CUSTOMER_WS_MC_TECH.MC_TECH_MOTIF;
					log_debug_assignment(pageCourante, "MC_TECH_MOTIF", MC_TECH_MOTIF);
					MC_TECH_SOUS_TRAITANT = CUSTOMER_WS_MC_TECH.MC_TECH_SOUS_TRAITANT;
					log_debug_assignment(pageCourante, "MC_TECH_SOUS_TRAITANT", MC_TECH_SOUS_TRAITANT);
					MC_TECH_STATUT = CUSTOMER_WS_MC_TECH.MC_TECH_STATUT;
					log_debug_assignment(pageCourante, "MC_TECH_STATUT", MC_TECH_STATUT);	
					MC_TECH_CONCLUSION = CUSTOMER_WS_MC_TECH.MC_TECH_CONCLUSION;
					log_debug_assignment(pageCourante, "MC_TECH_CONCLUSION", MC_TECH_CONCLUSION);
					MC_TECH_OPEN = CUSTOMER_WS_MC_TECH.MC_TECH_OPEN;
					log_debug_assignment(pageCourante, "MC_TECH_OPEN", MC_TECH_OPEN);																																			
				}                
		                				                				
				<!--	Recup donnees BEB_FIXE_FASTR -->
				CUSTOMER_BEB_FIXE_FASTR = returnContextObjLn ('CUSTOMER_BEB_FIXE_FASTR',CUSTOMER_DATA);								
				
				
				<!--	Recup donnees FILTRE_IHM -->
				CUSTOMER_IHM = returnContextObjLn ('CUSTOMER_IHM',PARCOURS_DATA);	
							
				<!--	Recup donnees HOHNO du parcours FIXE -->
				CUSTOMER_HOHNO = returnContextObjLn ('CUSTOMER_HOHNO',PARCOURS_DATA);
											
				<!--	Recup donnees flash - AB_TEST - DIVERS -->	
				var FLASH ={};
				var DIVERS ={};
				var AB_TEST ={};
				FLASH = returnContextObjLn ('FLASH',AUTRE_DATA);
	   			LIST_FLASH = FLASH.LIST_FLASH;
	   			log_debug_assignment(pageCourante, "LIST_FLASH", LIST_FLASH);
			    if (!LIST_FLASH){
		   			LIST_FLASH = ';;;;' ;
		   			log_debug_assignment(pageCourante, "LIST_FLASH", LIST_FLASH);
								
				}	   			
	   			
				<!--	Recup donnees TECHNO - test -->	
	   			DIVERS = returnContextObjLn ('DIVERS',AUTRE_DATA);
	   			TECHNO = DIVERS.TECHNO;
	   			log_debug_assignment(pageCourante, "TECHNO", TECHNO);
	   			log_debug_assignment(pageCourante, "TECHNO_dexter====", isClientFixeFTTB() +"****"+ isClientFixeFTTH());
   				
	   			Id_Siebel = DIVERS.ID_SIEBEL;
	   			log_debug_assignment(pageCourante, "Id_Siebel", Id_Siebel);
	   			
	   			IDCSU = DIVERS.IDCSU;
	   			log_debug_assignment(pageCourante, "IDCSU", IDCSU);	   
	   				   			
				<!--	Recup donnees AB_TEST -->
				AB_TEST = returnContextObjLn ('AB_TEST',AUTRE_DATA);
	   							
	   			AB_TEST_PARCOURS_ELIG = AB_TEST.AB_TEST_PARCOURS_ELIG;
	   			log_debug_assignment(pageCourante, "AB_TEST_PARCOURS_ELIG", AB_TEST_PARCOURS_ELIG);
				MENU_AB_TEST_NIVEAU1_CHOIX = AB_TEST.MENU_AB_TEST_NIVEAU1_CHOIX;
				log_debug_assignment(pageCourante, "MENU_AB_TEST_NIVEAU1_CHOIX", MENU_AB_TEST_NIVEAU1_CHOIX);
				MENU_AB_TEST_NIVEAU2_CHOIX = AB_TEST.MENU_AB_TEST_NIVEAU2_CHOIX;
	   			log_debug_assignment(pageCourante, "MENU_AB_TEST_NIVEAU2_CHOIX", MENU_AB_TEST_NIVEAU2_CHOIX);	   				   			
	   			
	   			
				<!--	Recup donnees incidents -->
				var INCIDENTS_LN ={};
				INCIDENTS_LN = returnContextObjLn ('INCIDENTS',AUTRE_DATA);
	   							
	   			LIST_INCIDENT = INCIDENTS_LN.LIST_INCIDENT;
	   			log_debug_assignment(pageCourante, "LIST_INCIDENT", LIST_INCIDENT);
   			
				<!--	Recup donnees WCB_DIGITAL -->
				var WCB_DIGITAL_LN ={};
				WCB_DIGITAL_LN = returnContextObjLn ('WCB_DIGITAL',AUTRE_DATA);
	   							
	   			type_appel_wcb_digital = WCB_DIGITAL_LN.type_appel_wcb_digital;
	   			log_debug_assignment(pageCourante, "type_appel_wcb_digital", type_appel_wcb_digital);	   			
	   			wcb_digital_codeMotif = WCB_DIGITAL_LN.wcb_digital_codeMotif;
	   			log_debug_assignment(pageCourante, "wcb_digital_codeMotif", wcb_digital_codeMotif);				   			
	   			
				<!--	Recup donnees marqueurs_c2ol (premium et conv_risque -->
				var MARQ_C2OL_LN ={};
				MARQ_C2OL_LN = returnContextObjLn ('MARQ_C2OL',AUTRE_DATA);
	   							
	   			FIXE_CELL_PREM_FIDE = MARQ_C2OL_LN.FIXE_CELL_PREM_FIDE;
	   			log_debug_assignment(pageCourante, "FIXE_CELL_PREM_FIDE", FIXE_CELL_PREM_FIDE);	   			
	   			FIXE_PACKPRO = MARQ_C2OL_LN.FIXE_PACKPRO;
	   			log_debug_assignment(pageCourante, "FIXE_PACKPRO", FIXE_PACKPRO);
	   				 
	   			FIXE_CONV_RISQUE = MARQ_C2OL_LN.FIXE_CONV_RISQUE;
	   			log_debug_assignment(pageCourante, "FIXE_CONV_RISQUE", FIXE_CONV_RISQUE);	 
	   			FIXE_CONV_NON_RISQUE = MARQ_C2OL_LN.FIXE_CONV_NON_RISQUE;
	   			log_debug_assignment(pageCourante, "FIXE_CONV_NON_RISQUE", FIXE_CONV_NON_RISQUE);	 
	   			FIXE_NON_CONV_RISQUE = MARQ_C2OL_LN.FIXE_NON_CONV_RISQUE;
	   			log_debug_assignment(pageCourante, "FIXE_NON_CONV_RISQUE", FIXE_NON_CONV_RISQUE);	 
	   			FIXE_NON_CONV_NON_RISQUE = MARQ_C2OL_LN.FIXE_NON_CONV_NON_RISQUE;
	   			log_debug_assignment(pageCourante, "FIXE_NON_CONV_NON_RISQUE", FIXE_NON_CONV_NON_RISQUE);	   							
						   			
				<!--	Recup donnees STAT SVI + clickfox -->	
	   			returnContextSTAT_SVI (STAT_SVI,STAT_SVI_LN,TRACES_SVI_LN,DUREE_APPLI_LN,LIST_APPLI_LN);	
	   			log_debug_assignment(pageCourante, "newcall", newcall);
	   			log_debug_assignment(pageCourante, "startTime", startTime);
	   			log_debug_assignment(pageCourante, "stopTime", stopTime);	   			
	   			log_debug_assignment(pageCourante, "customRoute", customRoute);
	   				   				   				   				   				   				   				   				   			   				   			
				customNode(applicationName + '_' + '11000_TECH_LN_RECUP_CONTEXT_OK');	   									
            ]]></script>
                       
	                        
            <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_FILTRE_INTENTION"); ]]></script>
            <goto next="#VERS_FILTRE_INTENTION"/>
            
        </block>
    </form>
    
       
    <form id="GET_CONTEXT_APPEL_KO">
        <script><![CDATA[ formCourant = "GET_CONTEXT_APPEL_KO"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[								
				customNode(applicationName + '_' + '11000_TECH_LN_RECUP_CONTEXT_KO');				
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_FILTRE_INTENTION"); ]]></script>
            <goto next="#VERS_FILTRE_INTENTION"/>
            
        </block>
    </form>        
    
          

 
	<!--#####################################################################################################
	    Gestion retour de l appel LN
	    ##################################################################################################### -->      

    
    <!--###########################################
        FILTRE INTENTION
   ########################################### -->
    <form id="VERS_FILTRE_INTENTION">
        <script><![CDATA[ formCourant = "VERS_FILTRE_INTENTION"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '11000_TECH_LN_'+ LN_INTENT);		
				POSITION_ARBO = 171;							
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
            ]]></script>            
       		<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/> 
            
        </block>
    </form>


    <!--############################################################
        TRANSFERT PILOTE_LN
   ################################################################# -->
   
    <!--###########################################
        VERS TRANSFERT PILOTE_LN
   ########################################### -->      
    <form id="VERS_TRANSFERT_LN">
        <script><![CDATA[ formCourant = "VERS_TRANSFERT_LN"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>

            <!-- LN_INTENT - INTERNET-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "LN_INTENT == 'Internet' "); ]]></script>
            <if cond="LN_INTENT == 'Internet' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "LN_INTENT == 'Internet' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '11000_FTT_LN_INTERNET_'+ GET_TECHNO_FIXE());
					POSITION_ARBO = 174;							
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>            
	       		<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/> 


                <!-- LN_INTENT - TELEVISION-->
            <elseif cond="LN_INTENT == 'Television' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "LN_INTENT == 'Television'"); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '11000_FTT_LN_TELEVISION_'+ GET_TECHNO_FIXE());
					POSITION_ARBO = 175;							
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>            
	       		<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/> 

                <!-- LN_INTENT - Commercial-->
            <elseif cond="CUSTOMER_IHM.LN_CO_ROUTAGE != 'false' &amp;&amp; LN_INTENT == 'Commercial'"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.LN_CO_ROUTAGE != 'false' &amp;&amp; LN_INTENT == 'Commercial'"); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '11000_FTT_LN_COMMERCIAL_'+ GET_TECHNO_FIXE() );
					POSITION_ARBO = 193;							
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>            
	       		<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/> 
	            
                <!-- LN_INTENT - Retention-->
            <elseif cond="CUSTOMER_IHM.LN_RET_ROUTAGE != 'false' &amp;&amp; LN_INTENT == 'Retention'"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.LN_RET_ROUTAGE != 'false' &amp;&amp; LN_INTENT == 'Retention'"); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '11000_FTT_LN_RETENTION_'+ GET_TECHNO_FIXE() );
					POSITION_ARBO = 170;							
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>            
	       		<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/> 
	            
                <!-- LN_INTENT - Anc-->
            <elseif cond="CUSTOMER_IHM.LN_ANC_DEM_ROUTAGE != 'false' &amp;&amp; LN_INTENT == 'ANC'"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.LN_ANC_DEM_ROUTAGE != 'false' &amp;&amp; LN_INTENT == 'Anc'"); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '11000_FTT_LN_ANC_'+ GET_TECHNO_FIXE() );
					POSITION_ARBO = 54;							
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>            
	       		<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/> 
	            
                <!-- LN_INTENT - Mobile-->
            <elseif cond="CUSTOMER_IHM.LN_TECH_MOB_ROUTAGE != 'false' &amp;&amp; LN_INTENT == 'Tech_Mobile'"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.LN_TECH_MOB_ROUTAGE != 'true' &amp;&amp; LN_INTENT == 'Tech_Mobile'"); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '11000_FTT_LN_TECH_MOBILE');
					POSITION_ARBO = 53;							
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>            
	       		<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/> 
	            
                <!-- LN_INTENT - DEFAUT -->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '11000_FTT_LN_AUTRE_'+ GET_TECHNO_FIXE() );
					POSITION_ARBO = 176;							
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>            
	       		<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/> 

            </if>
        </block>
    </form> 
    

    
    <!-- LN_INTENT - Commercial --> 
    <form id="VERS_ADMINISTRATIF_CO">
        <script><![CDATA[ formCourant = "VERS_ADMINISTRATIF_CO"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
        
            <!--	SOUS APPLI FIXE_COM HO  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_COM_IS_OPEN !='false' "); ]]></script>	
            <if cond=" CUSTOMER_HOHNO.FIXE_COM_IS_OPEN !='false' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_COM_IS_OPEN !='false' "); ]]></script>
            		
	            <!-- Traitement specifique AB_TEST pour maj de la balise de stat suivant l ordre du choix COM dans le menu AB_TEST  -->
	          	<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "AB_TEST_PARCOURS_ELIG == '1' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_COM =='true' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_COM_ORDRE "); ]]></script>
	            <if cond="AB_TEST_PARCOURS_ELIG == '1' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_COM =='true' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_COM_ORDRE ">
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "AB_TEST_PARCOURS_ELIG == '1' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_COM =='true' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_COM_ORDRE "); ]]></script>
	                
		            <script><![CDATA[					
						<!-- MAJ PREFIXE de la balise de stat avec l ordre du choix COM --> 
		                MENU_AB_TEST_NIVEAU1_CHOIX = CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_COM_ORDRE;				
						log_debug_assignment(pageCourante, "MENU_AB_TEST_NIVEAU1_CHOIX", MENU_AB_TEST_NIVEAU1_CHOIX);																	
					]]></script> 				
	
	            </if>
	                   
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_ADMINISTRATIF.vxml#ENTREE_LN_CO"); ]]></script>
	            <goto next="./FIXE_ADMINISTRATIF.vxml#ENTREE_LN_CO"/>
	            
            <!--	FIXE_COM HNO  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '11000_FTT_LN_COMMERCIAL_'+ GET_TECHNO_FIXE() );
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "TRANSFERT_LN"); ]]></script>
	            <goto next="#TRANSFERT_LN"/>

            </if>   

        </block>
    </form>
    
    <!-- LN_INTENT - Retention --> 
    <form id="VERS_ADMINISTRATIF_RET">
        <script><![CDATA[ formCourant = "VERS_ADMINISTRATIF_RET"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
        
          <!--	SOUS APPLI FIXE_RET HO  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_HOHNO.FIXE_RET_IS_OPEN !='false'"); ]]></script>	
            <if cond="CUSTOMER_HOHNO.FIXE_RET_IS_OPEN !='false'">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_HOHNO.FIXE_RET_IS_OPEN !='false'"); ]]></script>	

	            <!-- Traitement specifique AB_TEST pour maj de la balise de stat suivant l ordre du choix RET dans le menu AB_TEST  -->
	          	<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "AB_TEST_PARCOURS_ELIG == '1' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_RET =='true' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_RET_ORDRE "); ]]></script>
	            <if cond="AB_TEST_PARCOURS_ELIG == '1' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_RET =='true' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_RET_ORDRE ">
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "AB_TEST_PARCOURS_ELIG == '1' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_RET =='true' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_RET_ORDRE "); ]]></script>
	                
		            <script><![CDATA[					
						<!-- MAJ PREFIXE de la balise de stat avec l ordre du choix RET --> 
		                MENU_AB_TEST_NIVEAU1_CHOIX = CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_RET_ORDRE;				
						log_debug_assignment(pageCourante, "MENU_AB_TEST_NIVEAU1_CHOIX", MENU_AB_TEST_NIVEAU1_CHOIX);																	
					]]></script> 				
	
	            </if>                    
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_ADMINISTRATIF.vxml#ENTREE_LN_RET"); ]]></script>
	            <goto next="./FIXE_ADMINISTRATIF.vxml#ENTREE_LN_RET"/>             	

            <!--	FIXE_RET HNO  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '11000_FTT_LN_RETENTION_HNO_'+ GET_TECHNO_FIXE() );
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "TRANSFERT_LN"); ]]></script>
	            <goto next="#TRANSFERT_LN"/>

            </if> 
            
        </block>
    </form> 
    
    <!-- LN_INTENT - Anc (ANC/DEMENAGEMENT) --> 
    <form id="VERS_DEMENAGEMENT">
        <script><![CDATA[ formCourant = "VERS_DEMENAGEMENT"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
        
            <!--	SOUS APPLI FIXE_ANC HO  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_DEM_IS_OPEN !='false' "); ]]></script>	
            <if cond=" CUSTOMER_HOHNO.FIXE_DEM_IS_OPEN !='false' ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_DEM_IS_OPEN !='false' "); ]]></script>
            		
	            <!-- Traitement specifique AB_TEST pour maj de la balise de stat suivant l ordre du choix DEM dans le menu AB_TEST  -->
	          	<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "AB_TEST_PARCOURS_ELIG == '1' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_DEM =='true' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_DEM_ORDRE "); ]]></script>
	            <if cond="AB_TEST_PARCOURS_ELIG == '1' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_DEM =='true' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_DEM_ORDRE ">
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "AB_TEST_PARCOURS_ELIG == '1' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_DEM =='true' &amp;&amp; CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_DEM_ORDRE "); ]]></script>
	                
		            <script><![CDATA[					
						<!-- MAJ PREFIXE de la balise de stat avec l ordre du choix DEM --> 
		                MENU_AB_TEST_NIVEAU1_CHOIX = CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_AB_TEST_DEM_ORDRE;				
						log_debug_assignment(pageCourante, "MENU_AB_TEST_NIVEAU1_CHOIX", MENU_AB_TEST_NIVEAU1_CHOIX);																	
					]]></script> 				
	
	            </if>        
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_ENTREE_GP.vxml#ENTREE_LN_DMGT"); ]]></script>
	            <goto next="./FIXE_ENTREE_GP.vxml#ENTREE_LN_DMGT"/> 	            	            
    
            <!--	FIXE_ANC HNO  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[				
                	customNode(applicationName + '_' + '11000_FTT_LN_ANC_HNO_'+ GET_TECHNO_FIXE() );					
                ]]></script>
                                           
	            <script><![CDATA[ log_debug_next_form(pageCourante, "TRANSFERT_LN"); ]]></script>
	            <goto next="#TRANSFERT_LN"/>
            </if>            
        </block>
    </form>          
    
        
    <!-- LN_INTENT - TECH MOBILE --> 
    <form id="VERS_TRT_MOBILE">
        <script><![CDATA[ formCourant = "VERS_TRT_MOBILE"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!-- Intention Mobile -->
            <script><![CDATA[
				ID_FLUX='LN_TECH_MOBILE';
				log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
            <goto next="#Transfert"/>  

        </block>
    </form>    
           

    
 	<!-- LN_INTENT - INTERNET/TELEVISION/AUTRE  ou trt HNO pour intentions CO/RET/ANC/TECH_MOBILE-->   
    <form id="TRANSFERT_LN">
        <script><![CDATA[ formCourant = "TRANSFERT_LN"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!-- Client FTTH -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientFixeFTTH()"); ]]></script>
            <if cond="isClientFixeFTTH()">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH()"); ]]></script>
                <script><![CDATA[
						ID_FLUX='FTT_FTTH';
						log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>


                <!-- Client FTTB-->
            <elseif cond=" isClientFixeFTTB()"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " isClientFixeFTTB() "); ]]></script>
                <script><![CDATA[
						ID_FLUX='FTT_FTTB';
						log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
						ID_FLUX='FTT_AUTRE';
						log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>

            </if>
        </block>
    </form>
        
    <form id="Transfert">
        <script><![CDATA[ formCourant = "Transfert"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_TRANSFERT.vxml"); ]]></script>
            <goto next="./FIXE_TRANSFERT.vxml"/>
        </block>
    </form>

</vxml>
