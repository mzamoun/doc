    <!--
        Auteur :				IMA
        Date de Creation :		11/03/2013
        Page :                  Application FIXE (FCT) - DEMENAGEMENT
        Modification        	IMA		10/05/2013		   	Intégration des appels en provenance de RDGU
                                IMA		10/05/2013		   	Suppression du filtre BEB_DMGT
                                MLA		08/01/2015		   	Ajout du filtre 	Filtre_Offre_DMGT
                                IMA		06/03/2015		   	MAJ des filtres type client avec l'offre CABLE, CABLE_RED
                                IMA		10/02/2016		   	MAJ L'offre THD en FTTH
                                IMA/CZO	15/04/2016		   	maj des condtions de client eligible au MC_ACTIV
                                IMA/CZO	22/07/2016		   	MAJ  filtre BEB_ACTIVATION: exclusion des offres CABLE_RED et ADSL_RED
                                IMA/CZO	24/08/2016		   	Prise en compte des client CABLExxx MIG_NC
                                IMA/CZO	05/10/2016		   	Prise en compte des client CABLExxx MIG_NC avec les criteres safir, maj filtre BEB_ACTIVATION
                                IMA/CZO	14/04/2017		   	Prise en compte des traitements WCB_DIGITAL
                                IMA/CZO	19/06/2017		   	MAJ traitement MC_ACTIV: appel WS et appel beb_dmgt(etl)
                                MRO		15/03/2018			migration v8
								IMA/CZO 05/05/2018			menage conditions mog SAFIR
								IMA/CZO 12/12/2018			Integration des traitements PREMIUM DMGT
								IMA/CZO 17/01/2019			suppression traitement voix
								IMA/CZO	01/03/2019		  	suppression traitement RED 
								IMA/CZO	25/03/2019		    MAJ traitement PREMIUM - PACKPRO	 
								IMA/CZO	27/08/2020		    Integration des traitements DEXTER	
								IMA/CZO	07/05/2021		    Menage ARAMIS  	
								IMA/CZO	05/10/2021			Integration du traitement BEB_FIXE_ANC
    -->
    <script><![CDATA[
		applicationName = "FIXE"; appSvi = applicationName;
		var pageCourante = "FIXE_DEMENAGEMENT.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
    ]]></script>

    <var name="errorCounter" expr="1"/>

    
    <!--####################################################
         ENTREE 
    #################################################### -->
    <form id="ENTREE">
        <script><![CDATA[ formCourant = "ENTREE"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>      
            <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_CTRL_BEB_FIXE_FASTR_ANC"); ]]></script>
            <goto next="#VERS_CTRL_BEB_FIXE_FASTR_ANC"/>
        </block>
    </form>  
        
    <!--####################################################
         ENTREE WCB_DIGITAL à partir de FIXE_WCB_DIGITAL
