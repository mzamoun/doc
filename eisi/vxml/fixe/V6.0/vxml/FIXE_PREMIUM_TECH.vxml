    <menu id="MENU_PREMIUM_TECHNIQUE">
        <script><![CDATA[ formCourant = "MENU_PREMIUM_TECHNIQUE"; ]]></script>
        <script><![CDATA[ menuCourant = formCourant; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <property name="timeout" value="3s"/>

        <prompt bargein="true">
    		<audio maxage="7200" maxstale="7200" expr="PlayFileCommun(CUSTOMER_IHM.FIXE_MENU_PREMIUM_TECHNIQUE_MENU_PREMIUM_TECHNIQUE_AUDIO)"/>
        </prompt>        											
	
        <catch event="noinput nomatch" cond="document.errorCounter &lt; 2">
            <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "noinput_nomatch"); ]]></script>
            <script><![CDATA[ track_dtmfList (formCourant,"NMNI"); ]]></script>
            <assign name="document.errorCounter" expr="document.errorCounter + 1"/>
            <script><![CDATA[ log_debug_assignment(pageCourante,"document.errorCounter", document.errorCounter); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '10040_PREMIUM_TECH_NMNI');				
            ]]></script>
            <prompt>
                <audio expr="PlayGenericAudio('ERREUR_SAISIE_NOUVEAU')"/>
            </prompt>
            <reprompt/>
        </catch>
        <catch event="noinput nomatch" cond="document.errorCounter == 2">
            <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "noinput_nomatch"); ]]></script>
            <script><![CDATA[ track_dtmfList (formCourant,"NMNI2"); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '10040_PREMIUM_TECH_NMNI_X2');
				POSITION_ARBO = 60;					
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>
        </catch>

        <choice dtmf="1" next="#VersPremInternet"/>
        <choice dtmf="2" next="#VersPremTV"/>
        <choice dtmf="3" next="#VersPremTechAutre"/>

    </menu>

    <!--###########################################
        Choix 1: Acces PREMIUM Internet
   ########################################### -->
    <form id="VersPremInternet">
        <script><![CDATA[ formCourant = "VersPremInternet"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "1"); ]]></script>
        <script><![CDATA[ track_dtmfList ("MENU_PREMIUM_TECHNIQUE", "1"); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '11000_PREM_TECH_INTERNET');			
            ]]></script>
            <script><![CDATA[				
				<!--POSITION_INCIDENT_HEIMDALL = liste ('position|balise|page_suivante|form suivant') -->				
				POSITION_INCIDENT_HEIMDALL = '2|11000_PREM_TECH_INTERNET|FLASH_INC|;';
				log_debug_assignment(pageCourante, "POSITION_INCIDENT_HEIMDALL", POSITION_INCIDENT_HEIMDALL);						
			]]></script>            

			<!-- Position  flash -->          		
            <script><![CDATA[
				POSITION_ARBO = 62;						
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
            ]]></script>
            
			<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_INCIDENT_INC.vxml"); ]]></script>
			<goto next="./FIXE_INCIDENT_INC.vxml"/>
        </block>
    </form>


    <!--###########################################
        Choix 2: Tech PREMIUM TV
   ########################################### -->
    <form id="VersPremTV">
        <script><![CDATA[ formCourant = "VersPremTV"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "2"); ]]></script>
        <script><![CDATA[ track_dtmfList ("MENU_PREMIUM_TECHNIQUE", "2"); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '12000_PREM_TECH_TV');			
            ]]></script>
            <script><![CDATA[				
				<!--POSITION_INCIDENT_HEIMDALL = liste ('position|balise|page_suivante|form suivant') -->				
				POSITION_INCIDENT_HEIMDALL = '3|12000_PREM_TECH_TV|FLASH_INC|;';
				log_debug_assignment(pageCourante, "POSITION_INCIDENT_HEIMDALL", POSITION_INCIDENT_HEIMDALL);						
			]]></script>            

			<!-- Position  flash -->          		
            <script><![CDATA[
				POSITION_ARBO = 61;						
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
            ]]></script>
            
			<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_INCIDENT_INC.vxml"); ]]></script>
			<goto next="./FIXE_INCIDENT_INC.vxml"/>
        </block>
    </form>

    <!--###########################################
    Choix 3: Tech PREMIUM AUTRE
    ########################################### -->
    <form id="VersPremTechAutre">
        <script><![CDATA[ formCourant = "VersPremTechAutre"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "3"); ]]></script>
        <script><![CDATA[ track_dtmfList ("MENU_PREMIUM_TECHNIQUE", "3"); ]]></script>
        <block>
            <script><![CDATA[
					customNode(applicationName + '_' + '13000_PREM_TECH_AUTRE');
            ]]></script>
            <script><![CDATA[				
				<!--POSITION_INCIDENT_HEIMDALL = liste ('position|balise|page_suivante|form suivant') -->				
				POSITION_INCIDENT_HEIMDALL = '4|13000_PREM_TECH_AUTRE|FLASH_INC|;';
				log_debug_assignment(pageCourante, "POSITION_INCIDENT_HEIMDALL", POSITION_INCIDENT_HEIMDALL);						
			]]></script>            

			<!-- Position  flash -->          		
            <script><![CDATA[
				POSITION_ARBO = 60;					
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
            ]]></script>
            
			<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_INCIDENT_INC.vxml"); ]]></script>
			<goto next="./FIXE_INCIDENT_INC.vxml"/>
        </block>
    </form>



       
    <!--###########################################
    PREMIUM TYPE CLIENT
    ########################################### -->
    <form id="PREMIUM_Tech_Type_Client">
        <script><![CDATA[ formCourant = "PREMIUM_Tech_Type_Client"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>

            <!-- CABLE et PACKPRO					  //-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientFixeFTTB()  &amp;&amp; FIXE_PACKPRO == 'true' "); ]]></script>
            <if cond="isClientFixeFTTB()  &amp;&amp; FIXE_PACKPRO == 'true'  ">            
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTB()  &amp;&amp; FIXE_PACKPRO == 'true' "); ]]></script>      
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_FTT_PACKPRO_FTTB');
					ID_FLUX='FTT_PACKPRO_FTTB';					
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                

            <!-- FTTH et PACKPRO					  //-->
            <elseif cond="isClientFixeFTTH() &amp;&amp; FIXE_PACKPRO == 'true' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH() &amp;&amp; FIXE_PACKPRO == 'true' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_FTT_PACKPRO_FTTH');
					ID_FLUX='FTT_PACKPRO_FTTH';					
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>                
                                 
            <!-- AUTRE	et PACKPRO					  //-->
            <elseif cond="FIXE_PACKPRO == 'true' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " FIXE_PACKPRO == 'true' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_FTT_PREMIUM_AUTRE');
					ID_FLUX='FTT_PACKPRO_AUTRE';					
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>         
                                        
               <!--	FIDE et CABLE		-->
            <elseif cond="FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' &amp;&amp; isClientFixeFTTB() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' &amp;&amp; isClientFixeFTTB() "); ]]></script>
                <script><![CDATA[
					   customNode(applicationName + '_' + '10000_FTT_PREMIUM_FTTB_FIDE');
					   ID_FLUX='FTT_PREMIUM_FTTB_FIDE';		
					   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>

               <!--	FIDE et FTTH		-->
            <elseif cond="FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' &amp;&amp; isClientFixeFTTH()"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' &amp;&amp; isClientFixeFTTH()"); ]]></script>
                <script><![CDATA[
					   customNode(applicationName + '_' + '10000_FTT_PREMIUM_FTTH_FIDE');
					   ID_FLUX='FTT_PREMIUM_FTTH_FIDE';		
					   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                
               <!--	FIDE - AUTRE		-->
            <elseif cond="FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_CELL_PREM_FIDE == 'true' &amp;&amp; FIXE_CELL_PREM_PLATINE != 'true' "); ]]></script>
                <script><![CDATA[
					   customNode(applicationName + '_' + '10000_FTT_PREMIUM_AUTRE_FIDE');
					   ID_FLUX='FTT_PREMIUM_AUTRE_FIDE';		
					   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>      

                <!--	CABLE		-->
            <elseif cond="isClientFixeFTTB()"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTB()"); ]]></script>
                <script><![CDATA[
					   customNode(applicationName + '_' + '10000_FTT_PREMIUM_FTTB');
					   ID_FLUX='FTT_PREMIUM_FTTB';		
					   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>

                <!--	 FTTH		-->
                <!-- <elseif cond="(CUSTOMER_ARAMIS &amp;&amp; isTHD(CUSTOMER_ARAMIS.OFFRE) == 'true')" /> -->
            <elseif cond="isClientFixeFTTH()"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH()"); ]]></script>
                <script><![CDATA[
					   customNode(applicationName + '_' + '10000_FTT_PREMIUM_FTTH');
					   ID_FLUX='FTT_PREMIUM_FTTH';		
					   log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
						customNode(applicationName + '_' + '10000_FTT_PREMIUM_AUTRE');
						ID_FLUX='FTT_PREMIUM_AUTRE';	
						log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
            </if>

            <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
            <goto next="#Transfert"/>
        </block>
    </form>
    
   
    <!--###########################################
         Transfert: vers la page transfert
    ########################################### -->     
    <form id="Transfert">
        <script><![CDATA[ formCourant = "Transfert"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_TRANSFERT.vxml"); ]]></script>
            <goto next="./FIXE_TRANSFERT.vxml"/>
        </block>
    </form> 
    
        
        
</vxml>
