	            <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_MENU_PREMIUM_TECHNIQUE"); ]]></script>
	            <goto next="#VERS_MENU_PREMIUM_TECHNIQUE"/>                
            </if>
            
        </block>
    </form>
    
    
    <form id="PREMIUM_TECH_WCB">
        <script><![CDATA[ formCourant = "PREMIUM_TECH_WCB"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "wcb_digital_codeMotif == '01'"); ]]></script>
            <if cond="wcb_digital_codeMotif == '01'">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "wcb_digital_codeMotif == '01'"); ]]></script>
                <script><![CDATA[
	                customNode(applicationName + '_' + '11000_WCB_PREM_TECH_INTERNET');		
	
					<!--POSITION_INCIDENT_HEIMDALL = liste ('position|balise|page_suivante|form suivant') -->				
					POSITION_INCIDENT_HEIMDALL = '2|11000_WCB_PREM_TECH_INTERNET|FLASH_INC|;';
					log_debug_assignment(pageCourante, "POSITION_INCIDENT_HEIMDALL", POSITION_INCIDENT_HEIMDALL);						
				]]></script>            		
				<!-- Position  flash -->          		
	            <script><![CDATA[
	                POSITION_ARBO = 28;				
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            
				<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_INCIDENT_INC.vxml"); ]]></script>
				<goto next="./FIXE_INCIDENT_INC.vxml"/>                

            <elseif cond="wcb_digital_codeMotif == '02'"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "wcb_digital_codeMotif == '02'"); ]]></script>
                <script><![CDATA[
	                customNode(applicationName + '_' + '12000_WCB_PREM_TECH_TV');	
                ]]></script>
	            <script><![CDATA[				
					<!--POSITION_INCIDENT_HEIMDALL = liste ('position|balise|page_suivante|form suivant') -->				
					POSITION_INCIDENT_HEIMDALL = '3|12000_WCB_PREM_TECH_TV|FLASH_INC|;';
					log_debug_assignment(pageCourante, "POSITION_INCIDENT_HEIMDALL", POSITION_INCIDENT_HEIMDALL);						
				]]></script>            		
				<!-- Position  flash -->          		
	            <script><![CDATA[
	                POSITION_ARBO = 84;				
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            
				<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_INCIDENT_INC.vxml"); ]]></script>
				<goto next="./FIXE_INCIDENT_INC.vxml"/>   

                <!--	motif=03 - cas par défaut  -->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
	                customNode(applicationName + '_' + '13000_WCB_PREM_TECH_AUTRE');
                ]]></script>
	            <script><![CDATA[				
					<!--POSITION_INCIDENT_HEIMDALL = liste ('position|balise|page_suivante|form suivant') -->				
					POSITION_INCIDENT_HEIMDALL = '4|13000_WCB_PREM_TECH_AUTRE|FLASH_INC|;';
					log_debug_assignment(pageCourante, "POSITION_INCIDENT_HEIMDALL", POSITION_INCIDENT_HEIMDALL);						
				]]></script>		
				<!-- Position  flash -->          		
	            <script><![CDATA[
	                POSITION_ARBO = 63;				
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            
				<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_INCIDENT_INC.vxml"); ]]></script>
				<goto next="./FIXE_INCIDENT_INC.vxml"/>

            </if>
            
        </block>
    </form>    
    

