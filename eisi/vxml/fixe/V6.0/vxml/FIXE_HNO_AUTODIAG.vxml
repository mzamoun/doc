    <!-- ==================================== -->
    <!-- ENVOI SMS - WS GINGER			  -->
    <!-- ==================================== -->
            
    <form id="VERS_ENVOI_SMS">
        <script><![CDATA[ formCourant = "VERS_ENVOI_SMS"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[ log_debug_appel_web_app(pageCourante, 'FIXE_WS_MESSAGEREST20', subdialogWS_MESSAGEREST20 , 'mob_contact=' + mob_contact ); ]]></script>
        <subdialog name="FIXE_WS_MESSAGEREST20"
                   srcexpr="subdialogWS_MESSAGEREST20"
                   namelist="mob_contact"
                   method="post"
                   fetchtimeout="5s"
                   fetchaudio="../../../audio/Attente.wav">
        </subdialog>
        <catch event="error">
            <script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '73000_MESSAGEREST20_HS');
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "ENVOI_SMS_KO"); ]]></script>
            <goto next="#ENVOI_SMS_KO"/>
        </catch>

        <block>
            <script><![CDATA[ log_debug_result_web_app(pageCourante, 'FIXE_WS_MESSAGEREST20', FIXE_WS_MESSAGEREST20 ); ]]></script>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "FIXE_WS_MESSAGEREST20.APP_STATUS == 'NOK'"); ]]></script>
            <if cond="FIXE_WS_MESSAGEREST20.APP_STATUS == 'NOK'">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_WS_MESSAGEREST20.APP_STATUS == 'NOK'"); ]]></script>
                <script><![CDATA[ log_appel_web_app_nok(pageCourante, 'FIXE_WS_MESSAGEREST20', subdialogWS_ASC_REINIT_MDP , 'ndi=' + ndi +'|login=' + login +'notificationMedia=' + notificationMedia +'|notificationAdresseMedia=' + notificationAdresseMedia ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '73000_MESSAGEREST20_HS');
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "ENVOI_SMS_KO"); ]]></script>
                <goto next="#ENVOI_SMS_KO"/>

                <!-- Retour OK de la web APP-->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>

                <!-- Code Retour OK-->
                <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "FIXE_WS_MESSAGEREST20.APP_STATUS == 'OK' &amp;&amp; FIXE_WS_MESSAGEREST20.WS_MESSAGEREST20_STATUS == 'OK' &amp;&amp; FIXE_WS_MESSAGEREST20.ENVOI_SMS_SUCCES == 'true' "); ]]></script>
                <if cond="FIXE_WS_MESSAGEREST20.APP_STATUS == 'OK' &amp;&amp; FIXE_WS_MESSAGEREST20.WS_MESSAGEREST20_STATUS == 'OK' &amp;&amp; FIXE_WS_MESSAGEREST20.ENVOI_SMS_SUCCES == 'true' ">
                    <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "FIXE_WS_MESSAGEREST20.APP_STATUS == 'OK' &amp;&amp; FIXE_WS_MESSAGEREST20.WS_MESSAGEREST20_STATUS == 'OK' &amp;&amp; FIXE_WS_MESSAGEREST20.ENVOI_SMS_SUCCES == 'true' "); ]]></script>
                    <script><![CDATA[
						customNode(applicationName + '_' + '73000_MESSAGEREST20_OK');
						<!--maj  de la variable CLICKFOX statAutre avec la donnee -->
						statAutre=statAutre+'YOURREF:'+FIXE_WS_MESSAGEREST20.YOURREF+'|';						
                    ]]></script>
                    <script><![CDATA[ log_debug_next_form(pageCourante, "ENVOI_SMS_SUCCES"); ]]></script>
                    <goto next="#ENVOI_SMS_SUCCES"/>


                    <!-- ENVOI SMS KO ou avec erreu-->
                <else/>
                    <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>                  
                    
		            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "FIXE_WS_MESSAGEREST20.CODE_ERREUR &amp;&amp; FIXE_WS_MESSAGEREST20.CODE_ERREUR !=''"); ]]></script>
		            <if cond="FIXE_WS_MESSAGEREST20.CODE_ERREUR &amp;&amp; FIXE_WS_MESSAGEREST20.CODE_ERREUR !='' ">
