        Page :					Application FIXE - CHOIX_FLASH3_FCT
        Modification :	        
        
    -->
    <script><![CDATA[
		applicationName = "FIXE"; appSvi = applicationName;
		var pageCourante = "FIXE_CHOIX_FLASH3_FCT.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
	]]></script>
	
	<script><![CDATA[    
	    <!--	Initialisation tableau dynamique-->
		var tabMenu = new Array ();
		var compteur = 0;
		var choix_1 = 'false';
		var choix_2 = 'false';
		var choix_3 = 'false';	    		
	]]></script>
	
    <var name="errorCounter" expr="1"/>

	
    	
  <!-- ==================================== //-->
  <!-- INIT MenuChoix_FLASH_MENU_FCT        //-->
  <!-- ==================================== //-->          
    <form id="initMenuChoix_FLASH_MENU_FCT">
    	<script><![CDATA[ formCourant = "initMenuChoix_FLASH_MENU_FCT"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.MENU_CHOIX_FLASH3_FCT_CHOIX_1 =='true'"); ]]></script>	
            <if cond="CUSTOMER_IHM.MENU_CHOIX_FLASH3_FCT_CHOIX_1 =='true'">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.MENU_CHOIX_FLASH3_FCT_CHOIX_1 =='true'"); ]]></script>	
                <script><![CDATA[
						tabMenu[compteur] = CUSTOMER_IHM.MENU_CHOIX_FLASH3_FCT_CHOIX_1_AUDIO;
						compteur++;
						choix_1 = 'true';
                ]]></script>
                <script><![CDATA[ log_debug_assignment(pageCourante,'choix_1',choix_1); ]]></script>
            </if>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.MENU_CHOIX_FLASH3_FCT_CHOIX_2 =='true'"); ]]></script>	
            <if cond="CUSTOMER_IHM.MENU_CHOIX_FLASH3_FCT_CHOIX_2 =='true'">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.MENU_CHOIX_FLASH3_FCT_CHOIX_2 =='true'"); ]]></script>	
                <script><![CDATA[
						tabMenu[compteur] = CUSTOMER_IHM.MENU_CHOIX_FLASH3_FCT_CHOIX_2_AUDIO;
						compteur++;
						choix_2 = 'true';
                ]]></script>
                <script><![CDATA[ log_debug_assignment(pageCourante,'choix_2',choix_2); ]]></script>
            </if>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.MENU_CHOIX_FLASH3_FCT_CHOIX_3 =='true'"); ]]></script>	
            <if cond="CUSTOMER_IHM.MENU_CHOIX_FLASH3_FCT_CHOIX_3 =='true'">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.MENU_CHOIX_FLASH3_FCT_CHOIX_3 =='true'"); ]]></script>	
                <script><![CDATA[
						tabMenu[compteur] = CUSTOMER_IHM.MENU_CHOIX_FLASH3_FCT_CHOIX_3_AUDIO;
						compteur++;
						choix_3 = 'true';
                ]]></script>
                <script><![CDATA[ log_debug_assignment(pageCourante,'choix_3',choix_3); ]]></script>
            </if>
           
            <script><![CDATA[ log_debug_assignment(pageCourante,'compteur',compteur); ]]></script>
            
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "compteur == 0"); ]]></script>	
            <if cond="compteur == 0">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "compteur == 0"); ]]></script>	
	            <script><![CDATA[	
					customNode(applicationName + '_' + '40003_CHOIX_FLASH3_FCT_OK');				
	            ]]></script>            	
                <script><![CDATA[ log_debug_next_form(pageCourante, "NMNI"); ]]></script>
                <goto next="#NMNI"/>
            </if>
            <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_MENU_CHOIX_FLASH3_FCT"); ]]></script>
            <goto next="#VERS_MENU_CHOIX_FLASH3_FCT"/>
        </block>
    </form>

  <!-- ==================================== //-->          
    <form id="VERS_MENU_CHOIX_FLASH3_FCT">
    	<script><![CDATA[ formCourant = "VERS_MENU_CHOIX_FLASH3_FCT"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[	
				customNode(applicationName + '_' + '40003_CHOIX_FLASH3_FCT_OK');				
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "MENU_CHOIX_FLASH3_FCT"); ]]></script>
            <goto next="#MENU_CHOIX_FLASH3_FCT"/>
        </block>
    </form>
        
    <menu id="MENU_CHOIX_FLASH3_FCT">
    	<script><![CDATA[ formCourant = "MENU_CHOIX_FLASH3_FCT"; ]]></script>
    	<script><![CDATA[ menuCourant = formCourant; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <property name="timeout" value="3s"/>
        <property name="termchar" value="A"/>
        <prompt bargein="true">
            <foreach item="itemMenu" array="tabMenu">
                <audio maxage="7200" maxstale="7200" expr="PlayFileCommun(itemMenu)">
                </audio>
            </foreach>
        </prompt>

        <catch event="noinput nomatch" cond="document.errorCounter &lt; 2">
           
            <script><![CDATA[ log_debug_next_form(pageCourante, "nomatch"); ]]></script>
            <goto next="#nomatch"/>
        </catch>
        <catch event="noinput nomatch" cond="document.errorCounter == 2">

            <script><![CDATA[ log_debug_next_form(pageCourante, "NMNI"); ]]></script>
            <goto next="#NMNI"/>
        </catch>
        <choice dtmf="1" next="#Vers_MENU_CHOIX_FLASH3_FCT_1"/>
        <choice dtmf="2" next="#Vers_MENU_CHOIX_FLASH3_FCT_2"/>
        <choice dtmf="3" next="#Vers_MENU_CHOIX_FLASH3_FCT_3"/>
    </menu>

    <form id="nomatch">
    	<script><![CDATA[ formCourant = "nomatch"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
			<script><![CDATA[ track_dtmfList ("MENU_CHOIX_FLASH3_FCT","NMNI"); ]]></script>        
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "document.errorCounter &lt; 2"); ]]></script>	
            <if cond="document.errorCounter &lt; 2">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "document.errorCounter &lt; 2"); ]]></script>	
                <assign name="document.errorCounter" expr="document.errorCounter + 1"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"document.errorCounter", document.errorCounter); ]]></script>
	            <script><![CDATA[
					customNode(applicationName + '_' + '40093_CHOIX_FLASH3_FCT_NMNI');
	            ]]></script>                 
                <prompt>
                    <audio expr="PlayFile('ERREUR_CHOIX_NOUVEAU')"/>
                </prompt>
                <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_MENU_CHOIX_FLASH3_FCT"); ]]></script>
                <goto next="#VERS_MENU_CHOIX_FLASH3_FCT"/>
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "NMNI"); ]]></script>
                <goto next="#NMNI"/>
            </if>
        </block>
    </form>

	  <!-- ==================================== //-->
	  <!-- CHOIX MENU_CHOIX_FLASH3_FCT_1		//-->
	  <!-- ==================================== //-->    
    <form id="Vers_MENU_CHOIX_FLASH3_FCT_1">
    	<script><![CDATA[ formCourant = "Vers_MENU_CHOIX_FLASH3_FCT_1"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
    	<script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant, formCourant + ":CHOIX", "1"); ]]></script>
    	<script><![CDATA[ track_dtmfList ("MENU_CHOIX_FLASH3_FCT", "1"); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "choix_1 == 'false'"); ]]></script>	
            <if cond="choix_1 == 'false'">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "choix_1 == 'false'"); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "nomatch"); ]]></script>
                <goto next="#nomatch"/>
            </if>
            <script><![CDATA[
				customNode(applicationName + '_' + '40013_CHOIX_FLASH3_FCT1');
				POSITION_ARBO = 95;
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
				ID_FLUX='FIXE_CHOIX_FLASH3_FCT';	
				log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);				
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>  
        </block>
    </form>
     
    
	  <!-- ==================================== //-->
	  <!-- CHOIX MENU_CHOIX_FLASH3_FCT_2						    //-->
	  <!-- ==================================== //-->  
    <form id="Vers_MENU_CHOIX_FLASH3_FCT_2">
    	<script><![CDATA[ formCourant = "Vers_MENU_CHOIX_FLASH3_FCT_2"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
    	<script><![CDATA[ log_debug_saisie_dtmf(pageCourante,"CHOIX " + formCourant, formCourant + ":CHOIX", "2"); ]]></script>
    	<script><![CDATA[ track_dtmfList ("MENU_CHOIX_FLASH3_FCT", "2"); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "choix_2 == 'false'"); ]]></script>	
            <if cond="choix_2 == 'false'">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "choix_2 == 'false'"); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "nomatch"); ]]></script>
                <goto next="#nomatch"/>
            </if>
            <script><![CDATA[
				customNode(applicationName + '_' + '40023_CHOIX_FLASH3_FCT2');
				POSITION_ARBO = 96;	
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>  
        </block>
    </form>
    
    <form id="SUITE_MENU_CHOIX_FLASH3_FCT_2">
    	<script><![CDATA[ formCourant = "SUITE_MENU_CHOIX_FLASH3_FCT_2"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
	    	<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.CHOIX_FLASH3_FCT2 != 'false' "); ]]></script>	
	    	<if cond="CUSTOMER_IHM.CHOIX_FLASH3_FCT2 != 'false' ">	
	    		<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.CHOIX_FLASH3_FCT2 != 'false'"); ]]></script>	
	            <script><![CDATA[
					customNode(applicationName + '_' + '40023_CHOIX_FLASH3_FCT2_OK');
					ID_FLUX='FIXE_CHOIX_FLASH3_FCT2';	
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);					
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_TRANSFERT.vxml"); ]]></script>
	            <goto next="./FIXE_TRANSFERT.vxml"/> 	
	                                	    			    
	    	<else />
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>					
	            <script><![CDATA[
					customNode(applicationName + '_' + '40023_CHOIX_FLASH3_FCT2_NOK');				
	            ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "RETOUR_MENU_ADMINISTRATIF"); ]]></script>
	            <goto next="#RETOUR_MENU_ADMINISTRATIF"/>	            	
   				
			</if>
			        
        </block>
    </form>    
        
	  <!-- ==================================== //-->
	  <!-- CHOIX MENU3						    //-->
	  <!-- ==================================== //-->      

    <form id="Vers_MENU_CHOIX_FLASH3_FCT_3">
    	<script><![CDATA[ formCourant = "Vers_MENU_CHOIX_FLASH3_FCT_3"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
    	<script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant, formCourant + ":CHOIX", "3"); ]]></script>
    	<script><![CDATA[ track_dtmfList ("MENU_CHOIX_FLASH3_FCT", "3"); ]]></script>
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "choix_3 == 'false'"); ]]></script>	
            <if cond="choix_3 == 'false'">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "choix_3 == 'false'"); ]]></script>	
                <script><![CDATA[ log_debug_next_form(pageCourante, "nomatch"); ]]></script>
                <goto next="#nomatch"/>
            </if>
            <script><![CDATA[
				customNode(applicationName + '_' + '40033_CHOIX_FLASH3_FCT3');
				POSITION_ARBO = 97;			
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>  
        </block>
    </form>
    
    <form id="SUITE_MENU_CHOIX_FLASH3_FCT_3">
    	<script><![CDATA[ formCourant = "SUITE_MENU_CHOIX_FLASH3_FCT_3"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>

        <block>
	    	<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.CHOIX_FLASH3_FCT3 != 'false' "); ]]></script>	
	    	<if cond="CUSTOMER_IHM.CHOIX_FLASH3_FCT3 != 'false' ">	
	    		<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.CHOIX_FLASH3_FCT3 != 'false'"); ]]></script>	
	            <script><![CDATA[
					customNode(applicationName + '_' + '40033_CHOIX_FLASH3_FCT3_OK');
					ID_FLUX='FIXE_CHOIX_FLASH3_FCT3';	
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);					
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_TRANSFERT.vxml"); ]]></script>
	            <goto next="./FIXE_TRANSFERT.vxml"/> 	
	                                	    			    
	    	<else />
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>					
	            <script><![CDATA[
					customNode(applicationName + '_' + '40033_CHOIX_FLASH3_FCT3_NOK');				
	            ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "RETOUR_MENU_ADMINISTRATIF"); ]]></script>
	            <goto next="#RETOUR_MENU_ADMINISTRATIF"/>	            	
   				
			</if>
			        

        </block>
    </form>      
       
        
	  <!-- ==================================== //-->
	  <!-- NMNI  					    //-->
	  <!-- ==================================== //-->  
    <form id="NMNI">
    	<script><![CDATA[ formCourant = "NMNI"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <prompt bargein="true">
                <audio expr="PlayFile('ERREUR_CHOIX_QUIT')"/>
            </prompt>        
	    	<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.CHOIX_FLASH3_FCT_NMNI != 'false' "); ]]></script>	
	    	<if cond="CUSTOMER_IHM.CHOIX_FLASH3_FCT_NMNI != 'false' ">	
	    		<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.CHOIX_FLASH3_FCT_NMNI != 'false'"); ]]></script>	
	            <script><![CDATA[
					customNode(applicationName + '_' + '40093_CHOIX_FLASH3_FCT_NMNI2');
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, pageDisconnect); ]]></script>
	            <goto next="./FIXE_DISCONNECT.vxml"/>	
	                                	    			    
	    	<else />
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>					
	            <script><![CDATA[
					customNode(applicationName + '_' + '40093_CHOIX_FLASH3_FCT_NMNI2B');				
	            ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "RETOUR_MENU_ADMINISTRATIF"); ]]></script>
	            <goto next="#RETOUR_MENU_ADMINISTRATIF"/>	            	
   				
			</if>
			        	
        </block>
    </form>
    
	  <!-- ==================================== //-->
	  <!-- RETOUR MENU_ADMINISTRATIF		    //-->
	  <!-- ==================================== //-->  
    <form id="RETOUR_MENU_ADMINISTRATIF">
    	<script><![CDATA[ formCourant = "RETOUR_MENU_ADMINISTRATIF"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_ADMINISTRATIF.vxml#SUITE_TRT_FLASH_FCT"); ]]></script>
            <goto next="./FIXE_ADMINISTRATIF.vxml#SUITE_TRT_FLASH_FCT"/>	            			        	
