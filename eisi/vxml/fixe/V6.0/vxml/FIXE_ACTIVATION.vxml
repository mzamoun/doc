            <if cond="CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital == 'FIXE' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital == 'FIXE' "); ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_WCB_DIGITAL.vxml#Wcb_Activation_PREMIUM"); ]]></script>
                <goto next="./FIXE_WCB_DIGITAL.vxml#Wcb_Activation_PREMIUM"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "GestionTypeClientPremium"); ]]></script>
                <goto next="#GestionTypeClientPremium"/>

            </if>
        </block>
    </form>
    
    <form id="ACTIVATION_WCB_DIGITAL_GP">
        <script><![CDATA[ formCourant = "ACTIVATION_WCB_DIGITAL_GP"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <!--	Client en provenance de WCB_DIGITAL		-->
        <block>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital == 'FIXE' "); ]]></script>
            <if cond="CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital == 'FIXE' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.WCB_DIGITAL != 'false' &amp;&amp; type_appel_wcb_digital == 'FIXE' "); ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_WCB_DIGITAL.vxml#Wcb_Activation_GP"); ]]></script>
                <goto next="./FIXE_WCB_DIGITAL.vxml#Wcb_Activation_GP"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "GestionTypeClient"); ]]></script>
                <goto next="#GestionTypeClient"/>

            </if>
        </block>
    </form>
        

    <!--Client ACTIVATION - Type Client PREMIUM  -->
    <form id="GestionTypeClientPremium">
        <script><![CDATA[ formCourant = "GestionTypeClientPremium"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>

            <!-- Client PREMIUM -  FTTB - APPORTEUR= MIG_NC	-->                
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientFixeMIG_NC() "); ]]></script>
            <if cond="isClientFixeMIG_NC() ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeMIG_NC() "); ]]></script>                                                                    
            
	            <script><![CDATA[
					customNode(applicationName + '_' + '00010_ACTIV_PREMIUM_FTTB_MIG');
					ID_FLUX='ACTIV_PREMIUM_FTTB_MIG';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
	            ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/> 


            <!-- Client PREMIUM  - FTTB -->
            <elseif cond="isClientFixeFTTB()"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTB() "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00010_ACTIV_PREMIUM_FTTB');
					ID_FLUX='ACTIV_PREMIUM_FTTB';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/> 


                <!-- Client PREMIUM  - FTTH -->
            <elseif cond="isClientFixeFTTH() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH() "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00010_ACTIV_PREMIUM_FTTH');
					ID_FLUX='ACTIV_PREMIUM_FTTH';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/> 

                <!-- Client PREMIUM  - AUTRE-->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
	                customNode(applicationName + '_' + '00010_ACTIV_PREMIUM_AUTRE');
					ID_FLUX='ACTIV_PREMIUM_ADSL';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>  

            </if>                

        </block>
    </form>
    
        
    <!--Client ACTIVATION - Type Client GP  -->
    <form id="GestionTypeClient">
        <script><![CDATA[ formCourant = "GestionTypeClient"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
               
			<!-- Client GP -->                      
            <!-- Client CABLE - APPORTEUR= MIG_NC	-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isClientFixeMIG_NC() "); ]]></script>
            <if cond="isClientFixeMIG_NC() ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeMIG_NC() "); ]]></script>                                                                                 
	            <script><![CDATA[
						customNode(applicationName + '_' + '00010_ACTIV_FTTB_MIG');
						ID_FLUX='ACTIV_FTTB_MIG';			
						log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
	            ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>  


            <!-- Client CABLE* -->
            <elseif cond="isClientFixeFTTB() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTB() "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00010_ACTIV_FTTB');
					ID_FLUX='ACTIV_FTTB';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>  


                <!-- Client FTTH -->
            <elseif cond="isClientFixeFTTH() "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isClientFixeFTTH() "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '00010_ACTIV_FTTH');
					ID_FLUX='ACTIV_FTTH';			
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>  


                <!-- cas par défaut	-->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
	                customNode(applicationName + '_' + '00010_ACTIV_AUTRE');
					ID_FLUX='ACTIV_ADSL';
					log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "Transfert"); ]]></script>
                <goto next="#Transfert"/>  
            </if>

        </block>
    </form>

    <form id="Transfert">
        <script><![CDATA[ formCourant = "Transfert"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_TRANSFERT.vxml"); ]]></script>
            <goto next="./FIXE_TRANSFERT.vxml"/>
        </block>
    </form>       

</vxml>
