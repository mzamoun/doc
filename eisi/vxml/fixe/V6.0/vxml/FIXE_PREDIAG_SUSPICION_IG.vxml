    <form id="FILTRE_SUSPICION_IG">
        <script><![CDATA[ formCourant = "FILTRE_SUSPICION_IG"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[
			var ndi = CUSTOMER_DEXTER.RESSOURCE_PRINCIPALE;
        ]]></script>
        <script><![CDATA[ log_debug_assignment(pageCourante,'ndi', ndi); ]]></script>
        <script><![CDATA[ log_debug_appel_web_app(pageCourante, 'WS_BOX_SUSPICION_IG', subdialogWS_BOX_SUSPICION_IG , 'ndi=' + ndi  ); ]]></script>
        <subdialog name="WS_BOX_SUSPICION_IG"
                   srcexpr="subdialogWS_BOX_SUSPICION_IG"
                   namelist="ndi"
                   method="get"
                   fetchtimeout="120s"
                   fetchaudio="../../../audio/Attente.wav"/>

        <catch event="error">
            <script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>           
            <!--	gestion des stat des erreurs WS SUPICION_ig -->
            <script><![CDATA[
				customNode(applicationName + '_' + '20044_WS_DIAG_FRONT_SUSPICION_IG_HS');
            ]]></script>  
            <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_MENU_TECHNIQUE_CC"); ]]></script>
            <goto next="#VERS_MENU_TECHNIQUE_CC"/>             
                            
        </catch>

        <block>
            <script><![CDATA[ log_debug_result_web_app(pageCourante, 'WS_BOX_SUSPICION_IG', WS_BOX_SUSPICION_IG ); ]]></script>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " WS_BOX_SUSPICION_IG.APP_STATUS == 'NOK' || WS_BOX_SUSPICION_IG.WS_STATUS_SUSPICION_IG == 'NOK' "); ]]></script>
            <if cond=" WS_BOX_SUSPICION_IG.APP_STATUS == 'NOK' || WS_BOX_SUSPICION_IG.WS_STATUS_SUSPICION_IG == 'NOK' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " WS_BOX_SUSPICION_IG.APP_STATUS == 'NOK' || WS_BOX_SUSPICION_IG.WS_STATUS_SUSPICION_IG == 'NOK' "); ]]></script>
                            
                <!--	gestion des stat des erreurs WS SUPICION_ig -->
                <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "WS_BOX_SUSPICION_IG.CODE_ERREUR_WS  &amp;&amp; WS_BOX_SUSPICION_IG.CODE_ERREUR_WS != '' &amp;&amp; WS_BOX_SUSPICION_IG.CODE_ERREUR_WS != 'undefined'"); ]]></script>
                <if cond=" WS_BOX_SUSPICION_IG.CODE_ERREUR_WS  &amp;&amp; WS_BOX_SUSPICION_IG.CODE_ERREUR_WS != '' &amp;&amp; WS_BOX_SUSPICION_IG.CODE_ERREUR_WS != 'undefined' ">
                    <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "WS_BOX_SUSPICION_IG.CODE_ERREUR_WS  &amp;&amp; WS_BOX_SUSPICION_IG.CODE_ERREUR_WS != '' &amp;&amp; WS_BOX_SUSPICION_IG.CODE_ERREUR_WS != 'undefined'"); ]]></script>
                    <script><![CDATA[
						customNode(applicationName + '_' + '20044_WS_DIAG_FRONT_SUSPICION_IG_HS_'+ WS_BOX_SUSPICION_IG.CODE_ERREUR_WS+'_'+ WS_BOX_SUSPICION_IG.LIBELLE_ERREUR_WS);
                    ]]></script>
	            <else/>
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                    <script><![CDATA[
						customNode(applicationName + '_' + '20044_WS_DIAG_FRONT_SUSPICION_IG_HS');
                    ]]></script>                  
                </if>                
                <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_MENU_TECHNIQUE_CC"); ]]></script>
                <goto next="#VERS_MENU_TECHNIQUE_CC"/> 
	                            

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <assign name="CUSTOMER_BOX_SUSPICION_IG" expr="WS_BOX_SUSPICION_IG"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"CUSTOMER_BOX_SUSPICION_IG", WS_BOX_SUSPICION_IG); ]]></script>

            </if>

            <!--	BOX SUSPICION OK -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isBoxSuspicionIg_OK()"); ]]></script>
            <if cond=" isBoxSuspicionIg_OK() ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isBoxSuspicionIg_OK() "); ]]></script>

                <script><![CDATA[ log_debug_next_form(pageCourante, "FILTRE_SUSPICION_IG_TRF"); ]]></script>
                <goto next="#FILTRE_SUSPICION_IG_TRF"/>         

            <!--	BOX SUSPICION NON -->
            <elseif cond="isBoxSuspicionIg_NON()"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isBoxDown()"); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '20044_WS_DIAG_FRONT_SUSPICION_IG_NON');						
                ]]></script>
                <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_MENU_TECHNIQUE_CC"); ]]></script>
                <goto next="#VERS_MENU_TECHNIQUE_CC"/>                
                                              
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <!--	gestion des stat des erreurs WS SUPICION_ig -->
                <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_BOX_SUSPICION_IG.CODE_ERREUR_WS  &amp;&amp; CUSTOMER_BOX_SUSPICION_IG.CODE_ERREUR_WS != '' &amp;&amp; CUSTOMER_BOX_SUSPICION_IG.CODE_ERREUR_WS != 'undefined'"); ]]></script>
                <if cond=" CUSTOMER_BOX_SUSPICION_IG.CODE_ERREUR_WS  &amp;&amp; CUSTOMER_BOX_SUSPICION_IG.CODE_ERREUR_WS != '' &amp;&amp; CUSTOMER_BOX_SUSPICION_IG.CODE_ERREUR_WS != 'undefined' ">
                    <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_BOX_SUSPICION_IG.CODE_ERREUR_WS  &amp;&amp; CUSTOMER_BOX_SUSPICION_IG.CODE_ERREUR_WS != '' &amp;&amp; CUSTOMER_BOX_SUSPICION_IG.CODE_ERREUR_WS != 'undefined'"); ]]></script>
                    <script><![CDATA[
						customNode(applicationName + '_' + '20044_WS_DIAG_FRONT_SUSPICION_IG_NOK_'+ CUSTOMER_BOX_SUSPICION_IG.CODE_ERREUR_WS+'_'+ CUSTOMER_BOX_SUSPICION_IG.LIBELLE_ERREUR_WS);
                    ]]></script>
	            <else/>
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                    <script><![CDATA[
						customNode(applicationName + '_' + '20044_WS_DIAG_FRONT_SUSPICION_IG_NOK');
                    ]]></script>                  
                </if>                                
                
                <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_MENU_TECHNIQUE_CC"); ]]></script>
                <goto next="#VERS_MENU_TECHNIQUE_CC"/>
            </if>

        </block>
    </form> 
    
