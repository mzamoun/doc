        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '20043_WS_HISPEED_KO');		
				POSITION_ARBO = 181;
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>              
            
        </block>
    </form> 
    
    <form id="RECO_HISPEED_OK_IDUR_VIDE">
        <script><![CDATA[ formCourant = "RECO_HISPEED_OK_IDUR_VIDE"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '20043_HISPEED_IDUR_VIDE');		
				POSITION_ARBO = 181;
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>              
            
        </block>
    </form>        
    
    
    <!--###########################################
         VERS APPEL DIAG_FRONT - STATUS_MODEM
    ########################################### -->
    <form id="Vers_APPEL_STATUS_MODEM">
        <script><![CDATA[ formCourant = "Vers_APPEL_STATUS_MODEM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
	        <prompt bargein="true">
	    		<audio maxage="7200" maxstale="7200" expr="PlayFileCommun(CUSTOMER_IHM.FIXE_PREDIAG_INFO_PREDIAG_AUDIO)"/>
	        </prompt>
            <script><![CDATA[
				customNode(applicationName + '_' + '20044_WS_PREDIAG_DIAG_FRONT');			
            ]]></script>	        	        
            <script><![CDATA[ log_debug_next_form(pageCourante, "FILTRE_APPEL_STATUS_MODEM"); ]]></script>
            <goto next="#FILTRE_APPEL_STATUS_MODEM"/>

        </block>
    </form>
    
    <form id="FILTRE_APPEL_STATUS_MODEM">
        <script><![CDATA[ formCourant = "FILTRE_APPEL_STATUS_MODEM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>            
            <!-- filtre activé-->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.STATUS_MODEM != 'false'"); ]]></script>
            <if cond="CUSTOMER_IHM.STATUS_MODEM != 'false'">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.STATUS_MODEM != 'false'"); ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "HISTORISATION_APPEL_PREDIAG"); ]]></script>
	            <goto next="#HISTORISATION_APPEL_PREDIAG"/>

                <!-- filtre descative-->
            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '20044_WS_PREDIAG_DIAG_FRONT_OFF');			
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_MENU_TECHNIQUE_CC"); ]]></script>
	            <goto next="#VERS_MENU_TECHNIQUE_CC"/>

            </if>
        </block>
    </form> 
    
    
    <form id="HISTORISATION_APPEL_PREDIAG">
        <script><![CDATA[ formCourant = "HISTORISATION_APPEL_PREDIAG"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[
			var ndi  = CUSTOMER_DEXTER.RESSOURCE_PRINCIPALE;
        ]]></script>
        <script><![CDATA[ log_debug_appel_web_app(pageCourante, 'PREDIAG_HISTOSIATION', subdialogPrediagHistorisation , 'ndi='+ndi ); ]]></script>
        <subdialog name="PREDIAG_HISTOSIATION"
                   srcexpr="subdialogPrediagHistorisation"
                   namelist="ndi"
                   method="post"
                   fetchtimeout="3s"
                   fetchaudio="../../../audio/Attente.wav">
            <catch event="error"> <!-- webapp KO -->
                <script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
				<script><![CDATA[
					customNode(applicationName + '_' + '80000_SUBDIALOG_PREDIAG_HISTORISATION_HS');
				]]></script>               
                <script><![CDATA[ log_debug_next_form(pageCourante, "APPEL_STATUS_MODEM"); ]]></script>
                <goto next="#APPEL_STATUS_MODEM"/>
            </catch>
        </subdialog>

        <block>
            <script><![CDATA[ log_debug_result_web_app(pageCourante, 'PREDIAG_HISTOSIATION', PREDIAG_HISTOSIATION); ]]></script>
            <!--	traitement KO - HS -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "PREDIAG_HISTOSIATION.APP_STATUS == 'NOK'"); ]]></script>
            <if cond="PREDIAG_HISTOSIATION.APP_STATUS == 'NOK' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "PREDIAG_HISTOSIATION.APP_STATUS == 'NOK' "); ]]></script>
				<script><![CDATA[
					customNode(applicationName + '_' + '80000_SUBDIALOG_PREDIAG_HISTORISATION_HS');
				]]></script>                 
                <script><![CDATA[ log_debug_next_form(pageCourante, "APPEL_STATUS_MODEM"); ]]></script>
                <goto next="#APPEL_STATUS_MODEM"/>                             
			
            <!--	traitement web app OK  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	

	 	 		<!--	traitement OK - et historisation ok -->
	            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "PREDIAG_HISTOSIATION.RECORDED == 'true'"); ]]></script>
	            <if cond="PREDIAG_HISTOSIATION.RECORDED == 'true'">
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "PREDIAG_HISTOSIATION.RECORDED == 'true'"); ]]></script>            		
	                <script><![CDATA[ log_debug_next_form(pageCourante, "APPEL_STATUS_MODEM"); ]]></script>
	                <goto next="#APPEL_STATUS_MODEM"/>   
				
	            <!--	traitement OK - et appel non eligible -->                                
	            <else/>
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
		            <script><![CDATA[
						customNode(applicationName + '_' + '20044_WS_BOX_HISTORISATION_APPEL_KO');			
		            ]]></script>
	                <script><![CDATA[ log_debug_next_form(pageCourante, "APPEL_STATUS_MODEM"); ]]></script>
	                <goto next="#APPEL_STATUS_MODEM"/>                
	            </if>              	                
           
            </if>               
                      
        </block>
