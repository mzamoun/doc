    <!--
        Auteur :				IMA/CZO
        Date de Creation :		19/12/2022
        Page :                  Application FIXE - PREDIAG_SUSPICION_IG
        Modification        	IMA/CZO	03/11/2023		Integration du traitement d'exclusion au reboot modem suivant IAD_MODEL
														  	                            
    -->
    <script><![CDATA[
		applicationName = "FIXE"; appSvi = applicationName;
		var pageCourante = "FIXE_PREDIAG_SUSPICION_IG.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
    ]]></script>

    <var name="errorCounter" expr="1"/>



    <!--########################################################################
         TRAITEMENT ELIGIBILITE PREDIAG
    ######################################################################## -->

    <form id="VERS_ELIGIBILITE_PREDIAG">
        <script><![CDATA[ formCourant = "VERS_ELIGIBILITE_PREDIAG"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!-- eligibilite prediag active  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.ELIGIBILITE_PREDIAG == 'true'"); ]]></script>
            <if cond="CUSTOMER_IHM.ELIGIBILITE_PREDIAG == 'true'">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.ELIGIBILITE_PREDIAG == 'true'"); ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "PRE_TRAITEMENT_ELIGIBILITE_PREDIAG"); ]]></script>
	            <goto next="#PRE_TRAITEMENT_ELIGIBILITE_PREDIAG"/>               

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>               
	            <script><![CDATA[ log_debug_next_form(pageCourante, "ELIGIBILITE_PREDIAG_OFF"); ]]></script>
	            <goto next="#ELIGIBILITE_PREDIAG_OFF"/>

            </if>
        </block>
    </form>
    
    <!--	PRE TRAITEMENT: Eligibilite par rapport au nombre d'appel du mm ndi au PREDIAG   -->
    <form id="PRE_TRAITEMENT_ELIGIBILITE_PREDIAG">
        <script><![CDATA[ formCourant = "PRE_TRAITEMENT_ELIGIBILITE_PREDIAG"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[
			var ndi = NDI;
		    if ( isDexterRessourcePrincipaleValid()){
				ndi  = CUSTOMER_DEXTER.RESSOURCE_PRINCIPALE;
		    }
		    else{
				ndi  = NDI;
		    }
        ]]></script>        
        <script><![CDATA[ log_debug_appel_web_app(pageCourante, 'ELIGIBILITE_PREDIAG_HISTO', subdialogEligibilityPrediagHisto , 'ndi='+ndi ); ]]></script>
        <subdialog name="ELIGIBILITE_PREDIAG_HISTO"
                   srcexpr="subdialogEligibilityPrediagHisto"
                   namelist="ndi"
                   method="post"
                   fetchtimeout="5s"
                   fetchaudio="../../../audio/Attente.wav">
            <catch event="error"> <!-- webapp KO -->
                <script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
				<script><![CDATA[
					customNode(applicationName + '_' + '80000_SUBDIALOG_PREDIAG_ELIGIBILITE_NBRE_APPEL_HS');
				]]></script>              
                <script><![CDATA[ log_debug_next_form(pageCourante, "ELIGIBILITE_PREDIAG_KO"); ]]></script>
                <goto next="#ELIGIBILITE_PREDIAG_KO"/>
            </catch>
        </subdialog>

        <block>
            <script><![CDATA[ log_debug_result_web_app(pageCourante, 'ELIGIBILITE_PREDIAG_HISTO', ELIGIBILITE_PREDIAG_HISTO); ]]></script>
            <!--	traitement KO - HS -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "ELIGIBILITE_PREDIAG_HISTO.APP_STATUS == 'NOK'"); ]]></script>
            <if cond="ELIGIBILITE_PREDIAG_HISTO.APP_STATUS == 'NOK' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELIGIBILITE_PREDIAG_HISTO.APP_STATUS == 'NOK' "); ]]></script>
				<script><![CDATA[
					customNode(applicationName + '_' + '80000_SUBDIALOG_PREDIAG_ELIGIBILITE_NBRE_APPEL_HS');
				]]></script>                 
                <script><![CDATA[ log_debug_next_form(pageCourante, "ELIGIBILITE_PREDIAG_KO"); ]]></script>
                <goto next="#ELIGIBILITE_PREDIAG_KO"/>                             
			
            <!--	traitement web app OK  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <assign name="CUSTOMER_ELIGIBILITE_PREDIAG_HISTO" expr="ELIGIBILITE_PREDIAG_HISTO"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"CUSTOMER_ELIGIBILITE_PREDIAG_HISTO", ELIGIBILITE_PREDIAG_HISTO); ]]></script>
                 
                <script><![CDATA[ log_debug_next_form(pageCourante, "ELIGIBILITE_PREDIAG"); ]]></script>
                <goto next="#ELIGIBILITE_PREDIAG"/>                                                                       
                
            </if>               
                      
        </block>
    </form>     
        
    <form id="ELIGIBILITE_PREDIAG">
        <script><![CDATA[ formCourant = "ELIGIBILITE_PREDIAG"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!-- eligibilite prediag: nbre appel par jour + dexter: (type_materiel,techno) ou (code_produit, techno) + ressource_principale est un num fixe  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "isEligiblePrediag()"); ]]></script>
            <if cond="isEligiblePrediag()">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isEligiblePrediag()"); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '20043_ELIGIBILITE_PREDIAG_OK');
					POSITION_ARBO = 41;
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
                <goto next="./FIXE_FLASH_INC.vxml"/>                

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "ELIGIBILITE_PREDIAG_KO"); ]]></script>
	            <goto next="#ELIGIBILITE_PREDIAG_KO"/>

            </if>
        </block>
    </form>
    
    <form id="ELIGIBILITE_PREDIAG_OFF">
        <script><![CDATA[ formCourant = "ELIGIBILITE_PREDIAG_OFF"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '20043_ELIGIBILITE_PREDIAG_OFF');
				POSITION_ARBO = 42;
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/> 
        </block>
    </form> 
        
    <form id="ELIGIBILITE_PREDIAG_KO">
        <script><![CDATA[ formCourant = "ELIGIBILITE_PREDIAG_KO"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '20043_ELIGIBILITE_PREDIAG_NOK');
				POSITION_ARBO = 42;
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/> 
        </block>
    </form>    
    
    <!--########################################################################
         CTRL APPEL A PARTIR BOX CLIENT
    ######################################################################## -->

    <form id="CTRL_APPEL_BOX_CLIENT">
        <script><![CDATA[ formCourant = "CTRL_APPEL_BOX_CLIENT"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <!-- Autoriser les appels non identifie automatiquement à partir de leurs box  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_IHM.APPEL_LIGNE_BOX == 'true' &amp;&amp; FIXE_RECO_AUTO_NUM_FIXE !='true' "); ]]></script>
            <if cond="CUSTOMER_IHM.APPEL_LIGNE_BOX == 'true' &amp;&amp; FIXE_RECO_AUTO_NUM_FIXE !='true'">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.APPEL_LIGNE_BOX == 'true' &amp;&amp; FIXE_RECO_AUTO_NUM_FIXE !='true' "); ]]></script>
                <script><![CDATA[
	                customNode(applicationName + '_' + '20043_APPEL_LIGNE_BOX_NOK');	
					POSITION_ARBO = 43;
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
                <goto next="./FIXE_FLASH_INC.vxml"/> 

            <elseif cond="CUSTOMER_IHM.APPEL_LIGNE_BOX != 'true' "/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_IHM.APPEL_LIGNE_BOX != 'true'"); ]]></script>
                <script><![CDATA[
	                customNode(applicationName + '_' + '20043_APPEL_LIGNE_BOX_OFF');	
					POSITION_ARBO = 44;
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
                <goto next="./FIXE_FLASH_INC.vxml"/> 

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <script><![CDATA[
	                customNode(applicationName + '_' + '20043_APPEL_LIGNE_BOX_OK');
					POSITION_ARBO = 44;
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
                <goto next="./FIXE_FLASH_INC.vxml"/> 

            </if>

        </block>
    </form>    

 
    
    <!--###########################################
        Appel HISPEED - recup IDUR
    ########################################### -->  
    <form id="RECO_HISPEED">
    	<script><![CDATA[ formCourant = "RECO_HISPEED"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
      	<script><![CDATA[
			ndi= CUSTOMER_DEXTER.RESSOURCE_PRINCIPALE;            
	    ]]></script>
	    
		<script><![CDATA[ log_debug_appel_web_app(pageCourante, 'BDDClientHISPEED', subdialogHISPEED , 'ndi=' + ndi  ); ]]></script>
	
	      <subdialog name="BDDClientHISPEED" 
	      	srcexpr="subdialogHISPEED" 
	      	namelist="ndi" 
	      	method="get" 
	      	fetchtimeout="10s" 
	      	fetchaudio="../../../audio/Attente.wav"/>
	      <catch event="error">
	      		<script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
				<script><![CDATA[
					customNode(applicationName + '_' + '80000_RECO_HISPEED_HS');
				]]></script>              
	            <script><![CDATA[ log_debug_next_form(pageCourante, "RECO_HISPEED_KO"); ]]></script>
	            <goto next="#RECO_HISPEED_KO" /> 			
	      </catch>

      <block>
      		<script><![CDATA[ log_debug_result_web_app(pageCourante, 'BDDClientHISPEED', BDDClientHISPEED ); ]]></script> 
     		<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " BDDClientHISPEED.APP_STATUS == 'NOK' || BDDClientHISPEED.HISPEED_STATUS == 'NOK' "); ]]></script>	
     		<if cond=" BDDClientHISPEED.APP_STATUS == 'NOK' || BDDClientHISPEED.HISPEED_STATUS == 'NOK' ">
     			<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " BDDClientHISPEED.APP_STATUS == 'NOK' || BDDClientHISPEED.HISPEED_STATUS == 'NOK' "); ]]></script>	
				<script><![CDATA[ log_appel_web_app_nok(pageCourante, 'BDDClientHISPEED', subdialogHISPEED , 'ndi=' + NDI ); ]]></script>
				<script><![CDATA[
					customNode(applicationName + '_' + '80000_RECO_HISPEED_HS');
				]]></script> 	
				<script><![CDATA[ log_debug_next_form(pageCourante, "RECO_HISPEED_KO"); ]]></script>
				<goto next="#RECO_HISPEED_KO"/>					
			</if>   
			   
      		<!--	Client reconnu dans hispeed et IDUR est retourné et non vide-->	
			<script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "BDDClientHISPEED.NDI_FOUND == 'true' &amp;&amp; BDDClientHISPEED.IDUR !='' &amp;&amp; BDDClientHISPEED.IDUR !='null' "); ]]></script>	
			<if cond="BDDClientHISPEED.NDI_FOUND == 'true' &amp;&amp; BDDClientHISPEED.IDUR !='' &amp;&amp; BDDClientHISPEED.IDUR !='null'">     
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "BDDClientHISPEED.NDI_FOUND == 'true' &amp;&amp; BDDClientHISPEED.IDUR !='' &amp;&amp; BDDClientHISPEED.IDUR !='null'"); ]]></script>	

                <assign name="IDUR" expr="BDDClientHISPEED.IDUR"/> 
                <script><![CDATA[ log_debug_assignment(pageCourante,"IDUR", IDUR); ]]></script>				
				<script><![CDATA[ log_debug_next_form(pageCourante, "RECO_HISPEED_OK"); ]]></script>
				<goto next="#RECO_HISPEED_OK"/>
				
           <!--	Client reconnu dans hispeed et IDUR  vide-->	
            <elseif cond="BDDClientHISPEED.NDI_FOUND == 'true' &amp;&amp; (BDDClientHISPEED.IDUR =='' || BDDClientHISPEED.IDUR =='null')"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "BDDClientHISPEED.NDI_FOUND == 'true' &amp;&amp; (BDDClientHISPEED.IDUR =='' || BDDClientHISPEED.IDUR =='null')"); ]]></script>
                <assign name="IDUR" expr="BDDClientHISPEED.IDUR"/> 
                <script><![CDATA[ log_debug_assignment(pageCourante,"IDUR", IDUR); ]]></script>				
				<script><![CDATA[ log_debug_next_form(pageCourante, "RECO_HISPEED_OK_IDUR_VIDE"); ]]></script>
				<goto next="#RECO_HISPEED_OK_IDUR_VIDE"/>					
	            								            				
			<!--	Client non reconnu dans hispeed -->									
			<else />
				<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	

				<script><![CDATA[ log_debug_next_form(pageCourante, "RECO_HISPEED_KO"); ]]></script>
				<goto next="#RECO_HISPEED_KO"/>
            </if>  
           
      </block>
   </form>
   
    <form id="RECO_HISPEED_OK">
        <script><![CDATA[ formCourant = "RECO_HISPEED_OK"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '20044_WS_HISPEED_OK');			
            ]]></script>        
			<script><![CDATA[ log_debug_next_form(pageCourante, "Vers_APPEL_STATUS_MODEM"); ]]></script>
			<goto next="#Vers_APPEL_STATUS_MODEM"/>	
            
        </block>
    </form>
       
