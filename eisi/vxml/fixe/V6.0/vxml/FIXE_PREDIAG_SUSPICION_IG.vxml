    <!--###########################################
         TEST PREDIAG - STATUS_MODEM
    ########################################### -->
    <form id="APPEL_STATUS_MODEM">
        <script><![CDATA[ formCourant = "APPEL_STATUS_MODEM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[
			var idur = IDUR;
			var techno = '' ; 
				if ( isClientFixeFTTH()) {
					techno = 'FTTH' ;
				}
				else if ( isClientFixeFTTB())
				{
					techno = 'FTTB' ;	
   		        }
   		        else {
					techno = 'ADSL' ;
             	}			
        ]]></script>
        <script><![CDATA[ log_debug_assignment(pageCourante,'idur', idur); ]]></script>
        <script><![CDATA[ log_debug_assignment(pageCourante,'techno', techno); ]]></script>
        <script><![CDATA[ log_debug_appel_web_app(pageCourante, 'WS_BOX_STATUS_MODEM', subdialogWS_BOX_STATUS_MODEM , 'idur=' + idur +'|techno=' + techno  ); ]]></script>
        <subdialog name="WS_BOX_STATUS_MODEM"
                   srcexpr="subdialogWS_BOX_STATUS_MODEM"
                   namelist="idur techno"
                   method="get"
                   fetchtimeout="120s"
                   fetchaudio="../../../audio/Attente.wav"/>

        <catch event="error">
            <script><![CDATA[ log_error_parcours(pageCourante, formCourant + "_catch_error_HS", _event, _message); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '20044_WS_PREDIAG_DIAG_FRONT_HS');
            ]]></script>             
            <script><![CDATA[ log_debug_next_form(pageCourante, "BOX_DOWN"); ]]></script>
            <goto next="#BOX_DOWN"/>
        </catch>

        <block>
            <script><![CDATA[ log_debug_result_web_app(pageCourante, 'WS_BOX_STATUS_MODEM', WS_BOX_STATUS_MODEM ); ]]></script>
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " WS_BOX_STATUS_MODEM.APP_STATUS == 'NOK' || WS_BOX_STATUS_MODEM.WS_STATUS_MODEM_STATUS == 'NOK' "); ]]></script>
            <if cond=" WS_BOX_STATUS_MODEM.APP_STATUS == 'NOK' || WS_BOX_STATUS_MODEM.WS_STATUS_MODEM_STATUS == 'NOK' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " WS_BOX_STATUS_MODEM.APP_STATUS == 'NOK' || WS_BOX_STATUS_MODEM.WS_STATUS_MODEM_STATUS == 'NOK' "); ]]></script>                
                <!--	gestion des stat des erreurs WS STATUS_MODEM -->
                <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "WS_BOX_STATUS_MODEM.CODE_ERREUR_WS  &amp;&amp; WS_BOX_STATUS_MODEM.CODE_ERREUR_WS != '' &amp;&amp; WS_BOX_STATUS_MODEM.CODE_ERREUR_WS != 'undefined'"); ]]></script>
                <if cond=" WS_BOX_STATUS_MODEM.CODE_ERREUR_WS  &amp;&amp; WS_BOX_STATUS_MODEM.CODE_ERREUR_WS != '' &amp;&amp; WS_BOX_STATUS_MODEM.CODE_ERREUR_WS != 'undefined' ">
                    <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "WS_BOX_STATUS_MODEM.CODE_ERREUR_WS  &amp;&amp; WS_BOX_STATUS_MODEM.CODE_ERREUR_WS != '' &amp;&amp; WS_BOX_STATUS_MODEM.CODE_ERREUR_WS != 'undefined'"); ]]></script>
                    <script><![CDATA[
						customNode(applicationName + '_' + '20044_WS_PREDIAG_DIAG_FRONT_HS_'+ WS_BOX_STATUS_MODEM.CODE_ERREUR_WS+'_'+ WS_BOX_STATUS_MODEM.LIBELLE_ERREUR_WS);
                    ]]></script>
	            <else/>
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                    <script><![CDATA[
						customNode(applicationName + '_' + '20044_WS_PREDIAG_DIAG_FRONT_HS');
                    ]]></script>                  
                </if> 
                                
                <script><![CDATA[ log_debug_next_form(pageCourante, "BOX_DOWN"); ]]></script>
                <goto next="#BOX_DOWN"/>

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
                <assign name="CUSTOMER_BOX_STATUS_MODEM" expr="WS_BOX_STATUS_MODEM"/>
                <script><![CDATA[ log_debug_assignment(pageCourante,"CUSTOMER_BOX_STATUS_MODEM", WS_BOX_STATUS_MODEM); ]]></script>

            </if>

	            
	                        
            <!--	IAD_MODEL non eligible au rebbot_box  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_BOX_STATUS_MODEM.IAD_MODEL  &amp;&amp; CUSTOMER_BOX_STATUS_MODEM.IAD_MODEL != '' &amp;&amp; CUSTOMER_BOX_STATUS_MODEM.IAD_MODEL_ELIG_REBOOT == 'false' "); ]]></script>
            <if cond=" CUSTOMER_BOX_STATUS_MODEM.IAD_MODEL  &amp;&amp; CUSTOMER_BOX_STATUS_MODEM.IAD_MODEL != '' &amp;&amp; CUSTOMER_BOX_STATUS_MODEM.IAD_MODEL_ELIG_REBOOT == 'false' ">
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_BOX_STATUS_MODEM.IAD_MODEL  &amp;&amp; CUSTOMER_BOX_STATUS_MODEM.IAD_MODEL != '' &amp;&amp; CUSTOMER_BOX_STATUS_MODEM.IAD_MODEL_ELIG_REBOOT == 'false'"); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '20044_WS_PREDIAG_DIAG_FRONT_EXCLU_BOX_'+ CUSTOMER_BOX_STATUS_MODEM.IAD_MODEL);				
                ]]></script>
	            <script><![CDATA[ log_debug_next_form(pageCourante, "VERS_MENU_TECHNIQUE_CC"); ]]></script>
	            <goto next="#VERS_MENU_TECHNIQUE_CC"/>                 

            <!--	WS_BOX_STATUS_MODEM UP  -->
            <elseif cond=" isBoxUp()"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isBoxUp()"); ]]></script>                
                <script><![CDATA[
					customNode(applicationName + '_' + '20044_WS_BOX_UP');
					POSITION_ARBO = 45;
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
                <goto next="./FIXE_FLASH_INC.vxml"/>  
                                
            <!--	WS_BOX_STATUS_MODEM DOWN  -->
            <elseif cond="isBoxDown()"/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "isBoxDown()"); ]]></script>                
                <script><![CDATA[ log_debug_next_form(pageCourante, "BOX_DOWN"); ]]></script>
                <goto next="#BOX_DOWN"/>                

            <else/>
                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>

                <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, "CUSTOMER_BOX_STATUS_MODEM.CAUSE  &amp;&amp; CUSTOMER_BOX_STATUS_MODEM.CAUSE != '' &amp;&amp; CUSTOMER_BOX_STATUS_MODEM.CAUSE != 'undefined'"); ]]></script>
                <if cond=" CUSTOMER_BOX_STATUS_MODEM.CAUSE  &amp;&amp; CUSTOMER_BOX_STATUS_MODEM.CAUSE != '' &amp;&amp; CUSTOMER_BOX_STATUS_MODEM.CAUSE != 'undefined' ">
                    <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "CUSTOMER_BOX_STATUS_MODEM.CAUSE  &amp;&amp; CUSTOMER_BOX_STATUS_MODEM.CAUSE != '' &amp;&amp; CUSTOMER_BOX_STATUS_MODEM.CAUSE != 'undefined'"); ]]></script>
                    <script><![CDATA[
						customNode(applicationName + '_' + '20044_WS_PREDIAG_DIAG_FRONT_NOK_'+ CUSTOMER_BOX_STATUS_MODEM.CAUSE );
                    ]]></script>
	            <else/>
	                <script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>
	                <script><![CDATA[
						customNode(applicationName + '_' + '20044_WS_PREDIAG_DIAG_FRONT_NOK');
	                ]]></script>                 
                </if>                 
                <script><![CDATA[ log_debug_next_form(pageCourante, "BOX_DOWN"); ]]></script>
                <goto next="#BOX_DOWN"/>
            </if>

        </block>
    </form>
    
