    	<script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant, formCourant + ":CHOIX", "4"); ]]></script>
    	<script><![CDATA[ track_dtmfList ("FIXE_MENU_HNO_GP", "4"); ]]></script>
