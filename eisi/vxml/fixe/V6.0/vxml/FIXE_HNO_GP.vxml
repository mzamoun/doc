            <script><![CDATA[
				customNode(applicationName + '_' + '75000_HNO_CHOIX_5');
				POSITION_ARBO = 175;			
				log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);				
            ]]></script>
