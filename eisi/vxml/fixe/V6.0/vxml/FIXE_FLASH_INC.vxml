				LabelTraitement = "13000_AUTRE_3";
				nextPage 		= "DISCONNECT";					
				break;
				
			case	192:			   
				LabelTraitement = "14000_AUTRE_4";
				nextPage 		= "DISCONNECT";					
				break;
				
			case	193:
				LabelTraitement = "00032_MENU_RESILIE_DEXTER";
				nextPage 		= "RESILIE";
				formId 			= "#SUITE_TRT_RESIL";
				break;					
																																							
									
			default:
				LabelTraitement = "00000";
				break;							    
		}
	}


    ]]></script>

    <form id="main">
    	<script><![CDATA[ formCourant = "main"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[
			LoadData();
        ]]></script>
        <block>
            <script><![CDATA[ log_debug_assignment(pageCourante,"LabelTraitement", LabelTraitement); ]]></script>
            <script><![CDATA[ log_debug_assignment(pageCourante,"POSITION_ARBO", POSITION_ARBO); ]]></script>
            <script><![CDATA[ log_debug_assignment(pageCourante,"FLASH", LIST_FLASH); ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "Flash"); ]]></script>
            <goto next="#Flash"/>
        </block>
    </form>
    
    
    <!--###########################################
                Controle si presence Flash
            ########################################### -->
    <form id="Flash">
    	<script><![CDATA[ formCourant = "Flash"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <!--	Cas: Pas de Flash	-->
        <block name="FlashTest" cond="flashMsg == 'NULL'">
            <script><![CDATA[ log_debug_next_form(pageCourante, "defineNext"); ]]></script>
            <goto next="#defineNext"/>
        </block>

        <!--	Cas: Flash présent	-->
        <block name="ExecuteFlash" cond="flashMsg != 'NULL'">
            <script><![CDATA[
				customNode(applicationName + '_' + LabelTraitement +'_F');				
            ]]></script>
            <prompt bargein="false">
                <audio  maxage ="7200" maxstale="7200"  expr="flashMsg"/>
            </prompt>
        </block>

        <!-- On continu le traitement  -->
        <block name="AfterFlash" cond="gestionFlash == 'Continuer' ">
            <script><![CDATA[
				customNode(applicationName + '_' + LabelTraitement +'_FC');	 	
				customNode(applicationName + '_' + LabelTraitement +'_FC_'+ idFlash);		
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "defineNext"); ]]></script>
            <goto next="#defineNext"/>
        </block>
        
        <!-- Dissuasion  -->
        <block name="DissuasionAfterFlash" cond="gestionFlash == 'Dissuader'">
            <script><![CDATA[
				customNode(applicationName + '_' + LabelTraitement +'_FD');	
				customNode(applicationName + '_' + LabelTraitement +'_FD_'+ idFlash);				
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, pageDisconnect); ]]></script>
            <goto expr="pageDisconnect"/>
        </block>
        
        <!-- Transfert  -->
        <block name="TransfertAfterFlash">
            <script><![CDATA[
				customNode(applicationName + '_' + LabelTraitement +'_FT');
				customNode(applicationName + '_' + LabelTraitement +'_FT_'+ idFlash);
				ID_FLUX = gestionFlash;				
				log_debug_assignment(pageCourante, "ID_FLUX", ID_FLUX);
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_TRANSFERT.vxml"); ]]></script>
            <goto next="./FIXE_TRANSFERT.vxml"/>
        </block>
        
        <block>
            <script><![CDATA[ log_debug_next_form(pageCourante, "defineNext"); ]]></script>
            <goto next="#defineNext"/>
        </block>     
           
    </form>
    
    <!--###########################################
            Gestion de la page à traiter apres le flash
        ########################################### -->
    <form id="defineNext">
    	<script><![CDATA[ formCourant = "defineNext"; ]]></script>
    	<script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				var followingPage = "./FIXE_" + nextPage + ".vxml"+formId;
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, followingPage); ]]></script>
            <goto expr="followingPage"/>
        </block>
    </form>        

</vxml>
