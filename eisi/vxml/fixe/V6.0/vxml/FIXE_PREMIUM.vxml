<?xml version="1.0" encoding="ISO-8859-1"?>
<vxml version="2.1" xmlns="http://www.w3.org/2001/vxml" application="../../../root.vxml" xml:lang="fr-FR">

    <!--
        Auteur :			IMA
        Date de Creation :	23/06/2010
        Page :				Application FIXE  - TROPICANA NOUVEAU PRO
        Modification: 		IMA		15/02/2012		   Mise à jour de l'application dans le cadre de MAC2
                            IMA		21/11/2012		   Intégration du mode continu
                            IMA		11/03/2013		   Refonte du parcours FIXE
                            IMA		10/05/2013		   Intégration des appels en provenance de RDGU
                            IMA		15/07/2013		   MAJ des traitements Mode Continu
                            IMA		08/10/2013  	   Intégration du choix  Réinit Mot de passe (MDP)
                            IMA		12/03/2014		   MAJ du traitement STC MC
                            IMA		16/09/2014		   Ajout des traitements des appels AUTO_REPAIR
                            IMA		29/02/2016		   MAJ des balises offres dynamiques
                            IMA/CZO	14/12/2016		   Refonte traitements PRO: MAJ des traitements premium (ancien PRO, JOYA et collab)
                            IMA/CZO	18/04/2017		   Prise en compte des traitements WCB_DIGITAL
                            IMA/CZO	10/05/2017		   exclusion des clients THD et CABLE des traitements MC
                            IMA/CZO	28/09/2017		   Gestion des appels en provenance de RDGU
                            IMA/CZO 10/10/2017     	   Suppression des traitements AUTO_REPAIR
                            MRO		15/03/2018			migration v8
                            EISI	12/11/2018			MAJ du traitement PREMIUM - Ajout du traitement du marker CELL_PREM
                            EISI	22/11/2018			Prise en compte de l'appel au WS MC_TECH
                            EISI	16/01/2019			MAJ du traitement PREMIUM - PLATINE + inetgartion ctrl HOHNO specifique
                            EISI	12/02/2019			suppression de l'exclusion des clients FTTB et FTTH du traitement MC
                            IMA/CZO	25/03/2019		    MAJ traitement PREMIUM - PACKPRO	    
                            IMA/CZO	10/04/2019		    reorganisation des traitements WCB	
                            IMA/CZO	05/11/2019		    MAJ traitement COLLAB	
                            IMA/CZO	10/01/2020			Ajout des traitements BEB_FIXE_COM PREMIUM
                            IMA/CZO	02/03/2020		    MAJ suite refonte FIXE
                            IMA/CZO	27/08/2020		    Integration des traitements DEXTER
                            IMA/CZO	07/05/2021		    Suppression traitement INCIDENT-ODIN - menage ARAMIS	
    -->
    <script><![CDATA[
		applicationName = "FIXE"; appSvi = applicationName;
		var pageCourante = "FIXE_PREMIUM.vxml";
		log_info_start_page(pageCourante);
		var pageDisconnect = "./" + applicationName + "_DISCONNECT.vxml";
		var pageTransfert = "./" + applicationName + "_TRANSFERT.vxml";
		var formCourant, menuCourant;
    ]]></script>

    <var name="errorCounter" expr="1"/>
    <var name="errorCounter1" expr="1"/>
    <var name="Motif" expr="''"/>



    <!--###########################################
                Menu PREMIUM
        ########################################### -->
    <form id="VERS_MenuPREMIUM">
        <script><![CDATA[ formCourant = "VERS_MenuPREMIUM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '00060_MENU_PRINCIPAL_PREMIUM');				
            ]]></script>
                    
            <script><![CDATA[ log_debug_next_form(pageCourante, "MenuPREMIUM"); ]]></script>
            <goto next="#MenuPREMIUM"/>
        </block>
    </form>

    <menu id="MenuPREMIUM">
        <script><![CDATA[ formCourant = "MenuPREMIUM"; ]]></script>
        <script><![CDATA[ menuCourant = formCourant; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <property name="timeout" value="5s"/>
       
        <prompt bargein="true">
    		<audio maxage="7200" maxstale="7200" expr="PlayFileCommun(CUSTOMER_IHM.FIXE_MENU_PRINCIPAL_PREMIUM_MENU_PRINCIPAL_PREMIUM_AUDIO)"/>
        </prompt>        

        <catch event="noinput nomatch" cond="document.errorCounter &lt; 2">
            <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "noinput_nomatch"); ]]></script>
            <script><![CDATA[ track_dtmfList (formCourant,"NMNI"+document.errorCounter); ]]></script>

            <script><![CDATA[
				customNode(applicationName + '_' + '00060_PREMIUM_NMNI');					
            ]]></script>
            
            <assign name="document.errorCounter" expr="document.errorCounter + 1"/>
            <script><![CDATA[ log_debug_assignment(pageCourante,"document.errorCounter", document.errorCounter); ]]></script>            
            <prompt>
                <audio expr="PlayGenericAudio('ERREUR_SAISIE_NOUVEAU')"/>
            </prompt>
            <reprompt/>
        </catch>
                
        <catch event="noinput nomatch" cond="document.errorCounter &lt; 3">
            <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "noinput_nomatch"); ]]></script>
            <script><![CDATA[ track_dtmfList (formCourant,"NMNI"+document.errorCounter); ]]></script>

            <script><![CDATA[
				customNode(applicationName + '_' + '00062_PREMIUM_NMNI_X2');
            ]]></script>
            
            <assign name="document.errorCounter" expr="document.errorCounter + 1"/>
            <script><![CDATA[ log_debug_assignment(pageCourante,"document.errorCounter", document.errorCounter); ]]></script>
            <prompt>
                <audio expr="PlayGenericAudio('ERREUR_SAISIE_NOUVEAU')"/>
            </prompt>
            <reprompt/>
        </catch>
        <catch event="noinput nomatch" cond="document.errorCounter == 3">
            <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "noinput_nomatch"); ]]></script>
            <script><![CDATA[ track_dtmfList (formCourant,"NMNI"+document.errorCounter); ]]></script>
            <script><![CDATA[
				customNode(applicationName + '_' + '00063_PREMIUM_NMNI_X3');				
            ]]></script>
            <prompt>
                <audio expr="PlayGenericAudio('ERREUR_SAISIE')"/>
            </prompt>
            <script><![CDATA[ log_debug_next_page(pageCourante, pageDisconnect); ]]></script>
            <goto expr="pageDisconnect"/>
        </catch>

        <choice dtmf="1" next="#VersPREMIUM_Technique"/>
        <choice dtmf="2" next="#VersPREMIUM_Dmgt"/>
        <choice dtmf="3" next="#VersREINIT_MDP_PREMIUM"/>
        <choice dtmf="4" next="#VersPREMIUM_Autre"/>
    </menu>

    <!--###########################################
        Choix 1: PREMIUM Technique
   ########################################### -->
    <form id="VersPREMIUM_Technique">
        <script><![CDATA[ formCourant = "VersPREMIUM_Technique"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "1"); ]]></script>
        <script><![CDATA[ track_dtmfList ("MenuPREMIUM", "1"); ]]></script>
        <block>
            <script><![CDATA[ log_debug_next_form(pageCourante, "PREMIUM_Technique"); ]]></script>
            <goto next="#PREMIUM_Technique"/>        
             
        </block>
    </form>
    
    <form id="PREMIUM_Technique">
        <script><![CDATA[ formCourant = "PREMIUM_Technique"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '10000_PREMIUM_TECH'); 
								           	
				//FTTH
				if ( isClientFixeFTTH()  || OFFRE_MANUELLE == 'THD'){					
					customNode(applicationName + '_' + '19999_OFFRE_FTTH');
				}
				//FTTB
				else if (isClientFixeFTTB() || OFFRE_MANUELLE == 'CABLE') {
					customNode(applicationName + '_' + '19999_OFFRE_FTTB');		
   		        }
   		        else {
					customNode(applicationName + '_' + '19999_OFFRE_ADSL');
             	}             	 			
            ]]></script>
            
            <!--	SOUS APPLI FIXE_TECH HO  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_TECH_IS_OPEN !='false' "); ]]></script>	
            <if cond=" CUSTOMER_HOHNO.FIXE_TECH_IS_OPEN !='false'  ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_TECH_IS_OPEN !='false' "); ]]></script>
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_PREMIUM_TECH_HO');
                ]]></script>            		
          	            
	             <!-- Vers gestion incident HEIMDALL puis flash-->
	            <script><![CDATA[				
					<!--POSITION_INCIDENT_HEIMDALL = liste ('position|balise|page_suivante|form suivant') -->				
					POSITION_INCIDENT_HEIMDALL = '1|10000_PREMIUM_TECH_HO|FLASH_INC|;';
					log_debug_assignment(pageCourante, "POSITION_INCIDENT_HEIMDALL", POSITION_INCIDENT_HEIMDALL);						
				]]></script>            
 
				<!-- Position flash -->          		
	            <script><![CDATA[
					POSITION_ARBO = 5;
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);  
	            ]]></script>
	            
				<script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_INCIDENT_INC.vxml"); ]]></script>
				<goto next="./FIXE_INCIDENT_INC.vxml"/>
				

            <!--	FIXE_TECH HNO  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '10000_PREMIUM_TECH_HNO');
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_HNO_TECH.vxml"); ]]></script>
                <goto next="./FIXE_HNO_TECH.vxml"/>

            </if>             

        </block>
    </form>

    <!--###########################################
         Choix 2: PREMIUM DMGT
    ########################################### -->
    <form id="VersPREMIUM_Dmgt">
        <script><![CDATA[ formCourant = "VersPREMIUM_Dmgt"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "2"); ]]></script>
        <script><![CDATA[ track_dtmfList ("MenuPREMIUM", "2"); ]]></script>
        <block>
            <script><![CDATA[ log_debug_next_form(pageCourante, "PREMIUM_Dmgt"); ]]></script>
            <goto next="#PREMIUM_Dmgt"/>         
              
        </block>
    </form>
    
    <form id="PREMIUM_Dmgt">
        <script><![CDATA[ formCourant = "PREMIUM_Dmgt"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '20000_PREMIUM_DMGT');			
            ]]></script>  
            
            <!--	SOUS APPLI FIXE_DEM HO  -->
            <script><![CDATA[ log_debug_start_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_DEM_IS_OPEN !='false'  "); ]]></script>	
            <if cond=" CUSTOMER_HOHNO.FIXE_DEM_IS_OPEN !='false'  ">
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, " CUSTOMER_HOHNO.FIXE_DEM_IS_OPEN !='false'  "); ]]></script>	
	            <script><![CDATA[
					customNode(applicationName + '_' + '20000_PREMIUM_DMGT_HO');
					POSITION_ARBO = 6;					
					log_debug_assignment(pageCourante, "POSITION_ARBO", POSITION_ARBO);
	            ]]></script>
	            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
	            <goto next="./FIXE_FLASH_INC.vxml"/>

            <!--	FIXE_DEM HNO  -->
            <else/>
            	<script><![CDATA[ log_debug_in_condition(pageCourante, formCourant, "ELSE" ); ]]></script>	
                <script><![CDATA[
					customNode(applicationName + '_' + '20000_PREMIUM_DMGT_HNO');
                ]]></script>
                <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_HNO_DEM.vxml"); ]]></script>
                <goto next="./FIXE_HNO_DEM.vxml"/>

            </if>              
        </block>
    </form>    

    <!--###########################################
             Choix 3: Reinit Mot de passe
        ########################################### -->
    <form id="VersREINIT_MDP_PREMIUM">
        <script><![CDATA[ formCourant = "VersREINIT_MDP_PREMIUM"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "3"); ]]></script>
        <script><![CDATA[ track_dtmfList ("MenuPREMIUM", "3"); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '30000_PREMIUM_REINIT_MDP');		
				POSITION_ARBO = 19;										
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>

        </block>
    </form>

    <!--###########################################
         Choix 4: PREMIUM AUTRE
    ########################################### -->
    <form id="VersPREMIUM_Autre">
        <script><![CDATA[ formCourant = "VersPREMIUM_Autre"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <script><![CDATA[ log_debug_saisie_dtmf(pageCourante, "CHOIX " + formCourant + ", " + formCourant + ":CHOIX", "4"); ]]></script>
        <script><![CDATA[ track_dtmfList ("MenuPREMIUM", "4"); ]]></script>
        <block>
            <script><![CDATA[
				customNode(applicationName + '_' + '40000_PREMIUM_AUTRE');
				POSITION_ARBO = 7;				
            ]]></script>
            <script><![CDATA[ log_debug_next_page(pageCourante, "./FIXE_FLASH_INC.vxml"); ]]></script>
            <goto next="./FIXE_FLASH_INC.vxml"/>
        </block>
    </form>




    
    <!--###########################################
         ENTREE WCB_DIGITAL -  PREMIUM - TECH
    ########################################### -->
    <!--	ENTREE  à partir de la page WCB_DIGITAL -->
    <form id="ENTREE_WCB_DIGITAL_PREMIUM_TECH">
        <script><![CDATA[ formCourant = "ENTREE_WCB_DIGITAL_PREMIUM_TECH"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>           
            <script><![CDATA[
				customNode(applicationName + '_' + '10000_WCB_PREMIUM_TECH');				
            ]]></script>
            <script><![CDATA[ log_debug_next_form(pageCourante, "PREMIUM_Technique"); ]]></script>
            <goto next="#PREMIUM_Technique"/>
                            
        </block>
    </form> 
    
    <!--###########################################
         ENTREE WCB_DIGITAL -  PREMIUM - DMGT
    ########################################### -->
    <!--	ENTREE  à partir de la page WCB_DIGITAL -->
    <form id="ENTREE_WCB_DIGITAL_PREMIUM_DMGT">
        <script><![CDATA[ formCourant = "ENTREE_WCB_DIGITAL_PREMIUM_DMGT"; ]]></script>
        <script><![CDATA[ log_debug_start_form(pageCourante, formCourant); ]]></script>
        <block>           
            <script><![CDATA[ log_debug_next_form(pageCourante, "PREMIUM_Dmgt"); ]]></script>
            <goto next="#PREMIUM_Dmgt"/>
                            
        </block>
    </form>     
           
        
</vxml>
