--MAJ de la fonction is_red_dexter()

  /**
   * Client RED
   * @returns
   */
function is_red_dexter() {
	var status_red_dexter = false;
	
	if ( CUSTOMER_DEXTER && CUSTOMER_DEXTER.CLIENT_RED && CUSTOMER_DEXTER.CLIENT_RED == 'true') {
			status_red_dexter = true;
		}
	
	return status_red_dexter;

}

