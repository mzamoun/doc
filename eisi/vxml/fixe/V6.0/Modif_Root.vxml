--ajout fonction

  /**
   * Client RESILIE FIXE DEXTER: STATUT RESILIE ou pas d offres dexter
   * @returns
   */
function isClientResilieFixe() {
	var status_resilie_dexter = false;
	
	if ( CUSTOMER_DEXTER && CUSTOMER_DEXTER.CLIENT_RESILIE && CUSTOMER_DEXTER.CLIENT_RESILIE == 'true') {
			status_resilie_dexter = true;
		}
	
	return status_resilie_dexter;

}




